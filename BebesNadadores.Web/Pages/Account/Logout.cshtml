@page "/Account/Logout"
@model BebesNadadores.Web.Pages.Account.LogoutModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <title>
        Cerrar sesión
    </title>

</head>

<body>

    <form method="post">

        <h2>
            ¿Desea cerrar sesión?
        </h2>

        <button type="submit">
            Cerrar sesión
        </button>

        <a href="/">
            Cancelar
        </a>

    </form>

</body>

</html>