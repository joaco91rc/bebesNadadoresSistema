@page "/Account/Login"
@model BebesNadadores.Web.Pages.Account.LoginModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Bebés Nadadores - Iniciar sesión</title>

    <link rel="stylesheet" href="/css/login.css" />
</head>

<body>
    <div class="login-page">

        <div class="background-circle circle-one"></div>
        <div class="background-circle circle-two"></div>

        <div class="login-shell">
            <div class="login-shell__light"></div>

            <div class="login-container">
                <section class="form-panel">
                    <div class="form-wrapper">

                        <div class="login-brand">
                            <img src="/images/logo-bebes-nadadores.png" class="login-logo" alt="Bebés Nadadores" />
                        </div>

                        <div class="form-header">
                            <span class="welcome">BIENVENIDO</span>

                            <h2>Iniciar sesión</h2>

                            <p>
                                Ingresá tus credenciales para acceder al sistema.
                            </p>
                        </div>

                        <form method="post">

                            <input type="hidden" asp-for="ReturnUrl" />

                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="validation-summary">
                                    <div asp-validation-summary="ModelOnly"></div>
                                </div>
                            }

                            <div class="field-group">
                                <label asp-for="Input.Email">
                                    Email
                                </label>

                                <div class="input-wrapper">
                                    <span class="input-icon">@@</span>

                                    <input asp-for="Input.Email" autocomplete="username"
                                           placeholder="nombre@bebesnadadores.com" />
                                </div>

                                <span class="field-error" asp-validation-for="Input.Email">
                                </span>
                            </div>

                            <div class="field-group">
                                <label asp-for="Input.Password">
                                    Contraseña
                                </label>

                                <div class="input-wrapper">
                                    <span class="input-icon password-dot">●</span>

                                    <input asp-for="Input.Password" autocomplete="current-password"
                                           placeholder="Ingresá tu contraseña" />
                                    <button type="button" class="password-toggle" id="toggle-login-password"
                                            aria-label="Mostrar contraseña" aria-pressed="false"
                                            aria-controls="Input_Password" title="Mostrar contraseña">
                                        <svg class="eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"/><circle cx="12" cy="12" r="3"/></svg>
                                        <svg class="eye-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 3 18 18M10.7 6.1A11.6 11.6 0 0 1 12 6c6.5 0 10 6 10 6a16 16 0 0 1-3.2 3.7M6.4 6.4C3.6 8.2 2 12 2 12s3.5 6 10 6c1.6 0 3-.4 4.2-1"/></svg>
                                    </button>
                                </div>

                                <span class="field-error" asp-validation-for="Input.Password">
                                </span>
                            </div>

                            <div class="login-options">
                                <label class="remember">
                                    <input asp-for="Input.Recordarme" />
                                    <span>Recordarme</span>
                                </label>
                            </div>

                            <button type="submit" class="login-button">

                                <span>Ingresar</span>
                                <span class="login-arrow">→</span>
                            </button>

                        </form>

                        <div class="login-footer">
                            Sistema de gestión
                            <strong>Bebés Nadadores</strong>
                        </div>

                    </div>
                </section>
            </div>
        </div>

    </div>
    <script src="/js/login-password.js" defer></script>
</body>

</html>
