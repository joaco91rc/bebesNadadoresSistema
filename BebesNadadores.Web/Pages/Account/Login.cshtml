@page "/Account/Login"
@model BebesNadadores.Web.Pages.Account.LoginModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Bebés Nadadores - Iniciar sesión</title>

    <link rel="stylesheet" href="/css/login.css" />
</head>

<body>
    <div class="login-page">

        <div class="background-circle circle-one"></div>
        <div class="background-circle circle-two"></div>

        <div class="login-shell">
            <div class="login-shell__light"></div>

            <div class="login-container">
                <section class="form-panel">
                    <div class="form-wrapper">

                        <div class="login-brand">
                            <img src="/images/logo-bebes-nadadores.png" class="login-logo" alt="Bebés Nadadores" />
                        </div>

                        <div class="form-header">
                            <span class="welcome">BIENVENIDO</span>

                            <h2>Iniciar sesión</h2>

                            <p>
                                Ingresá tus credenciales para acceder al sistema.
                            </p>
                        </div>

                        <form method="post">

                            <input type="hidden" asp-for="ReturnUrl" />

                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="validation-summary">
                                    <div asp-validation-summary="ModelOnly"></div>
                                </div>
                            }

                            <div class="field-group">
                                <label asp-for="Input.Email">
                                    Email
                                </label>

                                <div class="input-wrapper">
                                    <span class="input-icon">@@</span>

                                    <input asp-for="Input.Email" autocomplete="username"
                                           placeholder="nombre@bebesnadadores.com" />
                                </div>

                                <span class="field-error" asp-validation-for="Input.Email">
                                </span>
                            </div>

                            <div class="field-group">
                                <label asp-for="Input.Password">
                                    Contraseña
                                </label>

                                <div class="input-wrapper">
                                    <span class="input-icon password-dot">●</span>

                                    <input asp-for="Input.Password" type="password" autocomplete="current-password"
                                           placeholder="Ingresá tu contraseña" />
                                    <button type="button" class="password-visibility" id="toggle-password"
                                            aria-label="Mostrar contraseña" aria-pressed="false" title="Mostrar contraseña">
                                        <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor"
                                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/>
                                            <circle cx="12" cy="12" r="3" />
                                        </svg>
                                    </button>
                                </div>

                                <span class="field-error" asp-validation-for="Input.Password">
                                </span>
                            </div>

                            <div class="login-options">
                                <label class="remember">
                                    <input asp-for="Input.Recordarme" />
                                    <span>Recordarme</span>
                                </label>
                            </div>

                            <button type="submit" class="login-button">

                                <span>Ingresar</span>
                                <span class="login-arrow">→</span>
                            </button>

                        </form>

                        <div class="login-footer">
                            Sistema de gestión
                            <strong>Bebés Nadadores</strong>
                        </div>

                    </div>
                </section>
            </div>
        </div>

    </div>
<script>
    (() => {
        const toggle = document.getElementById('toggle-password');
        const password = document.getElementById('Input_Password');
        if (!toggle || !password) return;
        toggle.addEventListener('click', () => {
            const visible = password.type === 'password';
            password.type = visible ? 'text' : 'password';
            toggle.setAttribute('aria-label', visible ? 'Ocultar contraseña' : 'Mostrar contraseña');
            toggle.setAttribute('title', visible ? 'Ocultar contraseña' : 'Mostrar contraseña');
            toggle.setAttribute('aria-pressed', String(visible));
        });
    })();
</script>
</body>

</html>
