@using MudBlazor
@using System.Globalization
@using Microsoft.AspNetCore.Components
@typeparam TAlumno where TAlumno : class

@* Para /reservas-vacantes: un solo control para buscar y elegir alumno. *@

<MudAutocomplete T="TAlumno"
                 Label="Alumno"
                 Placeholder="Escribí nombre, apellido o DNI..."
                 Value="@_seleccionado"
                 ValueChanged="@CuandoSelecciona"
                 SearchFunc="@BuscarAsync"
                 ToStringFunc="@Texto"
                 Variant="Variant.Outlined"
                 Margin="Margin.Dense"
                 Adornment="Adornment.Start"
                 AdornmentIcon="@Icons.Material.Filled.Search"
                 Clearable="true"
                 CoerceText="true"
                 ResetValueOnEmptyText="true"
                 MinCharacters="0"
                 MaxItems="80"
                 FullWidth="true"
                 Disabled="@Disabled"
                 NoItemsText="No encontramos alumnos con ese criterio" />

@code {
    [Parameter] public IEnumerable<TAlumno> Alumnos { get; set; } = Array.Empty<TAlumno>();
    [Parameter, EditorRequired] public Func<TAlumno, Guid> ObtenerId { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TAlumno, string> ObtenerTexto { get; set; } = default!;

    [Parameter] public Guid? SelectedId { get; set; }
    [Parameter] public EventCallback<Guid?> SelectedIdChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private TAlumno? _seleccionado;

    protected override void OnParametersSet()
    {
        _seleccionado = SelectedId.HasValue
            ? Alumnos.FirstOrDefault(a => ObtenerId(a) == SelectedId.Value)
            : null;
    }

    private string Texto(TAlumno? alumno)
        => alumno is null ? string.Empty : (ObtenerTexto(alumno) ?? string.Empty);

    private Task<IEnumerable<TAlumno>> BuscarAsync(
        string? busqueda, CancellationToken cancellationToken)
    {
        if (cancellationToken.IsCancellationRequested)
            return Task.FromResult<IEnumerable<TAlumno>>(Array.Empty<TAlumno>());

        var lista = Alumnos ?? Array.Empty<TAlumno>();
        var palabras = (busqueda ?? string.Empty).Split(
            ' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        if (palabras.Length > 0)
        {
            var comparar = CultureInfo.GetCultureInfo("es-AR").CompareInfo;
            lista = lista.Where(a =>
            {
                string texto = Texto(a);
                return palabras.All(palabra =>
                    comparar.IndexOf(texto, palabra,
                        CompareOptions.IgnoreCase | CompareOptions.IgnoreNonSpace) >= 0);
            });
        }

        return Task.FromResult<IEnumerable<TAlumno>>(
            lista.Take(80).ToArray());
    }

    private async Task CuandoSelecciona(TAlumno? alumno)
    {
        _seleccionado = alumno;
        await SelectedIdChanged.InvokeAsync(alumno is null ? null : ObtenerId(alumno));
    }
}
