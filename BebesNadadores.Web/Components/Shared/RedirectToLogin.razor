@inject NavigationManager Navigation

@code {

    protected override void OnInitialized()
    {
        var relative =
            Navigation.ToBaseRelativePath(
                Navigation.Uri);

        var returnUrl =
            "/" + relative;

        var encoded =
            Uri.EscapeDataString(returnUrl);

        Navigation.NavigateTo(
            $"/Account/Login?returnUrl={encoded}",
            forceLoad: true);
    }

}