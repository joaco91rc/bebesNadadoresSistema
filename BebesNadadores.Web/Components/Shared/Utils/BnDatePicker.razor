@using System.Globalization

<div class="bn-date-picker-shell">

    <MudDatePicker Date="@FechaInterna"
                   DateChanged="FechaCambiadaAsync"
                   DateFormat="@(SoloMes ? "MM/yyyy" : "dd/MM/yyyy")"
                   OpenTo="@(SoloMes ? OpenTo.Month : OpenTo.Date)"
                   FixDay="@(SoloMes ? (int?)1 : null)"
                   Culture="@Cultura"
                   Editable="true"
                   ShowToolbar="false"
                   Color="Color.Primary"
                   Variant="Variant.Outlined"
                   Margin="Margin.None"
                   Disabled="@Disabled"
                   MinDate="@MinDateTime"
                   MaxDate="@MaxDateTime"
                   Placeholder="@(SoloMes ? "MM/yyyy" : Placeholder)"
                   Adornment="Adornment.End"
                   AdornmentIcon="@Icons.Material.Filled.CalendarMonth"
                   AnchorOrigin="Origin.BottomLeft"
                   TransformOrigin="Origin.TopLeft" />

</div>


@code {

    [Parameter]
    public DateOnly Value { get; set; }


    [Parameter]
    public EventCallback<DateOnly> ValueChanged { get; set; }


    [Parameter]
    public bool SoloMes { get; set; }

    [Parameter]
    public bool Disabled { get; set; }


    [Parameter]
    public DateOnly? MinDate { get; set; }


    [Parameter]
    public DateOnly? MaxDate { get; set; }


    [Parameter]
    public string Placeholder { get; set; }
        = "dd/MM/yyyy";


    private static readonly CultureInfo Cultura =
        CultureInfo.GetCultureInfo("es-AR");


    private DateTime? FechaInterna =>
        Value.ToDateTime(
            TimeOnly.MinValue);


    private DateTime? MinDateTime =>
        MinDate?.ToDateTime(
            TimeOnly.MinValue);


    private DateTime? MaxDateTime =>
        MaxDate?.ToDateTime(
            TimeOnly.MinValue);


    private async Task FechaCambiadaAsync(
        DateTime? fecha)
    {
        if (!fecha.HasValue)
        {
            return;
        }


        if (fecha.HasValue)
        {
            var elegida = DateOnly.FromDateTime(fecha.Value);
            if ((MinDate.HasValue && elegida < MinDate.Value) ||
                (MaxDate.HasValue && elegida > MaxDate.Value))
                return;
        }

        Value = SoloMes ? new DateOnly(fecha.Value.Year, fecha.Value.Month, 1) : DateOnly.FromDateTime(fecha.Value);


        await ValueChanged.InvokeAsync(
            Value);
    }
}