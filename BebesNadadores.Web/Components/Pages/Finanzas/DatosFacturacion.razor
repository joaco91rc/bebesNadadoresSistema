@page "/datos-facturacion"
@attribute [Authorize(Policy = PoliticasSistema.GestionCaja)]
@using BebesNadadores.Web.Services.Facturas
@inject FacturasService Servicio
<PageTitle>Datos de facturación | Bebés Nadadores</PageTitle>
<div class="fiscal-page">
    <header class="fiscal-header">
        <div><small>FINANZAS · DATOS DE LAS FAMILIAS</small><h1>Datos de facturación</h1><p>Administrá los CUIT/CUIL y correos autorizados de cada alumno antes de importar las facturas.</p></div>
        <div class="fiscal-toolbar"><a href="/facturas">Facturas fiscales</a><button disabled="@ocupado" @onclick="Cargar">Actualizar</button></div>
    </header>
    @if(mensaje!=null){<div class="fiscal-banner" role="alert">@mensaje</div>}
    <div class="fiscal-stats">
        <section><small>ALUMNOS ACTIVOS</small><strong>@filas.Count(x=>x.Activo)</strong></section>
        <section><small>CON CORREO FISCAL AUTORIZADO</small><strong>@filas.Count(x=>x.Activo&&Preparado(x))</strong></section>
        <section><small>PENDIENTES DE COMPLETAR</small><strong>@filas.Count(x=>x.Activo&&!Preparado(x))</strong></section>
    </div>
    <section class="fiscal-panel">
        <div class="fiscal-toolbar">
            <input aria-label="Buscar alumno o titular" placeholder="Buscar alumno, titular, CUIT o correo…" @bind="buscar" @bind:event="oninput" />
            <select aria-label="Estado de datos fiscales" @bind="filtro"><option value="">Todos los datos fiscales</option><option value="pendiente">Pendientes de completar</option><option value="listo">Con correo autorizado</option><option value="sin">Sin datos registrados</option></select>
            <label><input type="checkbox" @bind="incluirBajas"/> Incluir bajas</label>
        </div>
        @if(ocupado){<p>Cargando alumnos…</p>}
        else {
            <p>@Visibles.Count() alumnos encontrados.</p>
            <div class="fiscal-table"><table><thead><tr><th>Alumno</th><th>Identidades fiscales</th><th>Estado</th><th></th></tr></thead><tbody>
                @foreach(var a in Visibles){
                    <tr><td><strong>@a.Nombre</strong><small>@(a.Activo?"Activo":"Baja")</small></td>
                        <td>@if(a.Identidades.Count==0){<small>Sin CUIT/CUIL registrado</small>}else{<div>
                            @foreach(var i in a.Identidades){<div class="fiscal-identidad"><strong>@i.Titular</strong><small>@i.Documento · @(i.Principal?"Principal":"Auxiliar") · @(i.DestinoAutorizado?"Autorizado":"Sin autorización")</small><small>@(string.IsNullOrWhiteSpace(i.Email)?"Sin correo":i.Email) · @(i.ResponsableId!=null?"Legajo":"Manual / externo")</small></div>}
                        </div>}</td>
                        <td><span class="fiscal-status @(Preparado(a)?"fiscal-ok":"fiscal-warn")">@(Preparado(a)?"Con correo autorizado":"Pendiente")</span></td>
                        <td><a href="@($"/clientes/{a.Id}/datos-fiscales")">Gestionar datos</a></td></tr>
                }
                @if(!Visibles.Any()){<tr><td colspan="4">No hay alumnos para los filtros seleccionados.</td></tr>}
            </tbody></table></div>
        }
        <p>El estado indica que el alumno tiene al menos un correo fiscal autorizado. El envío de cada factura se valida nuevamente: un CUIT compartido debe tener un destinatario inequívoco.</p>
    </section>
</div>
@code {
    private List<ResumenFiscalAlumno> filas=[];
    private string buscar="",filtro="";
    private string? mensaje;
    private bool ocupado,incluirBajas;
    private static bool Preparado(ResumenFiscalAlumno a)=>a.Identidades.Any(i=>i.ListoParaFacturar);
    private IEnumerable<ResumenFiscalAlumno> Visibles=>filas.Where(a=>(incluirBajas||a.Activo)&&(filtro==""||filtro=="listo"&&Preparado(a)||filtro=="pendiente"&&!Preparado(a)||filtro=="sin"&&a.Identidades.Count==0)&&Coincide(a));
    private bool Coincide(ResumenFiscalAlumno a){var q=buscar.Trim();return a.Nombre.Contains(q,StringComparison.OrdinalIgnoreCase)||a.Identidades.Any(i=>(i.Titular+" "+i.Documento+" "+i.Email).Contains(q,StringComparison.OrdinalIgnoreCase)||i.Documento.Contains(q.Replace("-",""),StringComparison.OrdinalIgnoreCase));}
    protected override Task OnInitializedAsync()=>Cargar();
    private async Task Cargar(){ocupado=true;mensaje=null;try{filas=await Servicio.ResumenAlumnosAsync();}catch{mensaje="No se pudieron cargar los datos fiscales. Verificá los scripts de instalación.";}finally{ocupado=false;}}
}
