@page "/facturas"
@attribute [Authorize(Policy = PoliticasSistema.GestionCaja)]
@using BebesNadadores.Web.Services.Facturas
@inject FacturasService Servicio
<PageTitle>Facturas fiscales | Bebés Nadadores</PageTitle>
<div class="fiscal-page">
    <header class="fiscal-header"><div><small>FINANZAS · DISTRIBUCIÓN FISCAL</small><h1>Facturas fiscales</h1><p>Importá los comprobantes emitidos en ARCA y enviá el PDF original a cada familia.</p></div><button disabled="@ocupado" @onclick="Cargar">Actualizar</button></header>
    <div class="fiscal-banner"><MudIcon Icon="@Icons.Material.Filled.Info"/> @(Servicio.Habilitado ? "Servicio de envío habilitado. Solo se procesan facturas confirmadas." : "Envíos bloqueados desde el servidor. Podés importar y revisar sin enviar correos.")</div>
    <div class="fiscal-import">
        <section><small>PASO 1 · OPCIONAL</small><h3>Listado ARCA</h3><p>Excel .xlsx o CSV con fecha, número, emisor, receptor e importe.</p><InputFile OnChange="CargarListado" accept=".xlsx,.csv" disabled="@ocupado"/><p>@(listado==null?"Sin listado: se leerán los datos del PDF.":$"{listado.Count} filas cargadas")</p><button disabled="@ocupado" @onclick="()=>listado=null">Quitar listado</button></section>
        <section><small>PASO 2</small><h3>Facturas originales</h3><p>Seleccioná hasta 500 PDF. Se revisarán individualmente y no se enviarán automáticamente.</p><InputFile OnChange="Importar" accept=".pdf" multiple disabled="@ocupado"/><p>@avance</p></section>
    </div>
    @if(mensaje!=null){<div class="fiscal-banner">@mensaje</div>}
    @if(detalles.Count>0){<details><summary>Resultado de importación (@detalles.Count archivos)</summary><div class="fiscal-log">@foreach(var d in detalles){<p>@d</p>}</div></details>}
    <div class="fiscal-stats"><section><small>IMPORTADAS (VISTA)</small><strong>@filas.Count</strong></section><section><small>PENDIENTES IDENTIFICADAS</small><strong>@filas.Count(x=>x.Estado=="Pendiente"&&x.Vinculada)</strong></section><section><small>SIN VINCULAR</small><strong>@filas.Count(x=>!x.Vinculada)</strong></section><section><small>ENVIADAS</small><strong>@filas.Count(x=>x.Estado=="Enviado")</strong></section></div>
    <div class="fiscal-panel">
        <div class="fiscal-toolbar"><input placeholder="Buscar responsable, documento o factura…" @bind="buscar" @bind:event="oninput"/><input type="month" value="@mes" @onchange="CambiarMes"/><select @bind="estado"><option value="">Todos los estados</option><option>Pendiente</option><option>EnCola</option><option>EnProceso</option><option>Enviado</option><option>Error</option><option>Sin vincular</option></select><button disabled="@ocupado" @onclick="Seleccionar">Seleccionar pendientes visibles</button><button disabled="@(ocupado||seleccion.Count==0||!Servicio.Habilitado)" @onclick="()=>confirmar=true">Preparar envío (@seleccion.Count)</button></div>
        <div class="fiscal-table"><table><thead><tr><th></th><th>Factura / Fecha</th><th>Receptor fiscal</th><th>Importe</th><th>Destinatario</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
        @foreach(var f in Visible){<tr><td><input type="checkbox" checked="@seleccion.Contains(f.Id)" disabled="@(ocupado||f.Estado!="Pendiente"||!f.Vinculada)" @onchange="e=>Marcar(f.Id,e.Value is true)"/></td><td><strong>@f.Comprobante</strong><small>@f.Fecha.ToString("dd/MM/yyyy")</small></td><td>@f.Receptor<small>@(f.Contrastada?"Contrastada con ARCA":"Leída del PDF")</small></td><td>@f.Importe.ToString("C2",System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</td><td>@(f.ResponsableNombre??"Sin vincular")<small>@f.Destinatario</small>@if(f.BebeId is Guid bebeFiscal){<a href="@($"/clientes/{bebeFiscal}/datos-fiscales")">Datos fiscales del bebé</a>}else if(f.IdentidadBebeId!=null){<small>Destinatario identificado · alumno por confirmar</small>}</td><td><span class="fiscal-status">@f.Estado</span></td><td><a href="@($"/facturas/archivo/{f.Id}")" target="_blank" rel="noopener">PDF</a> @if(f.Estado=="Pendiente"){<button disabled="@ocupado" @onclick="()=>AbrirVinculo(f)">Vincular</button> <button disabled="@ocupado" @onclick="()=>Reidentificar(f.Id)">Buscar CUIT/CUIL</button>}</td></tr>}
        </tbody></table></div>
        <p>Vista de las últimas 2.000 facturas. Enviado significa aceptado por SMTP, no confirma recepción o lectura. No se reintentan automáticamente errores ni envíos de resultado incierto.</p>
    </div>
    @if(vinculo!=null){<div class="fiscal-overlay"><section class="fiscal-dialog"><h2>Vincular destinatario fiscal</h2><p>Documento receptor: <strong>@vinculo.Receptor</strong> · @vinculo.Comprobante</p><p>Verificá el PDF y elegí el responsable autorizado que debe recibirlo.</p><input placeholder="Buscar contacto…" @bind="buscarContacto" @bind:event="oninput"/><select @bind="contactoId"><option value="">Seleccionar responsable</option>@foreach(var c in contactos.Where(c=>Coincide(c.Nombre+" "+c.Documento+" "+c.Email,buscarContacto)).Take(100)){<option value="@c.Id">@c.Nombre · @c.Documento · @c.Email</option>}</select><label><input type="checkbox" @bind="recordar"/> Recordar este documento fiscal para futuros meses</label><label><input type="checkbox" @bind="verificado"/> Confirmo que verifiqué la identidad y el correo del receptor</label><div class="fiscal-toolbar"><button @onclick="()=>vinculo=null">Cancelar</button><button disabled="@(ocupado||!verificado||!Guid.TryParse(contactoId,out _))" @onclick="GuardarVinculo">Confirmar</button></div></section></div>}
    @if(confirmar){<div class="fiscal-overlay"><section class="fiscal-dialog"><h2>Confirmar envío masivo</h2><p>Revisá los @seleccion.Count destinatarios antes de enviar.</p><div class="fiscal-log">@foreach(var f in filas.Where(f=>seleccion.Contains(f.Id))){<p>@f.Comprobante → @f.Destinatario</p>}</div><div class="fiscal-toolbar"><button @onclick="()=>confirmar=false">Cancelar</button><button disabled="@ocupado" @onclick="Enviar">Confirmar cola de envío</button></div></section></div>}
</div>
@code {
    private List<FacturaFila> filas=[];
    private List<ContactoFiscal> contactos=[];
    private List<FilaArca>? listado;
    private List<string> detalles=[];
    private HashSet<Guid> seleccion=[];
    private string buscar="",estado="",avance="",buscarContacto="",contactoId="";
    private string mes="";
    private bool ocupado,recordar,verificado,confirmar;
    private string? mensaje;
    private FacturaFila? vinculo;
    private static bool Coincide(string texto,string filtro)=>texto.Contains(filtro.Trim(),StringComparison.OrdinalIgnoreCase);
    private IEnumerable<FacturaFila> Visible=>filas.Where(f=>(mes==""||f.Fecha.ToString("yyyy-MM")==mes)&&(estado==""||estado==f.Estado||(estado=="Sin vincular"&&!f.Vinculada))&&Coincide(f.Comprobante+" "+f.Receptor+" "+f.ResponsableNombre+" "+f.Destinatario,buscar));
    protected override Task OnInitializedAsync()=>Cargar();
    private async Task Cargar(){ocupado=true;try{filas=await Servicio.ListarAsync();contactos=await Servicio.ContactosAsync();seleccion.RemoveWhere(id=>!filas.Any(f=>f.Id==id&&f.Estado=="Pendiente"));}catch{mensaje="No se pudo cargar Facturas fiscales. Verificá que se haya aplicado el SQL.";}finally{ocupado=false;}}
    private async Task CargarListado(InputFileChangeEventArgs e){ocupado=true;listado=null;try{using var ms=new MemoryStream();await e.File.OpenReadStream(10*1024*1024).CopyToAsync(ms);listado=FacturasService.LeerListado(ms.ToArray(),e.File.Name);mensaje="Listado cargado.";}catch(Exception ex){mensaje=ex.Message;}finally{ocupado=false;}}
    private async Task Importar(InputFileChangeEventArgs e){ocupado=true;detalles=[];try{var fs=e.GetMultipleFiles(500);int i=0;foreach(var f in fs){avance=$"Procesando {++i} de {fs.Count}";try{using var ms=new MemoryStream();await f.OpenReadStream(10*1024*1024).CopyToAsync(ms);detalles.Add(f.Name+": "+await Servicio.ImportarAsync(ms.ToArray(),listado));}catch(InvalidDataException ex){detalles.Add(f.Name+": "+ex.Message);}catch{detalles.Add(f.Name+": no se pudo importar. Revisar formato o base de datos.");}await InvokeAsync(StateHasChanged);}avance="Proceso terminado.";await Cargar();}catch{mensaje="Seleccioná hasta 500 archivos por lote.";}finally{ocupado=false;}}
    private void CambiarMes(ChangeEventArgs e)=>mes=e.Value?.ToString()??"";
    private void Marcar(Guid id,bool v){if(v)seleccion.Add(id);else seleccion.Remove(id);}
    private void Seleccionar(){foreach(var f in Visible.Where(f=>f.Estado=="Pendiente"&&f.Vinculada))seleccion.Add(f.Id);}
    private void AbrirVinculo(FacturaFila f){vinculo=f;buscarContacto="";contactoId=f.ResponsableId?.ToString()??"";recordar=false;verificado=false;}
    private async Task GuardarVinculo(){if(vinculo==null||!verificado||!Guid.TryParse(contactoId,out var id))return;ocupado=true;try{await Servicio.VincularAsync(vinculo.Id,id,recordar);vinculo=null;await Cargar();}catch(InvalidOperationException ex){mensaje=ex.Message;vinculo=null;}catch{mensaje="No se pudo confirmar el vínculo.";}finally{ocupado=false;}}
    private async Task Reidentificar(Guid id){ocupado=true;try{await Servicio.ReidentificarAsync(id);mensaje="Destinatario fiscal actualizado.";seleccion.Remove(id);await Cargar();}catch(InvalidOperationException ex){mensaje=ex.Message;}catch{mensaje="No se pudo identificar la factura.";}finally{ocupado=false;}}
    private async Task Enviar(){if(!confirmar||!Servicio.Habilitado)return;ocupado=true;try{var n=await Servicio.EncolarAsync(seleccion);mensaje=$"{n} facturas agregadas a la cola.";seleccion.Clear();confirmar=false;await Cargar();}catch{mensaje="No se pudo completar la cola. Actualizá la pantalla antes de volver a intentar.";}finally{ocupado=false;}}
}
