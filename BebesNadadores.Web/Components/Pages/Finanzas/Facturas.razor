@page "/facturas"
@attribute [Authorize(Policy = PoliticasSistema.GestionCaja)]
@using BebesNadadores.Web.Services.Facturas
@inject FacturasService Servicio
<PageTitle>Facturas fiscales | Bebés Nadadores</PageTitle>
<div class="fiscal-page">
    <header class="fiscal-header"><div><small>FINANZAS · DISTRIBUCIÓN FISCAL</small><h1>Facturas fiscales</h1><p>Importá los comprobantes emitidos en ARCA y enviá el PDF original a cada familia.</p></div><div class="fiscal-toolbar"><a href="/datos-facturacion">Datos de facturación</a><AuthorizeView Policy="@PoliticasSistema.SoloAdministrador"><Authorized><a href="/configuracion/facturacion">Configuración fiscal</a></Authorized></AuthorizeView><button disabled="@ocupado" @onclick="Cargar">Actualizar</button></div></header>
    <div class="fiscal-banner"><MudIcon Icon="@Icons.Material.Filled.Info"/> @(enviosHabilitados ? "Envíos habilitados. Las facturas contrastadas con el listado y asociadas sin ambigüedad ingresan automáticamente a la cola." : "Envíos deshabilitados en Comunicaciones o bloqueados desde el servidor. Podés importar y revisar sin enviar correos.")</div>
    <div class="fiscal-import">
        <section><small>PASO 1 · LISTADO DEL LOTE</small><h3>Listado ARCA</h3><p>Excel .xlsx o CSV con fecha, número, emisor, receptor e importe. Necesario para el envío automático.</p><InputFile OnChange="CargarListado" accept=".xlsx,.csv" disabled="@ocupado"/><p>@(listado==null?"Sin listado: se leerán los datos del PDF, sin envío automático.":$"{listado.Count} filas cargadas")</p><button disabled="@ocupado" @onclick="()=>listado=null">Quitar listado</button></section>
        <section><small>PASO 2</small><h3>Facturas originales</h3><p>Seleccioná hasta 500 PDF de una sola vez. Se contrastan con el Excel, se asocian por CUIT y, si hay hermanos, por pagos. Solo se envían automáticamente las coincidencias inequívocas cuando los envíos están habilitados.</p><InputFile OnChange="Importar" accept=".pdf" multiple disabled="@ocupado"/><p>@avance</p></section>
    </div>
    @if(mensaje!=null){<div class="fiscal-banner">@mensaje</div>}
    @if(detalles.Count>0){<details><summary>Resultado de importación (@detalles.Count archivos)</summary><div class="fiscal-log">@foreach(var d in detalles){<p>@d</p>}</div></details>}
    <div class="fiscal-stats"><section><small>IMPORTADAS (VISTA)</small><strong>@filas.Count</strong></section><section><small>PENDIENTES IDENTIFICADAS</small><strong>@filas.Count(x=>x.Estado=="Pendiente"&&ListaParaEnviar(x))</strong></section><section><small>SIN VINCULAR</small><strong>@filas.Count(x=>!x.Vinculada)</strong></section><section><small>REVISAR ALUMNOS</small><strong>@filas.Count(x=>x.Vinculada&&x.Alumnos.Count==0)</strong></section><section><small>ENVIADAS</small><strong>@filas.Count(x=>x.Estado=="Enviado")</strong></section></div>
    <div class="fiscal-panel">
        <div class="fiscal-toolbar"><input placeholder="Buscar alumno, responsable, documento o factura…" @bind="buscar" @bind:event="oninput"/><input type="month" value="@mes" @onchange="CambiarMes"/><select @bind="estado"><option value="">Todos los estados</option><option>Pendiente</option><option>EnCola</option><option>EnProceso</option><option>Enviado</option><option>Error</option><option>Sin vincular</option><option>Sin alumnos</option></select><button disabled="@ocupado" @onclick="Seleccionar">Seleccionar pendientes visibles</button><button disabled="@(ocupado||seleccion.Count==0||!enviosHabilitados)" @onclick="()=>confirmar=true">Preparar envío (@seleccion.Count)</button></div>
        <div class="fiscal-table"><table><thead><tr><th></th><th>Factura / Fecha</th><th>Receptor fiscal</th><th>Importe</th><th>Destinatario</th><th>Alumnos incluidos</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
        @foreach(var f in Visible){<tr><td><input type="checkbox" checked="@seleccion.Contains(f.Id)" disabled="@(ocupado||f.Estado!="Pendiente"||!ListaParaEnviar(f))" @onchange="e=>Marcar(f.Id,e.Value is true)"/></td><td><strong>@f.Comprobante</strong><small>@f.Fecha.ToString("dd/MM/yyyy")</small></td><td>@f.Receptor<small>@(f.Contrastada?"Contrastada con ARCA":"Leída del PDF")</small></td><td>@f.Importe.ToString("C2",System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</td><td>@(f.ResponsableNombre??"Sin vincular")<small>@f.Destinatario</small></td><td>@if(f.Alumnos.Count==0){<small class="fiscal-warn">Revisar asociación</small>}else{<div>@foreach(var a in f.Alumnos){<a class="fiscal-alumno" href="@($"/clientes/{a.BebeId}/datos-fiscales")">@a.Nombre</a>}@if(f.Alumnos.Count>1){<small>Factura compartida · @f.Alumnos.Count alumnos</small>}</div>}@if(f.Vinculada && (f.Estado is "Pendiente" or "Enviado" or "Error")){<button disabled="@ocupado" @onclick="()=>AbrirAlumnos(f)">@(f.Alumnos.Count==0?"Confirmar alumnos":"Editar alumnos")</button>}</td><td><span class="fiscal-status">@f.Estado</span></td><td><a href="@($"/facturas/archivo/{f.Id}")" target="_blank" rel="noopener">PDF</a> @if(f.Estado=="Pendiente"){<button disabled="@ocupado" @onclick="()=>AbrirVinculo(f)">Vincular</button> <button disabled="@ocupado" @onclick="()=>Reidentificar(f.Id)">Buscar CUIT/CUIL</button>}</td></tr>}
        </tbody></table></div>
        <p>Vista de las últimas 2.000 facturas. Enviado significa aceptado por SMTP, no confirma recepción o lectura. No se reintentan automáticamente errores ni envíos de resultado incierto.</p>
    </div>
    @if(vinculo!=null){<div class="fiscal-overlay"><section class="fiscal-dialog"><h2>Vincular destinatario fiscal</h2><p>Documento receptor: <strong>@vinculo.Receptor</strong> · @vinculo.Comprobante</p><p>Verificá el PDF y elegí el responsable autorizado que debe recibirlo.</p><input placeholder="Buscar contacto…" @bind="buscarContacto" @bind:event="oninput"/><select @bind="contactoId"><option value="">Seleccionar responsable</option>@foreach(var c in contactos.Where(c=>Coincide(c.Nombre+" "+c.Documento+" "+c.Email,buscarContacto)).Take(100)){<option value="@c.Id">@c.Nombre · @c.Documento · @c.Email</option>}</select><label><input type="checkbox" @bind="recordar"/> Recordar este documento fiscal para futuros meses</label><label><input type="checkbox" @bind="verificado"/> Confirmo que verifiqué la identidad y el correo del receptor</label><div class="fiscal-toolbar"><button @onclick="()=>vinculo=null">Cancelar</button><button disabled="@(ocupado||!verificado||!Guid.TryParse(contactoId,out _))" @onclick="GuardarVinculo">Confirmar</button></div></section></div>}
    @if(facturaAlumnos!=null){
        <div class="fiscal-overlay"><section class="fiscal-dialog">
            <h2>Alumnos incluidos en la factura</h2><p>@facturaAlumnos.Comprobante · @facturaAlumnos.Importe.ToString("C2",System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</p>
            <p>El sistema no pudo determinar una asociación inequívoca o estás corrigiendo el vínculo. Seleccioná únicamente los alumnos cuya cuota o servicio está incluido en el PDF. Si son hermanos y el comprobante incluye ambos, marcá los dos. Se envía un solo correo y no se generan pagos.</p>
            @foreach(var a in opcionesAlumnos){<label><input type="checkbox" checked="@alumnosElegidos.Contains(a.Id)" @onchange="e=>MarcarAlumno(a.Id,e.Value is true)"/> @a.Nombre @(a.Activo?"":"(Baja)")</label>}
            @if(opcionesAlumnos.Count==0){<p>No se encontraron alumnos vinculados a este destinatario. Revisá los datos fiscales.</p>}
            @if(errorAlumnos!=null){<p role="alert">@errorAlumnos</p>}
            <div class="fiscal-toolbar"><a href="@($"/facturas/archivo/{facturaAlumnos.Id}")" target="_blank" rel="noopener">Ver PDF</a><button disabled="@ocupado" @onclick="()=>facturaAlumnos=null">Cancelar</button><button disabled="@(ocupado||alumnosElegidos.Count==0)" @onclick="GuardarAlumnos">Confirmar alumnos</button></div>
        </section></div>
    }
    @if(confirmar){<div class="fiscal-overlay"><section class="fiscal-dialog"><h2>Confirmar envío masivo</h2><p>Revisá los @seleccion.Count destinatarios antes de enviar.</p><div class="fiscal-log">@foreach(var f in filas.Where(f=>seleccion.Contains(f.Id))){<p>@f.Comprobante → @f.Destinatario · @string.Join(", ",f.Alumnos.Select(a=>a.Nombre))</p>}</div><div class="fiscal-toolbar"><button @onclick="()=>confirmar=false">Cancelar</button><button disabled="@ocupado" @onclick="Enviar">Confirmar cola de envío</button></div></section></div>}
</div>
@code {
    private List<FacturaFila> filas=[];
    private List<ContactoFiscal> contactos=[];
    private List<FilaArca>? listado;
    private List<string> detalles=[];
    private HashSet<Guid> seleccion=[];
    private string buscar="",estado="",avance="",buscarContacto="",contactoId="";
    private string mes="";
    private bool ocupado,recordar,verificado,confirmar;
    private string? mensaje;
    private FacturaFila? vinculo,facturaAlumnos;
    private List<AlumnoFiscal> opcionesAlumnos=[];
    private HashSet<Guid> alumnosElegidos=[];
    private string? errorAlumnos;
    private static bool ListaParaEnviar(FacturaFila f)=>f.Vinculada&&f.Alumnos.Count>0;
    private async Task AbrirAlumnos(FacturaFila f){ocupado=true;errorAlumnos=null;try{opcionesAlumnos=await Servicio.CandidatosFacturaAsync(f.Id);alumnosElegidos=(f.Alumnos.Count>0?f.Alumnos.Select(a=>a.BebeId):Enumerable.Empty<Guid>()).Where(id=>opcionesAlumnos.Any(a=>a.Id==id)).ToHashSet();facturaAlumnos=f;}catch{mensaje="No se pudieron cargar los alumnos del titular.";}finally{ocupado=false;}}
    private void MarcarAlumno(Guid id,bool valor){if(valor)alumnosElegidos.Add(id);else alumnosElegidos.Remove(id);}
    private async Task GuardarAlumnos(){if(facturaAlumnos==null)return;ocupado=true;errorAlumnos=null;try{await Servicio.GuardarAlumnosFacturaAsync(facturaAlumnos.Id,alumnosElegidos);seleccion.Remove(facturaAlumnos.Id);facturaAlumnos=null;mensaje="Alumnos asociados al comprobante.";await Cargar();}catch(InvalidOperationException ex){errorAlumnos=ex.Message;}catch{errorAlumnos="No se pudo guardar el vínculo. Actualizá la pantalla e intentá nuevamente.";}finally{ocupado=false;}}
    private static bool Coincide(string texto,string filtro)=>texto.Contains(filtro.Trim(),StringComparison.OrdinalIgnoreCase);
    private IEnumerable<FacturaFila> Visible=>filas.Where(f=>(mes==""||f.Fecha.ToString("yyyy-MM")==mes)&&(estado==""||estado==f.Estado||(estado=="Sin vincular"&&!f.Vinculada)||(estado=="Sin alumnos"&&f.Alumnos.Count==0))&&Coincide(f.Comprobante+" "+f.Receptor+" "+f.ResponsableNombre+" "+f.Destinatario+" "+string.Join(" ",f.Alumnos.Select(a=>a.Nombre)),buscar));
    private bool enviosHabilitados;
    protected override Task OnInitializedAsync()=>Cargar();
    private async Task Cargar(){ocupado=true;enviosHabilitados=false;try{enviosHabilitados=await Servicio.EnviosHabilitadosAsync();filas=await Servicio.ListarAsync();contactos=await Servicio.ContactosAsync();seleccion.RemoveWhere(id=>!filas.Any(f=>f.Id==id&&f.Estado=="Pendiente"&&ListaParaEnviar(f)));}catch{mensaje="No se pudo cargar Facturas fiscales. Verificá que se haya aplicado el SQL.";}finally{ocupado=false;}}
    private async Task CargarListado(InputFileChangeEventArgs e){ocupado=true;listado=null;try{using var ms=new MemoryStream();await e.File.OpenReadStream(10*1024*1024).CopyToAsync(ms);listado=FacturasService.LeerListado(ms.ToArray(),e.File.Name);mensaje="Listado cargado.";}catch(Exception ex){mensaje=ex.Message;}finally{ocupado=false;}}
    private async Task Importar(InputFileChangeEventArgs e){ocupado=true;detalles=[];try{var fs=e.GetMultipleFiles(500);int i=0;foreach(var f in fs){avance=$"Procesando {++i} de {fs.Count}";try{using var ms=new MemoryStream();await f.OpenReadStream(10*1024*1024).CopyToAsync(ms);detalles.Add(f.Name+": "+await Servicio.ImportarAsync(ms.ToArray(),listado));}catch(InvalidDataException ex){detalles.Add(f.Name+": "+ex.Message);}catch{detalles.Add(f.Name+": no se pudo importar. Revisar formato o base de datos.");}await InvokeAsync(StateHasChanged);}avance="Proceso terminado.";await Cargar();}catch{mensaje="Seleccioná hasta 500 archivos por lote.";}finally{ocupado=false;}}
    private void CambiarMes(ChangeEventArgs e)=>mes=e.Value?.ToString()??"";
    private void Marcar(Guid id,bool v){if(v)seleccion.Add(id);else seleccion.Remove(id);}
    private void Seleccionar(){foreach(var f in Visible.Where(f=>f.Estado=="Pendiente"&&ListaParaEnviar(f)))seleccion.Add(f.Id);}
    private void AbrirVinculo(FacturaFila f){vinculo=f;buscarContacto="";contactoId=f.ResponsableId?.ToString()??"";recordar=false;verificado=false;}
    private async Task GuardarVinculo(){if(vinculo==null||!verificado||!Guid.TryParse(contactoId,out var id))return;ocupado=true;try{await Servicio.VincularAsync(vinculo.Id,id,recordar);vinculo=null;await Cargar();}catch(InvalidOperationException ex){mensaje=ex.Message;vinculo=null;}catch{mensaje="No se pudo confirmar el vínculo.";}finally{ocupado=false;}}
    private async Task Reidentificar(Guid id){ocupado=true;try{await Servicio.ReidentificarAsync(id);mensaje="Destinatario fiscal actualizado.";seleccion.Remove(id);await Cargar();}catch(InvalidOperationException ex){mensaje=ex.Message;}catch{mensaje="No se pudo identificar la factura.";}finally{ocupado=false;}}
    private async Task Enviar(){if(!confirmar||!enviosHabilitados)return;ocupado=true;try{var total=seleccion.Count;var n=await Servicio.EncolarAsync(seleccion);mensaje=n==total?$"{n} facturas agregadas a la cola.":$"{n} de {total} facturas agregadas a la cola. Revisá el destinatario y los alumnos de las restantes.";seleccion.Clear();confirmar=false;await Cargar();}catch{mensaje="No se pudo completar la cola. Actualizá la pantalla antes de volver a intentar.";}finally{ocupado=false;}}
}
