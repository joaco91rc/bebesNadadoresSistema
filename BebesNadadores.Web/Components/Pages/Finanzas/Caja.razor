                                    <div class="concept-order">
                                        @concepto.Orden
                                    </div>


                                    <div class="concept-data">

                                        <strong>
                                            @concepto.Nombre
                                        </strong>

                                       <small>
    @(EsConceptoSistema(concepto)
        ? "Concepto automático del sistema"
        : concepto.Activo
            ? "Disponible para usar"
            : "Concepto inactivo")
</small>

                                    </div>


                                    <span class="concept-status @(concepto.Activo ? "active" : "inactive")">

                                        @(concepto.Activo
                                            ? "Activo"
                                            : "Inactivo")

                                    </span>


                                   @if (!EsConceptoSistema(concepto))
{
    <button type="button"
            class="icon-action"
            title="Editar"
            @onclick="() => EditarConceptoCaja(concepto)">

        <MudIcon Icon="@Icons.Material.Filled.Edit"
                 Size="Size.Small" />

    </button>


    <button type="button"
            class="icon-action @(concepto.Activo ? "deactivate" : "activate")"
            title="@(concepto.Activo ? "Desactivar" : "Activar")"
            disabled="@_procesandoConcepto"
            @onclick="() => CambiarEstadoConceptoAsync(concepto)">

        <MudIcon Icon="@(concepto.Activo
            ? Icons.Material.Filled.Block
            : Icons.Material.Filled.CheckCircle)"
                 Size="Size.Small" />

    </button>
}
else
{
    <span class="system-concept-icon"
          title="Concepto del sistema">

        <MudIcon Icon="@Icons.Material.Filled.Lock"
                 Size="Size.Small" />

    </span>

    <span></span>
}

                                </article>
                            }

                        </div>
                    }

                </section>


                @* =============================================
                   EGRESOS
                   ============================================= *@

                <section class="concept-group">

                    <div class="concept-group-title">

                        <div class="concept-group-icon expense">

                            <MudIcon Icon="@Icons.Material.Filled.ArrowUpward"
                                     Size="Size.Small" />

                        </div>


                        <div>

                            <span>
                                EGRESOS
                            </span>

                            <strong>
                                Salidas de efectivo
                            </strong>

                        </div>


                        <span class="concept-count">
                            @ConceptosEgresoVisibles.Count
                        </span>

                    </div>


                    @if (ConceptosEgresoVisibles.Count == 0)
                    {
                        <div class="empty-concepts">

                            No hay conceptos de egreso
                            @( _mostrarConceptosInactivos
                                ? "cargados."
                                : "activos." )

                        </div>
                    }
                    else
                    {
                        <div class="concept-list">

                            @foreach (var concepto in ConceptosEgresoVisibles)
                            {
                                <article class="concept-item @(!concepto.Activo ? "inactive" : "")">

                                    <div class="concept-order">
                                        @concepto.Orden
                                    </div>


                                    <div class="concept-data">

                                        <strong>
                                            @concepto.Nombre
                                        </strong>

                                        <small>
                                            @(concepto.Activo
                                                ? "Disponible para usar"
                                                : "Concepto inactivo")
                                        </small>

                                    </div>


                                    <span class="concept-status @(concepto.Activo ? "active" : "inactive")">

                                        @(concepto.Activo
                                            ? "Activo"
                                            : "Inactivo")

                                    </span>


                                    <button type="button"
                                            class="icon-action"
                                            title="Editar"
                                            @onclick="() => EditarConceptoCaja(concepto)">

                                        <MudIcon Icon="@Icons.Material.Filled.Edit"
                                                 Size="Size.Small" />

                                    </button>


                                    <button type="button"
                                            class="icon-action @(concepto.Activo ? "deactivate" : "activate")"
                                            title="@(concepto.Activo ? "Desactivar" : "Activar")"
                                            disabled="@_procesandoConcepto"
                                            @onclick="() => CambiarEstadoConceptoAsync(concepto)">

                                        <MudIcon Icon="@(concepto.Activo
                                            ? Icons.Material.Filled.Block
                                            : Icons.Material.Filled.CheckCircle)"
                                                 Size="Size.Small" />

                                    </button>

                                </article>
                            }

                        </div>
                    }

                </section>

            </div>

        </aside>

    </div>
}


@* =============================================================
   MODAL NUEVO / EDITAR CONCEPTO
   ============================================================= *@

@if (_modalConcepto)
{
    <div class="modal-overlay concept-modal-overlay"
         @onclick="CerrarModalConcepto">

        <section class="premium-modal concept-modal"
                 @onclick:stopPropagation="true">

            <div class="modal-header">

                <div>

                    <span>
                        CONFIGURACIÓN DE CAJA
                    </span>

                    <h2>
                        @(_editandoConceptoId.HasValue
                            ? "Editar concepto"
                            : "Nuevo concepto")
                    </h2>

                </div>


                <button type="button"
                        class="modal-close"
                        @onclick="CerrarModalConcepto">

                    <MudIcon Icon="@Icons.Material.Filled.Close" />

                </button>

            </div>


            <div class="modal-body form-grid">

                <div class="form-field full">

                    <label>
                        Nombre *
                    </label>

                    <input type="text"
                           maxlength="150"
                           placeholder="Ej. Compra de cloro"
                           @bind="_conceptoForm.Nombre" />

                </div>


                <div class="form-field">

                    <label>
                        Tipo de movimiento *
                    </label>

                    <select @bind="_conceptoForm.Tipo">

                        <option value="@TipoMovimientoCaja.Ingreso">
                            Ingreso
                        </option>

                        <option value="@TipoMovimientoCaja.Egreso">
                            Egreso
                        </option>

                    </select>

                </div>


                <div class="form-field">

                    <label>
                        Orden
                    </label>

                    <input type="number"
                           min="0"
                           step="1"
                           @bind="_conceptoForm.Orden" />

                </div>


                <div class="concept-type-preview full @(_conceptoForm.Tipo == TipoMovimientoCaja.Ingreso ? "income" : "expense")">

                    <span class="concept-preview-icon">

                        <MudIcon Icon="@(_conceptoForm.Tipo == TipoMovimientoCaja.Ingreso
                            ? Icons.Material.Filled.ArrowDownward
                            : Icons.Material.Filled.ArrowUpward)" />

                    </span>


                    <div>

                        <strong>
                            @(_conceptoForm.Tipo ==
                                TipoMovimientoCaja.Ingreso
                                    ? "Ingreso de efectivo"
                                    : "Egreso de efectivo")
                        </strong>

                        <small>
                            @(_conceptoForm.Tipo ==
                                TipoMovimientoCaja.Ingreso
                                    ? "Este concepto aumentará el saldo esperado de caja."
                                    : "Este concepto disminuirá el saldo esperado de caja.")
                        </small>

                    </div>

                </div>


                <label class="active-checkbox full">

                    <input type="checkbox"
                           @bind="_conceptoForm.Activo" />

                    <span>

                        <strong>
                            Concepto activo
                        </strong>

                        <small>
                            Los conceptos inactivos no aparecen
                            al registrar movimientos.
                        </small>

                    </span>

                </label>

            </div>


            @if (!string.IsNullOrWhiteSpace(_errorConceptoModal))
            {
                <div class="concept-modal-error">

                    <MudIcon Icon="@Icons.Material.Filled.Error"
                             Size="Size.Small" />

                    @_errorConceptoModal

                </div>
            }


            <div class="modal-footer">

                <button type="button"
                        class="cancel-action"
                        @onclick="CerrarModalConcepto">

                    Cancelar

                </button>


                <button type="button"
                        class="primary-action"
                        disabled="@_procesandoConcepto"
                        @onclick="GuardarConceptoCajaAsync">

                    <MudIcon Icon="@Icons.Material.Filled.Check"
                             Size="Size.Small" />

                    @(_procesandoConcepto
                        ? "Guardando..."
                        : _editandoConceptoId.HasValue
                            ? "Guardar cambios"
                            : "Crear concepto")

                </button>

            </div>

        </section>

    </div>
}



@* =========================================================
   REABRIR CAJA DE HOY (cerrada por error)
   ========================================================= *@

<BnAnulacionModal Visible="_mostrarReapertura"
                  Eyebrow="REAPERTURA"
                  Titulo="Reabrir la caja de hoy"
                  Detalle="@(_cajaHoy is null ? null : $"Caja del {_cajaHoy.FechaOperativa:dd/MM/yyyy} · cerrada con {FormatearMoneda(_cajaHoy.SaldoFinalDeclarado ?? 0)} declarados")"
                  Aviso="La caja vuelve a quedar abierta con todos sus movimientos. El cierre anterior (quién, cuándo y con qué saldo) queda guardado en el historial de reaperturas. Al terminar hay que cerrarla de nuevo."
                  Placeholder="Ej.: se cerró antes de tiempo, faltaba cargar un cobro..."
                  Icono="@Icons.Material.Filled.LockOpen"
                  TextoConfirmar="Reabrir caja"
                  TextoProcesando="Reabriendo..."
                  Tono="normal"
                  OnConfirmar="ConfirmarReaperturaAsync"
                  OnCerrar="CerrarReapertura" />

@* =========================================================
   ANULACIÓN DE MOVIMIENTO MANUAL
   ========================================================= *@

<BnAnulacionModal Visible="_movimientoAAnular is not null"
                  Titulo="Anular movimiento de caja"
                  Detalle="@(_movimientoAAnular is null ? null : $"{_movimientoAAnular.Concepto} · {ObtenerTipoMovimientoTexto(_movimientoAAnular.Tipo)}")"
                  Importe="@_movimientoAAnular?.Importe"
                  Aviso="Se registra un movimiento inverso en la caja de hoy. El original queda marcado como anulado."
                  OnConfirmar="ConfirmarAnulacionMovimientoAsync"
                  OnCerrar="CerrarAnulacionMovimiento" />
