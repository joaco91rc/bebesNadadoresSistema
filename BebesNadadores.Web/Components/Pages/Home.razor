    {
        <div class="birthday-today">

            <div class="birthday-today-icon">
                🎉
            </div>

            <div class="birthday-today-text">

                @if (CumpleaniosHoy.Count == 1)
                {
                    var cumple = CumpleaniosHoy.First();

                    <strong>
                        ¡Hoy es el cumple de @cumple.Nombre!
                    </strong>

                    <span>
                        Cumple @cumple.EdadQueCumple años
                    </span>
                }
                else
                {
                    <strong>
                        ¡Hoy hay @CumpleaniosHoy.Count cumpleaños!
                    </strong>

                    <span>
                        @string.Join(
                            ", ",
                            CumpleaniosHoy.Select(x => x.Nombre))
                    </span>
                }

            </div>

        </div>
    }


    <div class="birthday-list">

        @foreach (var cumple in CumpleaniosDelMes)
        {
           var esHoy = cumple.EsHoy;

            <div class="birthday-row @(esHoy ? "birthday-row-today" : "")">

               <div class="birthday-date">

    <strong>
        @cumple.FechaNacimiento.Day.ToString("00")
    </strong>

    <span>
        @ObtenerMesAbreviado(cumple.FechaNacimiento)
    </span>

</div>


                <div class="birthday-avatar">
                    @ObtenerIniciales(cumple.NombreCompleto)
                   
                </div>



                <div class="birthday-info">

                    <strong>
                        @cumple.NombreCompleto
                    </strong>

                    <span>
                        Cumple @cumple.EdadQueCumple años
                    </span>

                </div>


                @if (esHoy)
                {
                    <span class="birthday-today-badge">
                        HOY
                    </span>
                }
                else
                {
                    <div class="birthday-days">

                        @{
                            var faltan = cumple.DiasFaltantes;
                        }

                        @if (faltan > 0)
                        {
                            <span>
                                en
                            </span>

                            <strong>
                                @faltan
                            </strong>

                            <span>
                                @(faltan == 1 ? "día" : "días")
                            </span>
                        }

                    </div>
                }

            </div>
        }

    </div>

