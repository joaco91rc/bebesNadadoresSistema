private static string ObtenerMesAbreviado(
    DateOnly fecha)
{
    var cultura =
        new System.Globalization.CultureInfo("es-AR");

    return fecha
        .ToDateTime(TimeOnly.MinValue)
        .ToString("MMM", cultura)
        .TrimEnd('.')
        .ToUpperInvariant();
}

private static string ObtenerNombreMes(
    DateTime fecha)
{
    var cultura =
        new System.Globalization.CultureInfo("es-AR");

    return cultura
        .DateTimeFormat
        .GetMonthName(fecha.Month)
        .ToLowerInvariant();
}
