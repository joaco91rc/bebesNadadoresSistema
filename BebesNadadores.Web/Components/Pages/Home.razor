<section class="birthdays-card">

    <div class="birthdays-header">

        <div>
            <span class="birthdays-eyebrow">
                COMUNIDAD
            </span>

            <h2>
                Cumpleaños de @_ahora.ToString("MMMM",
                    new System.Globalization.CultureInfo("es-AR"))
            </h2>
        </div>

