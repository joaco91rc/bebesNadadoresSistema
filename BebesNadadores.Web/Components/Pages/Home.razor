@page "/"

@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable

@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.DependencyInjection
@using BebesNadadores.Infrastructure.Identity
@using BebesNadadores.Application.Asistencia
@using BebesNadadores.Application.Asistencia.Dtos
@using BebesNadadores.Domain.Enums
@using BebesNadadores.Application.Bebes
@using BebesNadadores.Application.Bebes.Dtos
@using BebesNadadores.Application.Comunicaciones
@using BebesNadadores.Application.Dashboard
@using BebesNadadores.Application.Dashboard.Dtos
@inject IBebeService BebeService
@inject IJSRuntime JS
@inject IAsistenciaService AsistenciaService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IServiceScopeFactory ScopeFactory

@inject IWhatsAppService WhatsAppService
@inject IDashboardService DashboardService
@inject PermisosUsuario Permisos
@inject ISnackbar Snackbar

<PageTitle>Dashboard | Bebés Nadadores</PageTitle>



<div class="dashboard">

    @* =========================================================
       HEADER
       ========================================================= *@

    <section class="dashboard-header">

        <div>

            <span class="dashboard-eyebrow">
                CENTRO OPERATIVO
            </span>

            <h1>
                Buen día, @_nombreCompleto
            </h1>

            <p>
                Este es el resumen de actividad de Bebés Nadadores.
            </p>

        </div>


        @if (_puedeGestionar)
        {
            <div class="header-actions">

                <button class="quick-primary" @onclick="IrAClientes">

                    <MudIcon Icon="@Icons.Material.Filled.ChildCare" Size="Size.Small" />

                    Inscribir bebé

                </button>

            </div>
        }

    </section>


    @* =========================================================
       KPIs
       ========================================================= *@

    <section class="kpi-grid">

        <article class="kpi-card">
            <div class="kpi-icon blue"><MudIcon Icon="@Icons.Material.Filled.ChildCare" /></div>
            <div class="kpi-body">
                <span>Bebés activos</span>
                <strong>@_dashboard.BebesActivos</strong>
                <small class="@(_dashboard.AltasMes > 0 ? "positive" : "")">
                    @if (_dashboard.AltasMes > 0)
                    {
                        <text>+@_dashboard.AltasMes este mes</text>
                    }
                    else
                    {
                        <text>Sin altas este mes</text>
                    }
                </small>
            </div>
        </article>

        @if (_puedeCaja)
        {
            <article class="kpi-card">
                <div class="kpi-icon warning"><MudIcon Icon="@Icons.Material.Filled.Payments" /></div>
                <div class="kpi-body">
                    <span>Cuotas pendientes</span>
                    <strong>@_dashboard.CuotasPendientes</strong>
                    <small>@FormatoMoneda(_dashboard.ImportePendiente)</small>
                </div>
            </article>
        }

        <article class="kpi-card">
            <div class="kpi-icon cyan"><MudIcon Icon="@Icons.Material.Filled.Autorenew" /></div>
            <div class="kpi-body">
                <span>Recuperos disponibles</span>
                <strong>@_dashboard.RecuperosDisponibles</strong>
                <small>
                    @_dashboard.RecuperosVencenProximos
                    @(_dashboard.RecuperosVencenProximos == 1
                        ? "vence en los próximos 7 días"
                        : "vencen en los próximos 7 días")
                </small>
            </div>
        </article>

        <article class="kpi-card">
            <div class="kpi-icon danger"><MudIcon Icon="@Icons.Material.Filled.MedicalServices" /></div>
            <div class="kpi-body">
                <span>Aptos a revisar</span>
                <strong>@_dashboard.AlertasMedicas</strong>
                <small>@_dashboard.AptosVencidos vencidos · @_dashboard.AptosSinApto sin apto</small>
            </div>
        </article>

        <article class="kpi-card">
            <div class="kpi-icon success"><MudIcon Icon="@Icons.Material.Filled.EventAvailable" /></div>
            <div class="kpi-body">
                <span>Vacantes hoy</span>
                <strong>@_dashboard.VacantesHoy</strong>
                <small>
                    @_dashboard.ClasesConVacantesHoy
                    @(_dashboard.ClasesConVacantesHoy == 1 ? "clase con lugar" : "clases con lugar")
                </small>
            </div>
        </article>

    </section>


    @* =========================================================
   CLASE EN CURSO
   ========================================================= *@

    @if (_claseActual is not null)
    {
        <section class="current-class-card">

            <div class="current-class-glow"></div>

            <div class="current-class-header">

                <div class="current-class-heading">

                    <div class="live-badge">
                        <span class="live-dot"></span>
                        CLASE EN CURSO
                    </div>

                    <h2>
                        @_claseActual.Nivel
                    </h2>

                    <div class="current-class-meta">

                        <span>
                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" />

                            @_claseActual.HoraInicio.ToString("HH:mm")
                            —
                            @_claseActual.HoraFin.ToString("HH:mm")
                        </span>

                        <span>
                            <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" />

                            @_claseActual.Alumnos.Count alumnos
                        </span>

                        <span>
                            <MudIcon Icon="@Icons.Material.Filled.Sports" Size="Size.Small" />

                            @(_claseActual.Profesores is { Count: > 0 }
        ? string.Join(
            " + ",
            _claseActual.Profesores)
        : "Sin profesor")
                        </span>

                    </div>

                </div>


                <div class="current-class-clock">

                    <span>
                        AHORA
                    </span>

                    <strong>
                        @_ahora.ToString("HH:mm")
                    </strong>

                </div>

            </div>


            <div class="attendance-summary">

                <div class="attendance-stat">

                    <span class="attendance-dot present"></span>

                    <div>
                        <strong>@CantidadPresentes</strong>
                        <span>Presentes</span>
                    </div>

                </div>


                <div class="attendance-stat">

                    <span class="attendance-dot notified"></span>

                    <div>
                        <strong>@CantidadAusentesConAviso</strong>
                        <span>Con aviso</span>
                    </div>

                </div>


                <div class="attendance-stat">

                    <span class="attendance-dot absent"></span>

                    <div>
                        <strong>@CantidadAusentes</strong>
                        <span>Ausentes</span>
                    </div>

                </div>


                <div class="attendance-stat">

                    <span class="attendance-dot pending"></span>

                    <div>
                        <strong>@CantidadPendientes</strong>
                        <span>Pendientes</span>
                    </div>

                </div>

            </div>


            <div class="student-list">

                @foreach (var alumno in _claseActual.Alumnos)
                {
                    <div @key="alumno.BebeId" class="student-row
                        @(alumno.Estado == EstadoAsistencia.Presente
                                 ? "student-present"
                                 : alumno.Estado == EstadoAsistencia.AusenteConAviso
                                     ? "student-notified"
                                     : alumno.Estado == EstadoAsistencia.Ausente
                                         ? "student-absent"
                                         : "")">

                        <div class="student-main">

                            <div class="student-avatar">

                                @ObtenerIniciales(
                                    alumno.NombreCompleto)

                            </div>


                            <div class="student-info">

                                <strong>
                                    @alumno.NombreCompleto
                                </strong>

                                <span>
                                    @(alumno.EsRecupero
                                        ? "Asiste por recupero"
                                        : "Alumno regular")
                                </span>

                            </div>

                        </div>


                        <div class="student-status">

                            @if (alumno.Estado ==
                                 EstadoAsistencia.Presente)
                            {
                                <span class="status-label status-present">
                                    PRESENTE
                                </span>
                            }
                            else if (alumno.Estado ==
                                     EstadoAsistencia.AusenteConAviso)
                            {
                                <span class="status-label status-notified">
                                    AUSENTE C/ AVISO
                                </span>
                            }
                            else if (alumno.Estado ==
                                     EstadoAsistencia.Ausente)
                            {
                                <span class="status-label status-absent">
                                    AUSENTE
                                </span>
                            }
                            else
                            {
                                <span class="status-label status-pending">
                                    SIN MARCAR
                                </span>
                            }

                        </div>


                        <div class="student-actions">

                            <button type="button" class="attendance-button present-button
                                @(alumno.Estado == EstadoAsistencia.Presente
                                                        ? "selected"
                                                        : "")" title="Marcar presente" disabled="@(!_puedeGestionar)" @onclick="async () => await MarcarAsistencia(
                                alumno,
                                EstadoAsistencia.Presente)">

                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />

                            </button>


                            <button type="button" class="attendance-button notified-button
                                @(alumno.Estado == EstadoAsistencia.AusenteConAviso
                                                        ? "selected"
                                                        : "")" title="Ausente con aviso - genera recupero" disabled="@(!_puedeGestionar)" @onclick="async () => await MarcarAsistencia(
                                alumno,
                                EstadoAsistencia.AusenteConAviso)">

                                <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Size="Size.Small" />

                            </button>


                            <button type="button" class="attendance-button absent-button
                                @(alumno.Estado == EstadoAsistencia.Ausente
                                                        ? "selected"
                                                        : "")" title="Marcar ausente" disabled="@(!_puedeGestionar)" @onclick="async () => await MarcarAsistencia(
                                alumno,
                                EstadoAsistencia.Ausente)">

                                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />

                            </button>

                        </div>

                    </div>
                }

            </div>


            <div class="current-class-footer">

                <div class="attendance-progress">

                    <div class="attendance-progress-info">

                        <span>
                            Asistencia controlada
                        </span>

                        <strong>
                            @CantidadMarcados / @_claseActual.Alumnos.Count
                        </strong>

                    </div>

                    <div class="progress-track">

                        <div class="progress-value" style="@($"width:{PorcentajeMarcado}%")">
                        </div>

                    </div>

                </div>


                @if (_puedeGestionar)
                {
                    <button type="button" class="open-attendance-button" @onclick="AbrirAsistenciaCompleta">

                        Ver asistencia completa

                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />

                    </button>
                }

            </div>

        </section>
    }

    @* =========================================================
   CUMPLEAÑOS DEL MES
   ========================================================= *@

    <section class="birthdays-card">

        <div class="birthdays-header">

            <div>
                <span class="birthdays-eyebrow">
                    COMUNIDAD
                </span>

                <h2>
                    Cumpleaños de @_ahora.ToString(
                                                                                                    "MMMM",
                                                                                                    new System.Globalization.CultureInfo("es-AR"))
                </h2>
            </div>

            <div class="birthdays-icon">
                <MudIcon Icon="@Icons.Material.Filled.Cake" />
            </div>

        </div>


        @if (CumpleaniosHoy.Any())
        {
            <div class="birthday-today">

                <div class="birthday-today-icon">
                    🎉
                </div>

                <div class="birthday-today-text">

                    @if (CumpleaniosHoy.Count == 1)
                    {
                        var cumpleHoy =
                            CumpleaniosHoy.First();

                        <strong>
                            ¡Hoy es el cumple de @cumpleHoy.Nombre!
                        </strong>

                        <span>
                            Cumple @cumpleHoy.EdadQueCumple años
                        </span>
                    }
                    else
                    {
                        <strong>
                            ¡Hoy hay @CumpleaniosHoy.Count cumpleaños!
                        </strong>

                        <span>
                            @string.Join(
                                ", ",
                                CumpleaniosHoy.Select(x => x.Nombre))
                        </span>
                    }

                </div>

            </div>
        }


        <div class="birthday-list">

            @foreach (var cumple in CumpleaniosDelMes)
            {
                var esHoy =
                    cumple.EsHoy;

                <div class="birthday-row @(esHoy ? "birthday-row-today" : "")">

                    <div class="birthday-date">

                        <strong>
                            @cumple.FechaNacimiento.Day.ToString("00")
                        </strong>

                        <span>
                            @ObtenerMesAbreviado(
                                cumple.FechaNacimiento)
                        </span>

                    </div>


                    <div class="birthday-avatar">

                        @ObtenerIniciales(
                            cumple.NombreCompleto)

                    </div>


                    <div class="birthday-info">

                        <strong>
                            @cumple.NombreCompleto
                        </strong>

                        <span>
                            Cumple @cumple.EdadQueCumple años
                        </span>

                    </div>


                    @if (esHoy)
                    {
                        <div class="birthday-actions">

                            <span class="birthday-today-badge">
                                HOY
                            </span>


                            <button type="button" class="birthday-whatsapp-button" title="Saludar por WhatsApp" @onclick="async () =>
                                await SaludarCumpleaniosAsync(
                                cumple)">

                                <MudIcon Icon="@Icons.Material.Filled.Chat" Size="Size.Small" />

                                Saludar

                            </button>

                        </div>
                    }
                    else
                    {
                        <div class="birthday-days">

                            @{
                                var faltan =
                                    cumple.DiasFaltantes;
                            }

                            @if (faltan > 0)
                            {
                                <span>
                                    en
                                </span>

                                <strong>
                                    @faltan
                                </strong>

                                <span>
                                    @(faltan == 1
                                        ? "día"
                                        : "días")
                                </span>
                            }

                        </div>
                    }

                </div>
            }

        </div>

    </section>

    @* =========================================================
       GRID PRINCIPAL
       ========================================================= *@

    <section class="dashboard-grid">


        @* =====================================================
           CLASES DE HOY
           ===================================================== *@

        <article class="dashboard-card classes-card">

            <div class="card-header">

                <div>

                    <span class="card-eyebrow">
                        HOY
                    </span>

                    <h2>
                        Clases del día
                    </h2>

                </div>


                @if (_puedeGestionar)
                {
                    <button class="text-action" @onclick="IrATurnos">

                        Ver turnera

                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />

                    </button>
                }

            </div>


            <div class="class-list">

                @foreach (var clase in _dashboard.ClasesHoy)
                {
                    <div class="class-row">

                        <div class="class-time">

                            <strong>
                                @clase.Hora
                            </strong>

                            <span>
                                @clase.Duracion
                            </span>

                        </div>


                        <div class="class-line"></div>


                        <div class="class-info">

                            <div class="class-title">

                                <strong>
                                    @clase.Nivel
                                </strong>

                                <span class="occupancy @clase.EstadoCss">
                                    @clase.Cupo
                                </span>

                            </div>

                            <span>
                                @clase.Profesor
                            </span>

                        </div>


                        <button class="row-action"
                            title="Ver clase"
                            @onclick="() => AbrirAsistencia(clase.SesionClaseId)">

                            <MudIcon Icon="@Icons.Material.Filled.ArrowForwardIos" Size="Size.Small" />

                        </button>

                    </div>
                }

            </div>

        </article>


        @* =====================================================
           ALERTAS
           ===================================================== *@

        <article class="dashboard-card alerts-card">

            <div class="card-header">
                <div>
                    <span class="card-eyebrow">ATENCIÓN</span>
                    <h2>Alertas</h2>
                </div>
                <span class="alert-counter">@_dashboard.AlertasTotal</span>
            </div>

            <div class="alert-list">

                @if (_dashboard.AlertasMedicas > 0)
                {
                    <div class="alert-row danger-alert">
                        <div class="alert-icon"><MudIcon Icon="@Icons.Material.Filled.MedicalServices" /></div>
                        <div>
                            <strong>@_dashboard.AlertasMedicas aptos médicos requieren atención</strong>
                            <span>
                                @_dashboard.AptosSinApto sin apto ·
                                @_dashboard.AptosVencidos vencidos ·
                                @_dashboard.AptosPorVencer por vencer ·
                                @_dashboard.AptosObservados observados ·
                                @_dashboard.AptosNoAptos no aptos
                            </span>
                        </div>
                    </div>
                }

                @if (_dashboard.RecuperosVencenProximos > 0)
                {
                    <div class="alert-row warning-alert">
                        <div class="alert-icon"><MudIcon Icon="@Icons.Material.Filled.HourglassBottom" /></div>
                        <div>
                            <strong>
                                @_dashboard.RecuperosVencenProximos
                                @(_dashboard.RecuperosVencenProximos == 1
                                    ? "recupero próximo a vencer"
                                    : "recuperos próximos a vencer")
                            </strong>
                            <span>Vencen dentro de los próximos 7 días.</span>
                        </div>
                    </div>
                }

                @if (_dashboard.BebesProximosSiete > 0)
                {
                    <div class="alert-row blue-alert">
                        <div class="alert-icon"><MudIcon Icon="@Icons.Material.Filled.Cake" /></div>
                        <div>
                            <strong>
                                @_dashboard.BebesProximosSiete
                                @(_dashboard.BebesProximosSiete == 1
                                    ? "bebé próximo a cumplir 7 años"
                                    : "bebés próximos a cumplir 7 años")
                            </strong>
                            <span>Cumplen 7 dentro de los próximos 30 días.</span>
                        </div>
                    </div>
                }

                @if (_dashboard.AlertasTotal == 0)
                {
                    <div class="alert-row blue-alert">
                        <div class="alert-icon"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" /></div>
                        <div>
                            <strong>Sin alertas pendientes</strong>
                            <span>No hay situaciones que requieran atención inmediata.</span>
                        </div>
                    </div>
                }

            </div>

        </article>


        @* =====================================================
           VACANTES
           ===================================================== *@

        <article class="dashboard-card vacancies-card">

            <div class="card-header">

                <div>

                    <span class="card-eyebrow">
                        RECUPEROS
                    </span>

                    <h2>
                        Vacantes disponibles
                    </h2>

                </div>

            </div>


            <div class="vacancy-list">

                @foreach (var vacante in _dashboard.Vacantes)
                {
                    <div class="vacancy-row">

                        <div class="vacancy-date">

                            <span>
                                @vacante.Dia
                            </span>

                            <strong>
                                @vacante.Hora
                            </strong>

                        </div>


                        <div class="vacancy-info">

                            <strong>
                                @vacante.Nivel
                            </strong>

                            <span>
                                @vacante.Lugares @(vacante.Lugares == 1 ? "lugar disponible" : "lugares disponibles")
                            </span>

                        </div>


                        @if (_puedeGestionar)
                        {
                            <button class="notify-button" @onclick="IrAListaEspera">

                                <MudIcon Icon="@Icons.Material.Filled.Send" Size="Size.Small" />

                                Avisar

                            </button>
                        }

                    </div>
                }

            </div>

        </article>


        @* =====================================================
           CAJA
           ===================================================== *@

        @if (_puedeCaja)
        {
            <article class="dashboard-card cash-card">

                <div class="card-header">
                    <div>
                        <span class="card-eyebrow">CAJA</span>
                        <h2>Movimiento del día</h2>
                    </div>

                    <span class="cash-status">
                        @if (!_dashboard.Caja.Existe)
                        {
                            <text>Sin abrir</text>
                        }
                        else if (_dashboard.Caja.EstaAbierta)
                        {
                            <text>Abierta</text>
                        }
                        else
                        {
                            <text>Cerrada</text>
                        }
                    </span>
                </div>

                <div class="cash-total">
                    <span>Saldo efectivo</span>
                    <strong>@FormatoMoneda(_dashboard.Caja.SaldoEsperado)</strong>
                </div>

                <div class="cash-details">
                    <div>
                        <span>Ingresos</span>
                        <strong class="positive">+ @FormatoMoneda(_dashboard.Caja.Ingresos)</strong>
                    </div>

                    <div>
                        <span>Egresos</span>
                        <strong class="negative">- @FormatoMoneda(_dashboard.Caja.Egresos)</strong>
                    </div>

                    <div>
                        <span>Saldo inicial</span>
                        <strong>@FormatoMoneda(_dashboard.Caja.SaldoInicial)</strong>
                    </div>
                </div>

                <button class="card-bottom-action" @onclick="IrACaja">
                    Ir a Caja
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                </button>

            </article>
        }


        @* =====================================================
           ASISTENCIA
           ===================================================== *@

        <article class="dashboard-card attendance-card">

            <div class="card-header">

                <div>

                    <span class="card-eyebrow">
                        ÚLTIMOS 7 DÍAS
                    </span>

                    <h2>
                        Asistencia
                    </h2>

                </div>


                <strong class="attendance-value">
                    @($"{_dashboard.PorcentajeAsistenciaSemanal}%")
                </strong>

            </div>


            <div class="chart-bars">

                @foreach (var item in _dashboard.AsistenciaSemanal)
                {
                    <div class="chart-column">

                        <div class="chart-track">

                            <div class="chart-bar" style="@($"height:{item.Porcentaje}%")">
                            </div>

                        </div>

                        <span>
                            @item.Dia
                        </span>

                    </div>
                }

            </div>

        </article>


        @* =====================================================
           ACCESOS RÁPIDOS
           ===================================================== *@

        <article class="dashboard-card quick-card">

            <div class="card-header">

                <div>

                    <span class="card-eyebrow">
                        ACCIONES
                    </span>

                    <h2>
                        Accesos rápidos
                    </h2>

                </div>

            </div>


            <div class="quick-grid">

                @if (_puedeGestionar)
                {
                    <button @onclick="IrAClientes">

                        <span class="quick-icon">
                            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" />
                        </span>

                        <span>
                            Inscribir bebé
                        </span>

                    </button>
                }


                @if (_puedeCaja)
                {
                    <button @onclick="IrAPagos">

                        <span class="quick-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Payments" />
                        </span>

                        <span>
                            Registrar pago
                        </span>

                    </button>
                }


                @if (_puedeGestionar)
                {
                    <button type="button" class="open-attendance-button" @onclick="AbrirAsistenciaCompleta">

                        Ver asistencia completa

                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />

                    </button>
                }


                @if (_puedeMedica)
                {
                    <button @onclick="IrAAptosMedicos">

                        <span class="quick-icon">
                            <MudIcon Icon="@Icons.Material.Filled.MedicalServices" />
                        </span>

                        <span>
                            Cargar apto
                        </span>

                    </button>
                }

            </div>

        </article>

    </section>

</div>
