        <div class="current-class-glow"></div>

        <div class="current-class-header">

            <div class="current-class-heading">

                <div class="live-badge">
                    <span class="live-dot"></span>
                    CLASE EN CURSO
                </div>

                <h2>
                    @_claseActual.Nivel
                </h2>

                <div class="current-class-meta">

                    <span>
                        <MudIcon Icon="@Icons.Material.Filled.Schedule"
                                 Size="Size.Small" />

                        @_claseActual.HoraInicio.ToString("HH:mm")
                        —
                        @_claseActual.HoraFin.ToString("HH:mm")
                    </span>

                    <span>
                        <MudIcon Icon="@Icons.Material.Filled.Groups"
                                 Size="Size.Small" />

                        @_claseActual.Alumnos.Count alumnos
                    </span>

                    <span>
                        <MudIcon Icon="@Icons.Material.Filled.Sports"
                                 Size="Size.Small" />

                        @(_claseActual.Profesores is { Count: > 0 }
    ? string.Join(
        " + ",
        _claseActual.Profesores)
    : "Sin profesor")
                    </span>

                </div>

            </div>


            <div class="current-class-clock">

                <span>
                    AHORA
                </span>

                <strong>
                    @_ahora.ToString("HH:mm")
                </strong>

            </div>

        </div>


       <div class="attendance-summary">

    <div class="attendance-stat">

        <span class="attendance-dot present"></span>

        <div>
            <strong>@CantidadPresentes</strong>
            <span>Presentes</span>
        </div>

    </div>


    <div class="attendance-stat">

        <span class="attendance-dot notified"></span>

        <div>
            <strong>@CantidadAusentesConAviso</strong>
            <span>Con aviso</span>
        </div>

    </div>


    <div class="attendance-stat">

        <span class="attendance-dot absent"></span>

        <div>
            <strong>@CantidadAusentes</strong>
            <span>Ausentes</span>
        </div>

    </div>


    <div class="attendance-stat">

        <span class="attendance-dot pending"></span>

        <div>
            <strong>@CantidadPendientes</strong>
            <span>Pendientes</span>
        </div>

    </div>

</div>


        <div class="student-list">

    @foreach (var alumno in _claseActual.Alumnos)
    {
        <div @key="alumno.BebeId"
             class="student-row
                    @(alumno.Estado == EstadoAsistencia.Presente
                        ? "student-present"
                        : alumno.Estado == EstadoAsistencia.AusenteConAviso
                            ? "student-notified"
                            : alumno.Estado == EstadoAsistencia.Ausente
                                ? "student-absent"
                                : "")">

            <div class="student-main">

                <div class="student-avatar">

                    @ObtenerIniciales(
                        alumno.NombreCompleto)

                </div>


                <div class="student-info">

                    <strong>
                        @alumno.NombreCompleto
                    </strong>

                    <span>
                        @(alumno.EsRecupero
                            ? "Asiste por recupero"
                            : "Alumno regular")
                    </span>

                </div>

            </div>


            <div class="student-status">

                @if (alumno.Estado ==
                     EstadoAsistencia.Presente)
                {
                    <span class="status-label status-present">
                        PRESENTE
                    </span>
                }
                else if (alumno.Estado ==
                         EstadoAsistencia.AusenteConAviso)
                {
                    <span class="status-label status-notified">
                        AUSENTE C/ AVISO
                    </span>
                }
                else if (alumno.Estado ==
                         EstadoAsistencia.Ausente)
                {
                    <span class="status-label status-absent">
                        AUSENTE
                    </span>
                }
                else
                {
                    <span class="status-label status-pending">
                        SIN MARCAR
                    </span>
                }

            </div>


            <div class="student-actions">

                <button type="button"
                        class="attendance-button present-button
                               @(alumno.Estado == EstadoAsistencia.Presente
                                   ? "selected"
                                   : "")"
                        title="Marcar presente"
                        @onclick="async () => await MarcarAsistencia(
                            alumno,
                            EstadoAsistencia.Presente)">

                    <MudIcon Icon="@Icons.Material.Filled.Check"
                             Size="Size.Small" />

                </button>


                <button type="button"
                        class="attendance-button notified-button
                               @(alumno.Estado == EstadoAsistencia.AusenteConAviso
                                   ? "selected"
                                   : "")"
                        title="Ausente con aviso - genera recupero"
                        @onclick="async () => await MarcarAsistencia(
                            alumno,
                            EstadoAsistencia.AusenteConAviso)">

                    <MudIcon Icon="@Icons.Material.Filled.NotificationsActive"
                             Size="Size.Small" />

                </button>


                <button type="button"
                        class="attendance-button absent-button
                               @(alumno.Estado == EstadoAsistencia.Ausente
                                   ? "selected"
                                   : "")"
                        title="Marcar ausente"
                        @onclick="async () => await MarcarAsistencia(
                            alumno,
                            EstadoAsistencia.Ausente)">

                    <MudIcon Icon="@Icons.Material.Filled.Close"
                             Size="Size.Small" />

                </button>

            </div>

        </div>
    }

</div>


        <div class="current-class-footer">

            <div class="attendance-progress">

                <div class="attendance-progress-info">

                    <span>
                        Asistencia controlada
                    </span>

                    <strong>
                        @CantidadMarcados / @_claseActual.Alumnos.Count
                    </strong>

                </div>

                <div class="progress-track">

                    <div class="progress-value"
                         style="@($"width:{PorcentajeMarcado}%")">
                    </div>

                </div>

            </div>


