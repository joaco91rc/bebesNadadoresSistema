        class="open-attendance-button"
        @onclick="AbrirAsistenciaCompleta">

    Ver asistencia completa

    <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
             Size="Size.Small" />

</button>

        </div>

    </section>
}

