private static string ObtenerIniciales(
    string nombre)
{
    var partes =
        nombre.Split(
            ' ',
            StringSplitOptions.RemoveEmptyEntries);

    if (partes.Length == 0)
        return "?";

    if (partes.Length == 1)
        return partes[0][0]
            .ToString()
            .ToUpperInvariant();

    return string.Concat(
        partes[0][0],
        partes[^1][0])
        .ToUpperInvariant();
}









