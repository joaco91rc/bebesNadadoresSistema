@page "/lista-espera"
@attribute [Authorize(Policy = PoliticasSistema.GestionAdministrativa)]
@using BebesNadadores.Domain.Enums
@using BebesNadadores.Application.ListaEspera.Dtos
<PageTitle>Lista de espera de inscripción | Bebés Nadadores</PageTitle>
<div class="wait-page">
    <header class="wait-header">
        <div class="header-main">
            <button type="button" class="back-button" @onclick="Volver"><MudIcon Icon="@Icons.Material.Filled.ArrowBack" /></button>
            <div><span class="page-eyebrow">NUEVAS INSCRIPCIONES</span><h1>Lista de espera</h1>
                <p>Familias interesadas en inscribirse que esperan disponibilidad. Los recuperos de alumnos se gestionan en Recuperos.</p></div>
        </div>
        <button type="button" class="primary-action" @onclick="AbrirNuevo"><MudIcon Icon="@Icons.Material.Filled.Add" /> Agregar interesado</button>
    </header>
    @if (!string.IsNullOrWhiteSpace(_error)) { <div class="message-box error">@_error</div> }
    @if (!string.IsNullOrWhiteSpace(_mensaje)) { <div class="message-box success">@_mensaje</div> }
    <section class="wait-stats">
        <article class="stat-card"><div><span>En espera</span><strong>@_items.Count(x => x.Estado == EstadoListaEspera.Activa)</strong></div></article>
        <article class="stat-card"><div><span>Contactados</span><strong>@_items.Count(x => x.Estado == EstadoListaEspera.Notificada)</strong></div></article>
        <article class="stat-card"><div><span>Inscripciones concretadas</span><strong>@_items.Count(x => x.Estado == EstadoListaEspera.Asignada)</strong></div></article>
    </section>
    <div class="wait-filterbar">
        <input class="wait-control" placeholder="Buscar niño, responsable, teléfono o nivel" @bind="_busqueda" @bind:event="oninput" />
        <label class="wait-toggle"><input type="checkbox" @bind="_verHistorial" @bind:after="CargarAsync" /> Mostrar historial y finalizadas</label>
        <small class="availability-date">Vacantes de inscripción al @_fechaDisponibilidad.ToString("dd/MM/yyyy")</small>
        <button class="wait-btn" @onclick="CargarAsync">Actualizar</button>
    </div>
    @if (_cargando) { <div class="page-loading"><MudProgressCircular Indeterminate="true" /> Cargando interesados...</div> }
    else if (!ItemsFiltrados.Any()) { <div class="wait-empty">No hay solicitudes que coincidan con la búsqueda.</div> }
    else
    {
        <div class="wait-list">
            @foreach (var item in ItemsFiltrados)
            {
                <article class="wait-entry" @key="item.Id">
                    <div class="wait-entry-main">
                        <strong>@item.NombreBebe</strong>
                        <span class="wait-pill">@TextoEstado(item.Estado)</span>
                        <p>Responsable: @item.NombreResponsable · @item.Telefono</p>
                        <p>@item.Nivel @if (!string.IsNullOrWhiteSpace(item.Turno)) { <span>· @item.Turno</span> } · @TextoPreferencia(item)</p>
                        @if (item.Estado is EstadoListaEspera.Activa or EstadoListaEspera.Notificada)
                        {
                            var disponibilidad = Disponibilidad(item);
                            <div class="wait-availability @disponibilidad.Clase" aria-live="polite">
                                <strong>@disponibilidad.Titulo</strong>
                                @if (!string.IsNullOrWhiteSpace(disponibilidad.Detalle))
                                { <span>@disponibilidad.Detalle</span> }
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.Observaciones)) { <p>@item.Observaciones</p> }
                        <small>Registrado: @item.FechaAltaUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                    <div class="wait-entry-actions">
                        <button class="wait-btn" @onclick="() => AbrirEditar(item)">Editar</button>
                        @if (item.Estado is EstadoListaEspera.Activa or EstadoListaEspera.Notificada)
                        {
                            <button class="wait-btn" @onclick="() => AvisarAsync(item)">Abrir WhatsApp</button>
                            @if (item.Estado == EstadoListaEspera.Activa)
                            { <button class="wait-btn" @onclick="() => CambiarEstadoAsync(item, EstadoListaEspera.Notificada)">Marcar avisado</button> }
                            <button class="primary-action wait-start" disabled="@(!PuedeIniciarInscripcion(item))"
                                    title="@(PuedeIniciarInscripcion(item) ? "Completar inscripción con los datos de esta solicitud" : "No hay vacantes regulares para este nivel")"
                                    @onclick="() => IniciarInscripcion(item)">Iniciar inscripción</button>
                            <button class="wait-btn wait-danger" @onclick="() => CambiarEstadoAsync(item, EstadoListaEspera.Cancelada)">Cancelar</button>
                        }
                        @if (item.Estado == EstadoListaEspera.Cancelada) { <button class="wait-btn" @onclick="() => CambiarEstadoAsync(item, EstadoListaEspera.Activa)">Reabrir</button> }
                    </div>
                </article>
            }
        </div>
    }
    @if (_modalAbierto)
    {
        <div class="wait-overlay" @onclick="CerrarModal">
            <section class="wait-dialog" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-label="Interesado en inscripción">
                <h2>@(_editandoId.HasValue ? "Editar interesado" : "Nuevo interesado")</h2>
                @if (!string.IsNullOrWhiteSpace(_errorModal)) { <div class="message-box error">@_errorModal</div> }
                <div class="wait-fields">
                    <label>Nombre del niño/a * <input class="wait-control" maxlength="200" @bind="_form.NombreBebe" /></label>
                    <label>Nombre del responsable * <input class="wait-control" maxlength="200" @bind="_form.NombreResponsable" /></label>
                    <label>WhatsApp / teléfono * <input class="wait-control" maxlength="60" @bind="_form.Telefono" /></label>
                    <label>Email <input class="wait-control" maxlength="200" @bind="_form.Email" /></label>
                    <label>Nivel *
                        <select class="wait-control" value="@_form.NivelId.ToString()" @onchange="CambiarNivel">
                            <option value="@Guid.Empty">Elegir nivel</option>
                            @foreach (var nivel in _niveles) { <option value="@nivel.Id">@nivel.Nombre</option> }
                        </select>
                    </label>
                    <label>Horario solicitado
                        <select class="wait-control" value="@(_form.TurnoId?.ToString() ?? "")" @onchange="CambiarTurno">
                            <option value="">Sin horario específico</option>
                            @foreach (var turno in _turnos.Where(x => x.NivelId == _form.NivelId))
                            { <option value="@turno.Id">@turno.Nombre · @turno.Hora.ToString("HH:mm")</option> }
                        </select>
                    </label>
                    <label>Día preferido
                        <select class="wait-control" value="@(_form.DiaPreferido?.ToString() ?? "")" @onchange="CambiarDia">
                            <option value="">Cualquier día</option>
                            @foreach (var dia in Enum.GetValues<DiaSemana>()) { <option value="@dia">@dia</option> }
                        </select>
                    </label>
                    <label>Franja horaria
                        <select class="wait-control" @bind="_form.FranjaHoraria">
                            @foreach (var franja in Enum.GetValues<FranjaHoraria>()) { <option value="@franja">@franja</option> }
                        </select>
                    </label>
                    <label class="wait-full">Observaciones <textarea class="wait-control" rows="3" maxlength="1000" @bind="_form.Observaciones"></textarea></label>
                </div>
                <div class="wait-modal-actions"><button class="wait-btn" @onclick="CerrarModal">Cancelar</button>
                    <button class="primary-action" disabled="@_guardando" @onclick="GuardarAsync">Guardar interesado</button></div>
            </section>
        </div>
    }
    @if (_inscribiendo is not null)
    {
        <div class="wait-overlay" @onclick="() => _inscribiendo = null">
            <section class="wait-dialog" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
                <h2>Vincular inscripción de @_inscribiendo.NombreBebe</h2>
                <p>Seleccioná el alumno ya inscripto. La lista no genera inscripciones automáticamente.</p>
                <label>Buscar por nombre o apellido
                    <input class="wait-control" @bind="_buscarInscrito" />
                </label>
                <button class="wait-btn" @onclick="BuscarInscritosAsync">Buscar alumnos inscriptos</button>
                <select class="wait-control" @bind="_bebeInscriptoId">
                    <option value="@Guid.Empty">Seleccioná un alumno</option>
                    @foreach (var alumno in _inscritos)
                    { <option value="@alumno.Id">@alumno.Nombre</option> }
                </select>
                <div class="wait-modal-actions">
                    <button class="wait-btn" @onclick="() => _inscribiendo = null">Cancelar</button>
                    <button class="primary-action" disabled="@(_bebeInscriptoId == Guid.Empty)" @onclick="ConfirmarInscripcionAsync">Confirmar inscripción</button>
                </div>
            </section>
        </div>
    }
</div>
