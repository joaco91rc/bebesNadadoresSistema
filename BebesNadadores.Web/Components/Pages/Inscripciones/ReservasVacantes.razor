.rv-pending-note p{margin:5px 0 0;font-size:.9rem;line-height:1.4}
.rv-pending-head{display:flex;gap:8px;justify-content:space-between;align-items:center;flex-wrap:wrap}
.rv-pending-head span{font-size:.8rem;opacity:.7}
.rv-pending-list{max-height:540px;overflow:auto;display:flex;flex-direction:column;gap:10px}
.rv-pending-row{border:1px solid rgba(113,154,182,.22);border-radius:13px;padding:13px;display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between}
.rv-pending-row small{display:block;margin-top:3px;opacity:.7}
.rv-pending-row .rv-state{display:inline-block;margin-top:8px}
.rv-pending-actions{display:flex;flex-direction:column;align-items:stretch;gap:7px}
