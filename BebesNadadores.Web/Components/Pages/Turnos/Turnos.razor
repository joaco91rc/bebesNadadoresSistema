private void AbrirNuevoTurnoDesdeGrilla(
    DiaSemana dia)
{
    _mostrarGrillaSemanal =
        false;

    _volverAGrillaDespuesDeGuardar =
        true;


    /*
     * Buscamos el último horario configurado
     * para ese día dentro del ciclo seleccionado.
     */
    var ultimoTurno =
        _turnosConfigurados
            .Where(x =>
                x.DiaSemana == dia)
            .OrderByDescending(x =>
                x.HoraFin)
            .FirstOrDefault();


    /*
     * Si todavía no hay horarios para ese día,
     * arrancamos a las 09:00.
     *
     * Si ya existen, el nuevo comienza exactamente
     * cuando finaliza el último.
     */
    var horaSugerida =
        ultimoTurno is null
            ? new TimeOnly(9, 0)
            : ultimoTurno.HoraFin;


    PrepararNuevoTurno(
        dia,
        horaSugerida);
}


