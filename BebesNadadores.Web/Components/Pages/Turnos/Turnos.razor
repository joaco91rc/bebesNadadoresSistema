    private static string ObtenerClaseEstado(
        SesionClaseDto sesion)
    {
        if (sesion.Estado ==
            EstadoSesionClase.Cancelada)
        {
            return "session-status cancelled";
        }

        if (sesion.Estado ==
            EstadoSesionClase.Finalizada)
        {
            return "session-status finished";
        }

        if (sesion.Vacantes == 0)
        {
            return "session-status full";
        }

        if (sesion.Vacantes <= 2)
        {
            return "session-status almost";
        }

        return "session-status available";
    }


    private static string ObtenerTextoEstado(
        SesionClaseDto sesion)
    {
        if (sesion.Estado ==
            EstadoSesionClase.Cancelada)
        {
            return "CANCELADA";
        }

        if (sesion.Estado ==
            EstadoSesionClase.Finalizada)
        {
            return "FINALIZADA";
        }

        if (sesion.Vacantes == 0)
        {
            return "COMPLETA";
        }

        if (sesion.Vacantes <= 2)
        {
            return "CASI LLENA";
        }

        return "DISPONIBLE";
    }


    private static string ObtenerClaseSesion(
        SesionClaseDto sesion)
    {
        var clase =
            "session-card";

        if (sesion.Estado ==
            EstadoSesionClase.Cancelada)
        {
            return clase + " cancelled-session";
        }

        if (sesion.Estado ==
            EstadoSesionClase.Finalizada)
        {
            return clase + " finished-session";
        }

        if (sesion.Vacantes == 0)
        {
            return clase + " full-session";
        }

        if (sesion.Vacantes <= 2)
        {
            return clase + " almost-session";
        }

        return clase;
    }


    private static string ObtenerEstiloOcupacion(
        SesionClaseDto sesion)
    {
        if (sesion.Cupo <= 0)
            return "width:0%";

        var porcentaje =
            Math.Clamp(
                sesion.Inscriptos * 100d /
                sesion.Cupo,
                0,
                100);

        return $"width:{porcentaje:0}%";
    }


    private static string ObtenerIniciales(
        string nombre)
    {
        var partes =
            nombre.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);

        if (partes.Length == 0)
            return "?";

        if (partes.Length == 1)
        {
            return partes[0][0]
                .ToString()
                .ToUpperInvariant();
        }

        return string.Concat(
                partes[0][0],
                partes[^1][0])
            .ToUpperInvariant();
    }

