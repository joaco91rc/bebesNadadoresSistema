            Turno =
                sesion.Turno,

            Nivel =
                sesion.Nivel,

            Fecha =
                sesion.Fecha,

            HoraInicio =
                sesion.HoraInicio,

            HoraFin =
                sesion.HoraFin,

            ProfesorIds =
                sesion.Profesores
                    .Select(x =>
                        x.ProfesorId)
                    .ToHashSet(),

            ProfesorPrincipalId =
                sesion.Profesores
                    .FirstOrDefault(x =>
                        x.EsPrincipal)
                    ?.ProfesorId
        };


    _errorEditarClase =
