    private static string ObtenerFechaNullable(
        DateOnly? fecha)
    {
        return fecha.HasValue
            ? fecha.Value.ToString("yyyy-MM-dd")
            : string.Empty;
    }


    private static DateOnly ObtenerLunes(
        DateOnly fecha)
    {
        var diferencia =
            ((int)fecha.DayOfWeek + 6) % 7;

        return fecha.AddDays(
            -diferencia);
    }


    private static bool EsHoy(
        DateOnly fecha)
    {
        return fecha ==
            DateOnly.FromDateTime(
                DateTime.Today);
    }


    private static string ObtenerNombreDia(
        DateOnly fecha)
    {
        return fecha.DayOfWeek switch
        {
            DayOfWeek.Monday => "LUN",
            DayOfWeek.Tuesday => "MAR",
            DayOfWeek.Wednesday => "MIÉ",
            DayOfWeek.Thursday => "JUE",
            DayOfWeek.Friday => "VIE",
            DayOfWeek.Saturday => "SÁB",
            DayOfWeek.Sunday => "DOM",
            _ => ""
        };
    }


    private static string ObtenerNombreDiaEnum(
        DiaSemana dia)
    {
        return dia switch
        {
            DiaSemana.Lunes => "Lunes",
            DiaSemana.Martes => "Martes",
            DiaSemana.Miercoles => "Miércoles",
            DiaSemana.Jueves => "Jueves",
            DiaSemana.Viernes => "Viernes",
            DiaSemana.Sabado => "Sábado",
            DiaSemana.Domingo => "Domingo",
            _ => dia.ToString()
        };
    }


    private static DiaSemana ObtenerDiaSemana(
        DateOnly fecha)
    {
        return fecha.DayOfWeek switch
        {
            DayOfWeek.Monday => DiaSemana.Lunes,
            DayOfWeek.Tuesday => DiaSemana.Martes,
            DayOfWeek.Wednesday => DiaSemana.Miercoles,
            DayOfWeek.Thursday => DiaSemana.Jueves,
            DayOfWeek.Friday => DiaSemana.Viernes,
            DayOfWeek.Saturday => DiaSemana.Sabado,
            DayOfWeek.Sunday => DiaSemana.Domingo,

            _ =>
                DiaSemana.Lunes
        };
    }


