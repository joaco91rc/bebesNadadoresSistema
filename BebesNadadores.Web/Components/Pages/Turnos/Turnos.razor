@code
{

    [Parameter]
[SupplyParameterFromQuery(
    Name = "grilla")]
public bool AbrirGrillaDesdeQuery { get; set; }


[Parameter]
[SupplyParameterFromQuery(
    Name = "ciclo")]

    
public Guid? CicloLectivoDesdeQuery { get; set; }
    private List<CicloLectivoDto> _ciclosLectivos =
    [];

private Guid? _cicloLectivoId;

private bool _mostrarEditarClase;

private bool _guardandoClase;

private string? _errorEditarClase;

private EditarClaseFormModel _claseForm =
    new();

private CicloLectivoDto? _cicloLectivoSeleccionado;

private bool _publicandoCiclo;
    private bool _generandoSesionesFaltantes;

    private bool _mostrarGrillaSemanal;

private bool _cargandoGrilla;

private bool _volverAGrillaDespuesDeGuardar;

private List<TurnoDto> _turnosConfigurados =
    [];
    private bool _mostrarDiasNoLaborables;

private bool _cargandoDias;

private bool _guardandoDia;

private int _anioDiasNoLaborables =
    DateTime.Today.Year;

private Guid? _editandoDiaId;

private string? _errorDia;

private List<DiaNoLaborableDto> _diasNoLaborables =
    [];

private DiaNoLaborableFormModel _diaForm =
    new();
    private DateOnly _inicioSemana;

    private TurnoDto? _turnoAQuitar;

private DateOnly _fechaQuitarTurno =
    DateOnly.FromDateTime(
        DateTime.Today);

private string? _errorQuitarTurno;

private bool _quitandoTurno;

    private List<SesionClaseDto> _agenda = [];

    private IReadOnlyList<NivelTurneraDto> _niveles =
        Array.Empty<NivelTurneraDto>();

    private IReadOnlyList<ProfesorDisponibleDto> _profesores =
        Array.Empty<ProfesorDisponibleDto>();


    private bool _cargando = true;
    private bool _guardando;

    private string? _error;
    private string? _mensaje;
    private string? _errorFormulario;


    private bool _mostrarFormulario;

    private Guid? _editandoId;

    private TurnoFormModel _form =
        new();


    private SesionClaseDetalleDto? _sesionDetalle;

    private bool _mostrarCancelar;

    private string _motivoCancelacion =
        string.Empty;

    private bool _cancelacionGeneraRecupero =
        true;


    private int TotalInscriptos =>
        _agenda.Sum(x => x.Inscriptos);


    private int TotalVacantes =>
        _agenda
            .Where(x =>
                x.Estado ==
                    EstadoSesionClase.Programada)
            .Sum(x => x.Vacantes);


    private int TotalCanceladas =>
        _agenda.Count(x =>
            x.Estado ==
                EstadoSesionClase.Cancelada);


    private IEnumerable<DateOnly> DiasSemana =>
        Enumerable.Range(0, 7)
            .Select(x =>
                _inicioSemana.AddDays(x));


    private string TextoSemana
    {
        get
        {
            var fin =
                _inicioSemana.AddDays(6);

            if (_inicioSemana.Month ==
                fin.Month)
            {
                return
                    $"{_inicioSemana.Day:00} — {fin.Day:00} " +
                    $"{ObtenerNombreMes(fin.Month)} {fin.Year}";
            }

            return
                $"{_inicioSemana.Day:00} {ObtenerNombreMes(_inicioSemana.Month)}" +
                $" — {fin.Day:00} {ObtenerNombreMes(fin.Month)} {fin.Year}";
        }
    }
private sealed class EditarClaseFormModel
{
    public Guid SesionId { get; set; }

    public string Turno { get; set; }
        = string.Empty;

    public string Nivel { get; set; }
        = string.Empty;

    public DateOnly Fecha { get; set; }

    public TimeOnly HoraInicio { get; set; }

    public TimeOnly HoraFin { get; set; }

    public HashSet<Guid> ProfesorIds { get; set; }
        = [];

