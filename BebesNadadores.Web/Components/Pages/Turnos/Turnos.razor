private async Task GuardarDiaNoLaborable()
{
    _errorDia =
        null;

    try
    {
        _guardandoDia =
            true;


        if (string.IsNullOrWhiteSpace(
            _diaForm.Descripcion))
        {
            throw new InvalidOperationException(
                "Ingresá una descripción.");
        }


        TimeOnly? horaDesde =
            null;

        TimeOnly? horaHasta =
            null;


        if (!_diaForm.TodoElDia)
        {
            if (!TimeOnly.TryParse(
                _diaForm.HoraDesde,
                out var desde))
            {
                throw new InvalidOperationException(
                    "Ingresá una hora Desde válida.");
            }


            if (!TimeOnly.TryParse(
                _diaForm.HoraHasta,
                out var hasta))
            {
                throw new InvalidOperationException(
                    "Ingresá una hora Hasta válida.");
            }


            horaDesde =
                desde;

            horaHasta =
                hasta;
        }


        var dto =
            new GuardarDiaNoLaborableDto
            {
                Fecha =
                    _diaForm.Fecha,

                Tipo =
                    _diaForm.Tipo,

                Descripcion =
                    _diaForm.Descripcion,

                TodoElDia =
                    _diaForm.TodoElDia,

                HoraDesde =
                    horaDesde,

                HoraHasta =
                    horaHasta,

                GeneraRecupero =
                    _diaForm.GeneraRecupero,

                RecuperoSinVencimiento =
                    _diaForm.GeneraRecupero &&
                    _diaForm.RecuperoSinVencimiento
            };


        if (_editandoDiaId.HasValue)
        {
            await DiaNoLaborableService
                .ActualizarAsync(
                    _editandoDiaId.Value,
                    dto);

            _mensaje =
                "Feriado o cierre actualizado.";
        }
        else
        {
            await DiaNoLaborableService
                .CrearAsync(dto);

            _mensaje =
                "Feriado o cierre agregado.";
        }


        await CargarDiasNoLaborablesAsync();

        await CargarAgendaAsync();

        NuevoDiaNoLaborable();
    }
    catch (Exception ex)
    {
        _errorDia =
            Errores.Mensaje(ex);
    }
    finally
    {
        _guardandoDia =
            false;
    }
}


