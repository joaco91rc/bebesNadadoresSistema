    private bool PuedeCambiarFechaAplicacion =>
        _editandoId.HasValue
        ||
        _cicloLectivoSeleccionado?.Estado ==
            EstadoCicloLectivo.Publicado;


    private DateOnly ObtenerFechaAplicacionEdicion(
        TurnoDto turno)
    {
        var hoy =
            DateOnly.FromDateTime(
                DateTime.Today);

        if (_cicloLectivoSeleccionado?.Estado ==
            EstadoCicloLectivo.Borrador)
        {
            return turno.VigenteDesde;
        }

        return hoy < turno.VigenteDesde
            ? turno.VigenteDesde
            : hoy;
    }


