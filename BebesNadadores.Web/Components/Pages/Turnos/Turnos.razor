    VigenteHasta =
        _form.VigenteHasta,

    Estado =
        _form.Estado,

    Profesores =
        profesores
});


                _mensaje =
                    "Turno actualizado correctamente.";
            }
            else
            {
                if (!_cicloLectivoId.HasValue)
{
    throw new InvalidOperationException(
        "Seleccioná un ciclo lectivo.");
}
                await TurneraService
    .CrearTurnoAsync(
        new CrearTurnoDto
        {
            CicloLectivoId =
                _cicloLectivoId.Value,

            Nombre =
                _form.Nombre,

            DiaSemana =
                _form.DiaSemana,

            HoraInicio =
                hora,

            DuracionMinutos =
                _form.DuracionMinutos,

            NivelId =
                _form.NivelId,

            Cupo =
                _form.Cupo,


            VigenteDesde =
                _form.VigenteDesde,

            VigenteHasta =
                _form.VigenteHasta,

            Profesores =
                profesores
        });


                _mensaje =
                    "Turno creado correctamente.";
            }


           CerrarFormulario();

await CargarGrillaSemanalAsync();
await CargarAgendaAsync();

if (_volverAGrillaDespuesDeGuardar)
{
    _volverAGrillaDespuesDeGuardar = false;
    _mostrarGrillaSemanal = true;
}
        }
        catch (Exception ex)
        {
            _errorFormulario =
                Errores.Mensaje(ex);
        }
        finally
        {
            _guardando = false;
        }
    }


    private async Task GenerarSesionesFaltantes()
    {
        if (!_cicloLectivoId.HasValue)
        {
            return;
        }

        try
        {
            _generandoSesionesFaltantes =
                true;

            _error =
                null;

            _mensaje =
                null;


            var resultado =
                await TurneraService
                    .GenerarSesionesFaltantesCicloAsync(
                        _cicloLectivoId.Value);


            if (resultado.Generadas == 0)
            {
                _mensaje =
                    "La grilla ya estaba completa. No faltaban clases por generar.";
            }
            else
            {
                _mensaje =
                    $"Se generaron {resultado.Generadas} clases faltantes. " +
                    $"{resultado.YaExistentes} clases ya existían.";
            }


            /*
             * Refrescamos tanto la configuración como
             * la semana visible de la turnera.
             */
            await CargarGrillaSemanalAsync();

            await CargarAgendaAsync();
        }
        catch (Exception ex)
        {
            _error =
                Errores.Mensaje(ex);
        }
        finally
        {
            _generandoSesionesFaltantes =
                false;
        }
    }

    private void CerrarFormulario()
    {
        _mostrarFormulario =
            false;

        _errorFormulario =
            null;
    }


    private async Task AbrirSesion(
        Guid sesionId)
    {
        try
        {
            _error = null;

            _sesionDetalle =
                await TurneraService
                    .ObtenerSesionAsync(
                        sesionId);

            _mostrarCancelar =
                false;

            _motivoCancelacion =
                string.Empty;

            _cancelacionGeneraRecupero =
                true;
        }
        catch (Exception ex)
        {
            _error =
                Errores.Mensaje(ex);
        }
    }


    private void CerrarSesion()
    {
        _sesionDetalle =
            null;

        _mostrarCancelar =
            false;
    }


    private void MostrarCancelarSesion()
    {
        _mostrarCancelar =
            true;
    }


    private async Task CancelarSesion()
    {
        if (_sesionDetalle is null)
            return;

        try
        {
            await TurneraService.CancelarSesionAsync(
                _sesionDetalle.Sesion.Id,
                _motivoCancelacion,
                _cancelacionGeneraRecupero);

            _mensaje =
                _cancelacionGeneraRecupero
                    ? "Clase cancelada. Los bebés reciben su recupero el día de la clase."
                    : "Clase cancelada sin recupero.";

            CerrarSesion();

            await CargarAgendaAsync();
        }
        catch (Exception ex)
        {
            _error =
                Errores.Mensaje(ex);
        }
    }


    private async Task ReactivarSesion()
    {
        if (_sesionDetalle is null)
            return;

        try
        {
            await TurneraService.ReactivarSesionAsync(
                _sesionDetalle.Sesion.Id);

            _mensaje =
                "Clase reactivada.";

            CerrarSesion();

            await CargarAgendaAsync();
        }
        catch (Exception ex)
        {
            _error =
                Errores.Mensaje(ex);
        }
    }


    private async Task FinalizarSesion()
    {
        if (_sesionDetalle is null)
            return;

        try
        {
            await TurneraService.FinalizarSesionAsync(
                _sesionDetalle.Sesion.Id);

            _mensaje =
                "Clase finalizada.";

            CerrarSesion();

            await CargarAgendaAsync();
        }
        catch (Exception ex)
        {
            _error =
                Errores.Mensaje(ex);
        }
    }


    private void CambiarNivel(
    ChangeEventArgs e)
{
    if (!Guid.TryParse(
        e.Value?.ToString(),
        out var nivelId))
    {
        _form.NivelId =
            Guid.Empty;

        _form.Nombre =
            string.Empty;

        return;
    }


    _form.NivelId =
        nivelId;


    var nivel =
        _niveles.FirstOrDefault(x =>
            x.Id == nivelId);


    if (nivel is null)
        return;


    /*
     * En un turno nuevo usamos los valores
     * predeterminados definidos en el nivel.
     *
     * En edición no pisamos la configuración histórica.
     */
    if (!_editandoId.HasValue)
    {
        _form.Nombre =
            nivel.Nombre;

        _form.DuracionMinutos =
            nivel.DuracionMinutos;

        _form.Cupo =
            nivel.CupoPredeterminado;
    }
}


    private void CambiarProfesor(
        Guid profesorId,
        bool seleccionado)
    {
        if (seleccionado)
        {
            _form.ProfesorIds.Add(
                profesorId);

            if (!_form
                .ProfesorPrincipalId
                .HasValue)
            {
                _form.ProfesorPrincipalId =
                    profesorId;
            }
        }
        else
        {
            _form.ProfesorIds.Remove(
                profesorId);

            if (_form.ProfesorPrincipalId ==
                profesorId)
            {
                _form.ProfesorPrincipalId =
                    _form.ProfesorIds
                        .FirstOrDefault();

                if (_form.ProfesorPrincipalId ==
                    Guid.Empty)
                {
                    _form.ProfesorPrincipalId =
                        null;
                }
            }
        }
    }


