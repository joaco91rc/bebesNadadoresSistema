@page "/turnos"

@attribute [Authorize(Policy = PoliticasSistema.GestionAdministrativa)]

@using BebesNadadores.Application.Turnera
@using BebesNadadores.Application.Turnera.Dtos
@using BebesNadadores.Domain.Enums
@using BebesNadadores.Application.CiclosLectivos
@using BebesNadadores.Application.CiclosLectivos.Dtos

@inject ICicloLectivoService CicloLectivoService
@inject ITurneraService TurneraService
@inject NavigationManager Navigation
@inject IDiaNoLaborableService DiaNoLaborableService

<PageTitle>Turnos | Bebés Nadadores</PageTitle>


<div class="turnera-page">

    @* =========================================================
       HEADER
       ========================================================= *@

    <section class="turnera-header">

        <div class="turnera-title">

            <span class="turnera-eyebrow">
                ORGANIZACIÓN DE CLASES
            </span>

            <h1>
                Turnera
            </h1>

            <p>
                Gestioná horarios, cupos, niveles,
                profesores y clases programadas.
            </p>

        </div>


       <div class="turnera-header-actions">

        <button type="button"
        class="secondary-action"
        @onclick="IrAProfesores">

    <MudIcon Icon="@Icons.Material.Filled.Sports"
             Size="Size.Small" />

    Profesores

</button>
<button type="button"
        class="secondary-action"
        @onclick="IrANiveles">

    <MudIcon Icon="@Icons.Material.Filled.Layers"
             Size="Size.Small" />

    Niveles

</button>

    <button type="button"
            class="secondary-action"
            @onclick="IrAHoy">

        <MudIcon Icon="@Icons.Material.Filled.Today"
                 Size="Size.Small" />

        Hoy

    </button>


    <button type="button"
            class="secondary-action"
            @onclick="AbrirGrillaSemanal">

        <MudIcon Icon="@Icons.Material.Filled.ViewWeek"
                 Size="Size.Small" />

        Configurar grilla semanal

    </button>


    <button type="button"
            class="secondary-action"
            @onclick="AbrirDiasNoLaborables">

        <MudIcon Icon="@Icons.Material.Filled.EventBusy"
                 Size="Size.Small" />

        Feriados y cierres

    </button>


    <button type="button"
            class="primary-action"
            @onclick="AbrirNuevoTurno">

        <MudIcon Icon="@Icons.Material.Filled.Add"
                 Size="Size.Small" />

        Nuevo turno

    </button>

</div>

    </section>


    @* =========================================================
       ERROR / MENSAJE
       ========================================================= *@

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="message-box message-error">

            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline"
                     Size="Size.Small" />

            <span>
                @_error
            </span>

            <button type="button"
                    @onclick="() => _error = null">

                <MudIcon Icon="@Icons.Material.Filled.Close"
                         Size="Size.Small" />

            </button>

        </div>
    }


    @if (!string.IsNullOrWhiteSpace(_mensaje))
    {
        <div class="message-box message-success">

            <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                     Size="Size.Small" />

            <span>
                @_mensaje
            </span>

        </div>
    }


    @* =========================================================
       KPIs
       ========================================================= *@

    <section class="turnera-stats">

        <article class="turnera-stat">

            <div class="stat-icon blue">

                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" />

            </div>

            <div>

                <span>
                    Clases semana
                </span>

                <strong>
                    @_agenda.Count
                </strong>

            </div>

        </article>


        <article class="turnera-stat">

            <div class="stat-icon cyan">

                <MudIcon Icon="@Icons.Material.Filled.Groups" />

            </div>

            <div>

                <span>
                    Alumnos previstos
                </span>

                <strong>
                    @TotalInscriptos
                </strong>

            </div>

        </article>


        <article class="turnera-stat">

            <div class="stat-icon green">

                <MudIcon Icon="@Icons.Material.Filled.EventAvailable" />

            </div>

            <div>

                <span>
                    Vacantes
                </span>

                <strong>
                    @TotalVacantes
                </strong>

            </div>

        </article>


        <article class="turnera-stat">

            <div class="stat-icon red">

                <MudIcon Icon="@Icons.Material.Filled.EventBusy" />

            </div>

            <div>

                <span>
                    Canceladas
                </span>

                <strong>
                    @TotalCanceladas
                </strong>

            </div>

        </article>

    </section>


    @* =========================================================
       NAVEGACIÓN SEMANA
       ========================================================= *@

    <section class="week-toolbar">

        <div class="week-navigation">

            <button type="button"
                    class="nav-week-button"
                    title="Semana anterior"
                    @onclick="SemanaAnterior">

                <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" />

            </button>


            <div class="week-title">

                <span>
                    SEMANA
                </span>

                <strong>
                    @TextoSemana
                </strong>

            </div>


            <button type="button"
                    class="nav-week-button"
                    title="Semana siguiente"
                    @onclick="SemanaSiguiente">

                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />

            </button>

        </div>


        <div class="week-legend">

            <span>
                <i class="legend-dot available"></i>
                Disponible
            </span>

            <span>
                <i class="legend-dot almost"></i>
                Casi completo
            </span>

            <span>
                <i class="legend-dot full"></i>
                Completo
            </span>

            <span>
                <i class="legend-dot cancelled"></i>
                Cancelado
            </span>

        </div>

    </section>


    @* =========================================================
       CALENDARIO
       ========================================================= *@

    @if (_cargando)
    {
        <div class="turnera-loading">

            <MudProgressCircular Indeterminate="true"
                                 Size="Size.Large" />

            <span>
                Cargando turnera...
            </span>

        </div>
    }
    else
    {
        <section class="week-calendar">

            @foreach (var dia in DiasSemana)
            {
                var sesiones =
                    ObtenerSesionesDia(dia);

                <article class="day-column @(EsHoy(dia) ? "today" : "")">

                    <header class="day-header">

                        <span>
                            @ObtenerNombreDia(dia)
                        </span>

                        <strong>
                            @dia.Day
                        </strong>

                        @if (EsHoy(dia))
                        {
                            <small>
                                HOY
                            </small>
                        }

                    </header>


                    <div class="day-content">

                        @if (sesiones.Count == 0)
                        {
                            <div class="empty-day">

                                <MudIcon Icon="@Icons.Material.Filled.WaterDrop"
                                         Size="Size.Small" />

                                <span>
                                    Sin clases
                                </span>

                            </div>
                        }
                        else
                        {
                            @foreach (var sesion in sesiones)
                            {
                                <button type="button"
                                        class="@ObtenerClaseSesion(sesion)"
                                        @onclick="() => AbrirSesion(sesion.Id)">

                                    <div class="session-top">

                                        <strong>
                                            @sesion.HoraInicio.ToString("HH:mm")
                                        </strong>

                                        <span class="@ObtenerClaseEstado(sesion)">
                                            @ObtenerTextoEstado(sesion)
                                        </span>

                                    </div>


                                    <div class="session-name">
                                        @sesion.Turno
                                    </div>


                                    <div class="session-level">

                                        <MudIcon Icon="@Icons.Material.Filled.Pool"
                                                 Size="Size.Small" />

                                        @sesion.Nivel

                                    </div>


                                   @if (sesion.Profesores.Count > 0)
{
    <div class="session-teachers">

        <MudIcon Icon="@Icons.Material.Filled.Sports"
                 Size="Size.Small" />

        <div class="session-teachers-list">

            @foreach (var profesor in sesion.Profesores)
            {
                <span>
                    @profesor.NombreCompleto
                </span>
            }

        </div>

    </div>
}


                                    <div class="session-footer">

                                        <div class="capacity">

                                            <MudIcon Icon="@Icons.Material.Filled.Groups"
                                                     Size="Size.Small" />

                                            <strong>
                                                @sesion.Inscriptos
                                            </strong>

                                            <span>
                                                / @sesion.Cupo
                                            </span>

                                        </div>


                                        @if (sesion.Estado ==
                                            EstadoSesionClase.Programada)
                                        {
                                            <span class="vacancy-text">

                                                @if (sesion.Vacantes == 0)
                                                {
                                                    <text>
                                                        Completo
                                                    </text>
                                                }
                                                else
                                                {
                                                    <text>
                                                        @sesion.Vacantes libres
                                                    </text>
                                                }

                                            </span>
                                        }

                                    </div>


                                    <div class="capacity-track">

                                        <div class="capacity-value"
                                             style="@ObtenerEstiloOcupacion(sesion)">
                                        </div>

                                    </div>

                                </button>
                            }
                        }

                    </div>

                </article>
            }

        </section>
    }

</div>


@* =============================================================
   MODAL NUEVO / EDITAR TURNO
   ============================================================= *@

@if (_mostrarFormulario)
{
    <div class="modal-backdrop"
         @onclick="CerrarFormulario">

        <div class="turn-modal"
             @onclick:stopPropagation="true">

            <div class="modal-header">

                <div>
                    <span class="modal-eyebrow">
                        @(_editandoId.HasValue
                            ? "EDITAR CONFIGURACIÓN"
                            : "NUEVA CLASE RECURRENTE")
                    </span>

                    <h2>
                        @(_editandoId.HasValue
                            ? "Editar turno"
                            : "Crear turno")
                    </h2>
                </div>

                <button type="button"
                        class="modal-close"
                        @onclick="CerrarFormulario">
                    <MudIcon Icon="@Icons.Material.Filled.Close" />
                </button>

            </div>

            <div class="form-grid turn-form-grid">

                @* FILA 1: NIVEL + NOMBRE *@
                <div class="form-field">
                    <label>Nivel</label>

                    <select value="@_form.NivelId"
                            @onchange="CambiarNivel">
                        <option value="">Seleccionar nivel</option>

                        @foreach (var nivel in _niveles)
                        {
                            <option value="@nivel.Id">
                                @nivel.Nombre
                            </option>
                        }
                    </select>

                    <small class="field-help">
                        Completa nombre, duración y cupo sugerido.
                    </small>
                </div>

                <div class="form-field span-2">
                    <label>Nombre del turno</label>

                    <input type="text"
                           maxlength="150"
                           placeholder="Se completa con el nivel seleccionado"
                           @bind="_form.Nombre" />
                </div>

                @* FILA 2: DÍA + HORA + DURACIÓN *@
                <div class="form-field">
                    <label>Día</label>

                    <select @bind="_form.DiaSemana">
                        @foreach (var dia in Enum.GetValues<DiaSemana>())
                        {
                            <option value="@dia">
                                @ObtenerNombreDiaEnum(dia)
                            </option>
                        }
                    </select>
                </div>

                <div class="form-field">
                    <label>Hora de inicio</label>

                    <input type="time"
                           value="@_form.HoraInicioTexto"
                           @onchange="CambiarHora" />
                </div>

                <div class="form-field">
                    <label>Duración</label>

                    <div class="input-with-suffix">
                        <input type="number"
                               min="1"
                               max="240"
                               @bind="_form.DuracionMinutos" />

                        <span>min</span>
                    </div>
                </div>

                @* FILA 3: CUPO + APLICA DESDE + VIGENTE HASTA *@
                <div class="form-field">
                    <label>Cupo</label>

                    <input type="number"
                           min="1"
                           max="100"
                           @bind="_form.Cupo" />
                </div>

                <div class="form-field">
                    <label>
                        @(PuedeCambiarFechaAplicacion
                            ? "Aplicar desde"
                            : "Vigente desde")
                    </label>

                    <input type="date"
                           value="@(_form.VigenteDesde.ToString("yyyy-MM-dd"))"
                           disabled="@(!PuedeCambiarFechaAplicacion)"
                           @onchange="CambiarVigenteDesde" />

                    @if (PuedeCambiarFechaAplicacion)
                    {
                        <small class="field-help">
                            Las clases anteriores conservan su configuración.
                        </small>
                    }
                </div>

                <div class="form-field">
                    <label>Vigente hasta</label>

                    <input type="date"
                           value="@ObtenerFechaNullable(_form.VigenteHasta)"
                           disabled="@(!_editandoId.HasValue)"
                           @onchange="CambiarVigenteHasta" />
                </div>

            </div>

            <div class="teachers-section">

                <div class="section-heading">
                    <div>
                        <span>EQUIPO</span>
                        <h3>Profesores</h3>
                    </div>

                    @if (NivelSeleccionado is not null)
                    {
                        <small>
                            Requiere entre
                            @NivelSeleccionado.ProfesoresMinimos y
                            @NivelSeleccionado.ProfesoresMaximos
                        </small>
                    }
                </div>

                <div class="teachers-grid">
                    @foreach (var profesor in _profesores)
                    {
                        var seleccionado =
                            _form.ProfesorIds.Contains(profesor.Id);

                        <div class="teacher-option @(seleccionado ? "selected" : "")">

                            <label>
                                <input type="checkbox"
                                       checked="@seleccionado"
                                       @onchange="e => CambiarProfesor(
                                           profesor.Id,
                                           (bool)e.Value!)" />

                                <span class="teacher-avatar">
                                    @ObtenerIniciales(profesor.NombreCompleto)
                                </span>

                                <span class="teacher-name">
                                    @profesor.NombreCompleto
                                </span>
                            </label>

                            @if (seleccionado)
                            {
                                <button type="button"
                                        class="principal-button @(_form.ProfesorPrincipalId == profesor.Id ? "active" : "")"
                                        title="Profesor principal"
                                        @onclick="() => _form.ProfesorPrincipalId = profesor.Id">
                                    <MudIcon Icon="@Icons.Material.Filled.Star"
                                             Size="Size.Small" />
                                </button>
                            }

                        </div>
                    }
                </div>

            </div>

            @if (!string.IsNullOrWhiteSpace(_errorFormulario))
            {
                <div class="form-error">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline"
                             Size="Size.Small" />

                    @_errorFormulario
                </div>
            }

            <div class="modal-actions">
                <button type="button"
                        class="secondary-action"
                        @onclick="CerrarFormulario">
                    Cancelar
                </button>

                <button type="button"
                        class="primary-action"
                        disabled="@_guardando"
                        @onclick="GuardarTurno">
                    @if (_guardando)
                    {
                        <MudProgressCircular Indeterminate="true"
                                             Size="Size.Small" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Save"
                                 Size="Size.Small" />
                    }

                    @(_editandoId.HasValue
                        ? "Guardar cambios"
                        : "Crear turno")
                </button>
            </div>

        </div>

    </div>
}


@* =============================================================
   MODAL SESIÓN
   ============================================================= *@

@if (_sesionDetalle is not null)
{
    <div class="modal-backdrop"
         @onclick="CerrarSesion">

        <div class="session-modal"
             @onclick:stopPropagation="true">

            <div class="modal-header">

                <div>

                    <span class="modal-eyebrow">
                        CLASE PROGRAMADA
                    </span>

                    <h2>
                        @_sesionDetalle.Sesion.Turno
                    </h2>

                </div>


                <button type="button"
                        class="modal-close"
                        @onclick="CerrarSesion">

                    <MudIcon Icon="@Icons.Material.Filled.Close" />

                </button>

            </div>


            <div class="session-detail-head">

                <div>

                    <span>
                        Fecha
                    </span>

                    <strong>
                        @_sesionDetalle.Sesion.Fecha.ToString("dd/MM/yyyy")
                    </strong>

                </div>


                <div>

                    <span>
                        Horario
                    </span>

                    <strong>
                        @_sesionDetalle.Sesion.HoraInicio.ToString("HH:mm")
                        -
                        @_sesionDetalle.Sesion.HoraFin.ToString("HH:mm")
                    </strong>

                </div>


                <div>

                    <span>
                        Nivel
                    </span>

                    <strong>
                        @_sesionDetalle.Sesion.Nivel
                    </strong>

                </div>


                <div>

                    <span>
                        Ocupación
                    </span>

                    <strong>
                        @_sesionDetalle.Sesion.Inscriptos
                        /
                        @_sesionDetalle.Sesion.Cupo
                    </strong>

                </div>

            </div>


            <div class="session-modal-actions">

                @if (_sesionDetalle.Sesion.Estado ==
                    EstadoSesionClase.Programada)
                {
                    <button type="button"
                            class="danger-action"
                            @onclick="MostrarCancelarSesion">

                        <MudIcon Icon="@Icons.Material.Filled.EventBusy"
                                 Size="Size.Small" />

                        Cancelar clase

                    </button>


                    <button type="button"
                            class="secondary-action"
                            @onclick="FinalizarSesion">

                        <MudIcon Icon="@Icons.Material.Filled.TaskAlt"
                                 Size="Size.Small" />

                        Finalizar

                    </button>
                }


                @if (_sesionDetalle.Sesion.Estado ==
                    EstadoSesionClase.Cancelada)
                {
                    <button type="button"
                            class="primary-action"
                            @onclick="ReactivarSesion">

                        <MudIcon Icon="@Icons.Material.Filled.Restore"
                                 Size="Size.Small" />

                        Reactivar clase

                    </button>
                }


               <button type="button"
        class="secondary-action"
        @onclick="EditarClaseDesdeSesion">

    <MudIcon Icon="@Icons.Material.Filled.Edit"
             Size="Size.Small" />

    Editar clase

</button>

            </div>


            @if (_mostrarCancelar)
            {
                <div class="cancel-box">

                    <label>
                        Motivo de cancelación
                    </label>

                    <textarea rows="3"
                              placeholder="Ej. mantenimiento extraordinario"
                              @bind="_motivoCancelacion">
                    </textarea>


                    <label class="cancel-recupero">

                        <input type="checkbox"
                               @bind="_cancelacionGeneraRecupero" />

                        <span>
                            <strong>Generar recupero a los bebés de esta clase</strong>
                            <small>
                                @(_cancelacionGeneraRecupero
                                    ? "Cada bebé recibe un recupero cuando llega el día de la clase."
                                    : "Los bebés no reciben recupero (por ejemplo, si la clase se reprograma).")
                                Los recuperos reservados para esta clase se liberan igual.
                            </small>
                        </span>

                    </label>


                    <button type="button"
                            class="danger-action"
                            @onclick="CancelarSesion">

                        Confirmar cancelación

                    </button>

                </div>
            }


            <div class="students-heading">

                <div>

                    <span>
                        ASISTENCIA
                    </span>

                    <h3>
                        Alumnos esperados
                    </h3>

                </div>


                <strong>
                    @_sesionDetalle.Bebes.Count
                </strong>

            </div>


            <div class="session-students">

                @if (_sesionDetalle.Bebes.Count == 0)
                {
                    <div class="empty-students">

                        Todavía no hay alumnos asignados
                        a esta clase.

                    </div>
                }
                else
                {
                    @foreach (var bebe in _sesionDetalle.Bebes)
                    {
                        <div class="session-student">

                            <div class="student-avatar">
                                @ObtenerIniciales(bebe.NombreCompleto)
                            </div>


                            <div class="student-name">

                                <strong>
                                    @bebe.NombreCompleto
                                </strong>

                                <span>
                                    @(bebe.EsRecupero
                                        ? "Asiste como recupero"
                                        : "Inscripción regular")
                                </span>

                            </div>


                            @if (bebe.EsRecupero)
                            {
                                <span class="recovery-badge">
                                    RECUPERO
                                </span>
                            }

                        </div>
                    }
                }

            </div>

        </div>

    </div>
}

@if (_mostrarEditarClase)
{
    <div class="modal-backdrop"
         @onclick="() => _mostrarEditarClase = false">

        <div class="turn-modal"
             @onclick:stopPropagation="true">

            <div class="modal-header">

                <div>

                    <span class="modal-eyebrow">
                        EDICIÓN PUNTUAL
                    </span>

                    <h2>
                        Editar clase
                    </h2>

                </div>


                <button type="button"
                        class="modal-close"
                        @onclick="() => _mostrarEditarClase = false">

                    <MudIcon Icon="@Icons.Material.Filled.Close" />

                </button>

            </div>


            <div class="session-detail-head">

                <div>

                    <span>
                        Fecha
                    </span>

                    <strong>
                        @(_claseForm.Fecha.ToString("dd/MM/yyyy"))
                    </strong>

                </div>


                <div>

                    <span>
                        Horario
                    </span>

                    <strong>
                        @(_claseForm.HoraInicio.ToString("HH:mm"))
                        —
                        @(_claseForm.HoraFin.ToString("HH:mm"))
                    </strong>

                </div>


                <div>

                    <span>
                        Nivel
                    </span>

                    <strong>
                        @_claseForm.Nivel
                    </strong>

                </div>


                <div>

                    <span>
                        Turno base
                    </span>

                    <strong>
                        @_claseForm.Turno
                    </strong>

                </div>

            </div>


            <div class="teachers-section">

                <div class="section-heading">

                    <div>

                        <span>
                            ESTA CLASE SOLAMENTE
                        </span>

                        <h3>
                            Profesores
                        </h3>

                    </div>

                </div>


                <div class="teachers-grid">

                    @foreach (var profesor in _profesores)
                    {
                        var seleccionado =
                            _claseForm
                                .ProfesorIds
                                .Contains(
                                    profesor.Id);


                        <div class="teacher-option @(seleccionado ? "selected" : "")">

                            <label>

                                <input type="checkbox"
                                       checked="@seleccionado"
                                       @onchange="e => CambiarProfesorClase(
                                           profesor.Id,
                                           (bool)e.Value!)" />


                                <span class="teacher-avatar">
                                    @ObtenerIniciales(
                                        profesor.NombreCompleto)
                                </span>


                                <span class="teacher-name">
                                    @profesor.NombreCompleto
                                </span>

                            </label>


                            @if (seleccionado)
                            {
                                <button type="button"
                                        class="principal-button @(_claseForm.ProfesorPrincipalId == profesor.Id ? "active" : "")"
                                        title="Profesor principal"
                                        @onclick="() => _claseForm.ProfesorPrincipalId = profesor.Id">

                                    <MudIcon Icon="@Icons.Material.Filled.Star"
                                             Size="Size.Small" />

                                </button>
                            }

                        </div>
                    }

                </div>

            </div>


            <div class="weekly-grid-info">

                <MudIcon Icon="@Icons.Material.Filled.Info"
                         Size="Size.Small" />

                <span>
                    Este cambio afecta únicamente esta clase.
                    La grilla semanal y las demás fechas no se modificarán.
                </span>

            </div>


            @if (!string.IsNullOrWhiteSpace(
                _errorEditarClase))
            {
                <div class="form-error">

                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline"
                             Size="Size.Small" />

