private void PrepararNuevoTurno(
    DiaSemana dia,
    TimeOnly? horaInicio = null)
{
    _editandoId =
        null;

    _errorFormulario =
        null;


    var hoy =
        DateOnly.FromDateTime(
            DateTime.Today);

    var ciclo =
        _cicloLectivoSeleccionado;


    DateOnly vigenteDesde;

    if (ciclo is null)
    {
        vigenteDesde =
            hoy;
    }
    else if (ciclo.Estado ==
        EstadoCicloLectivo.Borrador)
    {
        // Mientras el ciclo está en borrador, el horario
        // pertenece al ciclo completo.
        vigenteDesde =
            ciclo.FechaInicio;
    }
    else
    {
        // Si el ciclo ya está publicado, un horario nuevo
        // sólo puede impactar desde hoy hacia adelante.
        vigenteDesde =
            hoy < ciclo.FechaInicio
                ? ciclo.FechaInicio
                : hoy;
    }


    _form =
        new TurnoFormModel
        {
            DiaSemana =
                dia,

            HoraInicioTexto =
                (horaInicio
                    ?? new TimeOnly(9, 0))
                .ToString("HH:mm"),

            DuracionMinutos =
                30,

            Cupo =
                8,

            VigenteDesde =
                vigenteDesde,

            VigenteHasta =
                ciclo?.FechaFin,

            Estado =
                EstadoTurno.Activo
        };


    _mostrarFormulario =
        true;
}

   


