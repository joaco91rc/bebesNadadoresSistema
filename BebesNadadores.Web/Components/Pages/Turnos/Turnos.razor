private void CambiarProfesorClase(
    Guid profesorId,
    bool seleccionado)
{
    if (seleccionado)
    {
        _claseForm.ProfesorIds.Add(
            profesorId);


        if (!_claseForm
            .ProfesorPrincipalId
            .HasValue)
        {
            _claseForm.ProfesorPrincipalId =
                profesorId;
        }
    }
    else
    {
        _claseForm.ProfesorIds.Remove(
            profesorId);


        if (_claseForm
            .ProfesorPrincipalId ==
            profesorId)
        {
            var primero =
                _claseForm
                    .ProfesorIds
                    .FirstOrDefault();


            _claseForm.ProfesorPrincipalId =
                primero == Guid.Empty
                    ? null
                    : primero;
        }
    }
}

private async Task GuardarClasePuntual()
{
    _errorEditarClase =
        null;


    try
    {
        _guardandoClase =
            true;


        if (_claseForm
            .ProfesorIds.Count == 0)
        {
            throw new InvalidOperationException(
                "Seleccioná al menos un profesor.");
        }


        if (!_claseForm
            .ProfesorPrincipalId
            .HasValue)
        {
            throw new InvalidOperationException(
                "Seleccioná el profesor principal.");
        }


        var profesores =
            _claseForm
                .ProfesorIds
                .Select(x =>
                    new ProfesorTurnoInputDto(
                        x,
                        x ==
                            _claseForm
                                .ProfesorPrincipalId))
                .ToList();


        var sesionId =
            _claseForm.SesionId;


        await TurneraService
            .ActualizarSesionClaseAsync(
                sesionId,
                new ActualizarSesionClaseDto
                {
                    Profesores =
                        profesores
                });


        _mostrarEditarClase =
            false;


        _mensaje =
            "La clase fue actualizada sin modificar la grilla recurrente.";


        await CargarAgendaAsync();


        /*
         * Volvemos a abrir el detalle para que se vea
         * inmediatamente el nuevo profesor.
         */
        await AbrirSesion(
            sesionId);
    }
    catch (Exception ex)
    {
        _errorEditarClase =
            Errores.Mensaje(ex);
    }
    finally
    {
        _guardandoClase =
            false;
    }
}
