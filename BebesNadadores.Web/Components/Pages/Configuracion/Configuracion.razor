@page "/configuracion"

@attribute [Authorize(Policy = PoliticasSistema.SoloAdministrador)]

@using BebesNadadores.Application.Configuracion.Dtos
@using BebesNadadores.Infrastructure.Identity
@using BebesNadadores.Web.Components.Shared.Utils

<PageTitle>Configuración | Bebés Nadadores</PageTitle>

<div class="settings-page">

    <section class="settings-header">

        <div class="settings-header-copy">

            <span class="settings-eyebrow">
                ADMINISTRACIÓN DEL SISTEMA
            </span>

            <h1>Configuración</h1>

            <p>
                Administrá usuarios, planes, tarifas y parámetros generales
                de Bebés Nadadores desde un único lugar.
            </p>

        </div>

        <button type="button"
                class="settings-refresh"
                disabled="@_cargando"
                @onclick="ActualizarAsync">

            <MudIcon Icon="@Icons.Material.Filled.Refresh"
                     Size="Size.Small" />

            Actualizar

        </button>

    </section>


    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="settings-message error">

            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline"
                     Size="Size.Small" />

            <span>@_error</span>

            <button type="button"
                    @onclick="() => _error = null">
                <MudIcon Icon="@Icons.Material.Filled.Close"
                         Size="Size.Small" />
            </button>

        </div>
    }


    @if (!string.IsNullOrWhiteSpace(_mensaje))
    {
        <div class="settings-message success">

            <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                     Size="Size.Small" />

            <span>@_mensaje</span>

            <button type="button"
                    @onclick="() => _mensaje = null">
                <MudIcon Icon="@Icons.Material.Filled.Close"
                         Size="Size.Small" />
            </button>

        </div>
    }


    @if (_cargando)
    {
        <section class="settings-loading">

            <div class="settings-spinner"></div>

            <strong>Cargando configuración...</strong>

            <span>
                Estamos obteniendo usuarios, planes y parámetros del sistema.
            </span>

        </section>
    }
    else
    {
        @* =====================================================
           CENTRO DE CONFIGURACIÓN
           ===================================================== *@

        <section class="settings-hub">

            <button type="button"
                    class="settings-card users @(_seccion == SeccionConfiguracion.Usuarios ? "active" : null)"
                    @onclick="() => SeleccionarSeccion(SeccionConfiguracion.Usuarios)">

                <span class="settings-card-icon">
                    <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" />
                </span>

                <span class="settings-card-body">
                    <small>SEGURIDAD</small>
                    <strong>Usuarios y permisos</strong>
                    <span>
                        Altas, roles, estado y contraseñas de acceso.
                    </span>
                </span>

                <span class="settings-card-value">
                    <strong>@UsuariosActivos</strong>
                    <small>activos</small>
                </span>

                <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                         Size="Size.Small"
                         Class="settings-card-arrow" />

            </button>


            <button type="button"
                    class="settings-card plans @(_seccion == SeccionConfiguracion.Planes ? "active" : null)"
                    @onclick="() => SeleccionarSeccion(SeccionConfiguracion.Planes)">

                <span class="settings-card-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Payments" />
                </span>

                <span class="settings-card-body">
                    <small>COMERCIAL</small>
                    <strong>Planes y tarifas</strong>
                    <span>
                        Frecuencia semanal, precios e historial de vigencias.
                    </span>
                </span>

                <span class="settings-card-value">
                    <strong>@PlanesActivos</strong>
                    <small>planes</small>
                </span>

                <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                         Size="Size.Small"
                         Class="settings-card-arrow" />

            </button>


            <button type="button"
                    class="settings-card rules @(_seccion == SeccionConfiguracion.Reglas ? "active" : null)"
                    @onclick="() => SeleccionarSeccion(SeccionConfiguracion.Reglas)">

                <span class="settings-card-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Tune" />
                </span>

                <span class="settings-card-body">
                    <small>PARÁMETROS</small>
                    <strong>Reglas del sistema</strong>
                    <span>
                        Recuperos, aptos médicos, cuotas y edad máxima.
                    </span>
                </span>

                <span class="settings-card-value compact">
                    <strong>@(_configuracion?.DiasVigenciaRecupero ?? 45)</strong>
                    <small>días rec.</small>
                </span>

                <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                         Size="Size.Small"
                         Class="settings-card-arrow" />

            </button>


            <button type="button"
                    class="settings-card institution @(_seccion == SeccionConfiguracion.Institucion ? "active" : null)"
                    @onclick="() => SeleccionarSeccion(SeccionConfiguracion.Institucion)">

                <span class="settings-card-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Business" />
                </span>

                <span class="settings-card-body">
                    <small>INSTITUCIÓN</small>
                    <strong>Datos generales</strong>
                    <span>
                        Identidad, WhatsApp, dirección y logo del natatorio.
                    </span>
                </span>

                <span class="settings-card-value institution-value">
                    <MudIcon Icon="@Icons.Material.Filled.Pool"
                             Size="Size.Small" />
                </span>

                <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                         Size="Size.Small"
                         Class="settings-card-arrow" />

            </button>

        </section>


        @if (_seccion != SeccionConfiguracion.Resumen)
        {
            <button type="button"
                    class="back-to-settings"
                    @onclick="() => SeleccionarSeccion(SeccionConfiguracion.Resumen)">

                <MudIcon Icon="@Icons.Material.Filled.ArrowBack"
                         Size="Size.Small" />

                Volver al centro de configuración

            </button>
        }


        @* =====================================================
           USUARIOS
           ===================================================== *@

        @if (_seccion == SeccionConfiguracion.Usuarios)
        {
            <section class="settings-panel">

                <header class="panel-header">

                    <div>
                        <span class="panel-eyebrow">SEGURIDAD Y ACCESOS</span>
                        <h2>Usuarios y permisos</h2>
                        <p>
                            Cada persona debe tener su propia cuenta. Los roles
                            determinan qué módulos puede utilizar.
                        </p>
                    </div>

                    <button type="button"
                            class="primary-action"
                            @onclick="NuevoUsuario">

                        <MudIcon Icon="@Icons.Material.Filled.PersonAdd"
                                 Size="Size.Small" />

                        Nuevo usuario

                    </button>

                </header>


                <div class="role-guide">

                    <div>
                        <strong>Administrador</strong>
                        <span>Acceso total y configuración.</span>
                    </div>

                    <div>
                        <strong>Administrativa</strong>
                        <span>Operatoria diaria y gestión.</span>
                    </div>

                    <div>
                        <strong>Médica</strong>
                        <span>Únicamente aptos médicos.</span>
                    </div>

                    <div>
                        <strong>Profesor</strong>
                        <span>Funciones docentes vinculadas a su ficha.</span>
                    </div>

                    <div>
                        <strong>Solo lectura</strong>
                        <span>Consulta sin gestión sensible.</span>
                    </div>

                </div>


                <div class="settings-table-wrap">

                    <table class="settings-table users-table">

                        <thead>
                            <tr>
                                <th>Usuario</th>
                                <th>Rol</th>
                                <th>Vinculación</th>
                                <th>Estado</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var usuario in _usuarios)
                            {
                                <tr>

                                    <td>
                                        <div class="user-cell">

                                            <span class="user-avatar">
                                                @ObtenerIniciales(usuario.NombreCompleto)
                                            </span>

                                            <span>
                                                <strong>@usuario.NombreCompleto</strong>
                                                <small>@usuario.Email</small>
                                            </span>

                                            @if (usuario.Id == _usuarioActualId)
                                            {
                                                <span class="self-badge">VOS</span>
                                            }

                                        </div>
                                    </td>

                                    <td>
                                        <span class="role-badge @usuario.Rol.ToLowerInvariant()">
                                            @ObtenerNombreRol(usuario.Rol)
                                        </span>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(usuario.ProfesorVinculado))
                                        {
                                            <span class="professor-link">
                                                <MudIcon Icon="@Icons.Material.Filled.Sports"
                                                         Size="Size.Small" />
                                                @usuario.ProfesorVinculado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="muted-value">—</span>
                                        }
                                    </td>

                                    <td>
                                        <span class="status-badge @(usuario.Activo ? "on" : "off")">
                                            <span></span>
                                            @(usuario.Activo ? "Activo" : "Inactivo")
                                        </span>
                                    </td>

                                    <td>
                                        <div class="row-actions">

                                            <button type="button"
                                                    title="Editar usuario"
                                                    @onclick="() => EditarUsuario(usuario)">
                                                <MudIcon Icon="@Icons.Material.Filled.Edit"
                                                         Size="Size.Small" />
                                            </button>

                                            <button type="button"
                                                    title="Cambiar contraseña"
                                                    @onclick="() => AbrirPassword(usuario)">
                                                <MudIcon Icon="@Icons.Material.Filled.LockReset"
                                                         Size="Size.Small" />
                                            </button>

                                        </div>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </section>
        }


        @* =====================================================
           PLANES Y TARIFAS
           ===================================================== *@

        @if (_seccion == SeccionConfiguracion.Planes)
        {
            <section class="settings-panel">

                <header class="panel-header">

                    <div>
                        <span class="panel-eyebrow">PLANES Y VALORES</span>
                        <h2>Planes y tarifas mensuales</h2>
                        <p>
                            Los cambios de precio generan una nueva vigencia y
                            mantienen el historial utilizado por las cuotas anteriores.
                        </p>
                    </div>

                    <button type="button"
                            class="primary-action"
                            @onclick="NuevoPlan">

                        <MudIcon Icon="@Icons.Material.Filled.Add"
                                 Size="Size.Small" />

                        Nuevo plan

                    </button>

                </header>


                @if (PlanesSinTarifa > 0)
                {
                    <div class="panel-warning">
                        <MudIcon Icon="@Icons.Material.Filled.WarningAmber"
                                 Size="Size.Small" />
                        <span>
                            Hay @PlanesSinTarifa plan(es) activo(s) sin una tarifa vigente.
                        </span>
                    </div>
                }


                <div class="plans-grid">

                    @foreach (var plan in _planes)
                    {
                        <article class="plan-card @(!plan.Activo ? "disabled" : null)">

                            <header>

                                <div class="plan-title-wrap">

                                    <span class="plan-icon">
                                        <MudIcon Icon="@Icons.Material.Filled.Pool" />
                                    </span>

                                    <div>
                                        <small>
                                            @plan.VecesPorSemana
                                            @(plan.VecesPorSemana == 1
                                                ? "CLASE POR SEMANA"
                                                : "CLASES POR SEMANA")
                                        </small>
                                        <h3>@plan.Nombre</h3>
                                    </div>

                                </div>

                                <span class="status-badge @(plan.Activo ? "on" : "off")">
                                    <span></span>
                                    @(plan.Activo ? "Activo" : "Inactivo")
                                </span>

                            </header>


                            @if (!string.IsNullOrWhiteSpace(plan.Descripcion))
                            {
                                <p class="plan-description">
                                    @plan.Descripcion
                                </p>
                            }


                            <div class="plan-current-price">

                                <span>Tarifa vigente</span>

                                @if (plan.PrecioActual.HasValue)
                                {
                                    <strong>
                                        @FormatearPrecio(plan.PrecioActual.Value)
                                    </strong>

                                    <small>
                                        Desde @FormatearFecha(plan.TarifaVigenteDesde)
                                        @if (plan.TarifaVigenteHasta.HasValue)
                                        {
                                            <text> · hasta @FormatearFecha(plan.TarifaVigenteHasta)</text>
                                        }
                                    </small>
                                }
                                else
                                {
                                    <strong class="missing-price">
                                        Sin tarifa vigente
                                    </strong>
                                }

                            </div>


                            <div class="plan-meta">
                                <span>
                                    <MudIcon Icon="@Icons.Material.Filled.Groups"
                                             Size="Size.Small" />
                                    @plan.InscripcionesActivas inscripciones activas
                                </span>
                            </div>


                            <div class="plan-actions">

                                <button type="button"
                                        class="secondary-action compact"
                                        @onclick="() => EditarPlan(plan)">
                                    <MudIcon Icon="@Icons.Material.Filled.Edit"
                                             Size="Size.Small" />
                                    Editar
                                </button>

                                <button type="button"
                                        class="secondary-action compact"
                                        @onclick="() => NuevaTarifa(plan)">
                                    <MudIcon Icon="@Icons.Material.Filled.AttachMoney"
                                             Size="Size.Small" />
                                    Nueva tarifa
                                </button>

                                <button type="button"
                                        class="secondary-action compact @(plan.Activo ? "danger-soft" : "success-soft")"
                                        @onclick="() => CambiarEstadoPlanAsync(plan)">
                                    <MudIcon Icon="@(plan.Activo
                                        ? Icons.Material.Filled.VisibilityOff
                                        : Icons.Material.Filled.Visibility)"
                                             Size="Size.Small" />
                                    @(plan.Activo ? "Desactivar" : "Activar")
                                </button>

                            </div>


                            <details class="tariff-history">

                                <summary>
                                    <span>
                                        <MudIcon Icon="@Icons.Material.Filled.History"
                                                 Size="Size.Small" />
                                        Historial de tarifas
                                    </span>
                                    <strong>@plan.Tarifas.Count</strong>
                                </summary>

                                <div class="tariff-history-list">

                                    @if (plan.Tarifas.Count == 0)
                                    {
                                        <div class="empty-small">
                                            Todavía no hay tarifas registradas.
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var tarifa in plan.Tarifas)
                                        {
                                            <div class="tariff-row">

                                                <span>
                                                    <strong>@FormatearPrecio(tarifa.PrecioMensual)</strong>
                                                    <small>
                                                        @FormatearFecha(tarifa.VigenciaDesde)
                                                        →
                                                        @FormatearFecha(tarifa.VigenciaHasta)
                                                    </small>
                                                </span>

                                                @if (tarifa.EsVigente)
                                                {
                                                    <span class="current-badge">
                                                        VIGENTE
                                                    </span>
                                                }

                                                <button type="button"
                                                        title="Corregir esta tarifa"
                                                        @onclick="() => CorregirTarifa(plan, tarifa)">
                                                    <MudIcon Icon="@Icons.Material.Filled.Edit"
                                                             Size="Size.Small" />
                                                </button>

                                            </div>
                                        }
                                    }

                                </div>

                            </details>

                        </article>
                    }

                </div>

            </section>
        }


        @* =====================================================
           REGLAS
           ===================================================== *@

        @if (_seccion == SeccionConfiguracion.Reglas)
        {
            <section class="settings-panel rules-panel">

                <header class="panel-header">

                    <div>
                        <span class="panel-eyebrow">REGLAS GENERALES</span>
                        <h2>Parámetros del sistema</h2>
                        <p>
                            Valores que pueden cambiar en el tiempo sin modificar
                            el código de la aplicación.
                        </p>
                    </div>

                </header>


                <div class="rules-grid">

                    <label class="rule-field">
                        <span class="rule-icon recoveries">
                            <MudIcon Icon="@Icons.Material.Filled.Sync"
                                     Size="Size.Small" />
                        </span>
                        <span class="rule-copy">
                            <strong>Vigencia de recuperos</strong>
                            <small>Días disponibles desde la ausencia que los origina.</small>
                        </span>
                        <span class="number-unit">
                            <input type="number"
                                   min="1"
                                   max="365"
                                   @bind="_reglasForm.DiasVigenciaRecupero" />
                            <span>días</span>
                        </span>
                    </label>


                    <label class="rule-field">
                        <span class="rule-icon health">
                            <MudIcon Icon="@Icons.Material.Filled.MedicalServices"
                                     Size="Size.Small" />
                        </span>
                        <span class="rule-copy">
                            <strong>Vigencia del apto médico</strong>
                            <small>Período sugerido al realizar una nueva revisión.</small>
                        </span>
                        <span class="number-unit">
                            <input type="number"
                                   min="1"
                                   max="24"
                                   @bind="_reglasForm.MesesVigenciaApto" />
                            <span>meses</span>
                        </span>
                    </label>


                    <label class="rule-field">
                        <span class="rule-icon warning">
                            <MudIcon Icon="@Icons.Material.Filled.NotificationImportant"
                                     Size="Size.Small" />
                        </span>
                        <span class="rule-copy">
                            <strong>Alerta de apto por vencer</strong>
                            <small>Anticipación para mostrar el apto como próximo a vencer.</small>
                        </span>
                        <span class="number-unit">
                            <input type="number"
                                   min="0"
                                   max="60"
                                   @bind="_reglasForm.DiasAlertaApto" />
                            <span>días</span>
                        </span>
                    </label>


                    <label class="rule-field">
                        <span class="rule-icon money">
                            <MudIcon Icon="@Icons.Material.Filled.EventAvailable"
                                     Size="Size.Small" />
                        </span>
                        <span class="rule-copy">
                            <strong>Vencimiento de cuota</strong>
                            <small>Día del mes usado al generar las cuotas mensuales.</small>
                        </span>
                        <span class="number-unit">
                            <input type="number"
                                   min="1"
                                   max="28"
                                   @bind="_reglasForm.DiaVencimientoCuota" />
                            <span>día</span>
                        </span>
                    </label>


                    <label class="rule-field wide">
                        <span class="rule-icon age">
                            <MudIcon Icon="@Icons.Material.Filled.ChildCare"
                                     Size="Size.Small" />
                        </span>
                        <span class="rule-copy">
                            <strong>Edad máxima admitida</strong>
                            <small>
                                Se utiliza para las validaciones de inscripción y alertas por edad.
                                Valor actual: @ObtenerEdadMaximaTexto().
                            </small>
                        </span>
                        <span class="number-unit">
                            <input type="number"
                                   min="1"
                                   max="84"
                                   @bind="_reglasForm.EdadMaximaMeses" />
                            <span>meses</span>
                        </span>
                    </label>

                </div>


                <div class="panel-footer-actions">
                    <button type="button"
                            class="primary-action"
                            disabled="@_guardando"
                            @onclick="GuardarReglasAsync">

                        <MudIcon Icon="@Icons.Material.Filled.Save"
                                 Size="Size.Small" />

                        Guardar reglas

                    </button>
                </div>

            </section>
        }


        @* =====================================================
           INSTITUCIÓN
           ===================================================== *@

        @if (_seccion == SeccionConfiguracion.Institucion)
        {
            <section class="settings-panel institution-panel">

                <header class="panel-header">

                    <div>
                        <span class="panel-eyebrow">DATOS GENERALES</span>
                        <h2>Institución</h2>
                        <p>
                            Información institucional que podrá reutilizarse
                            en comprobantes, reportes y comunicaciones.
                        </p>
                    </div>

                </header>


                <div class="institution-form-grid">

                    <label class="form-field">
                        <span>Nombre de la institución *</span>
                        <input type="text"
                               maxlength="160"
                               placeholder="Bebés Nadadores"
                               @bind="_institucionForm.NombreInstitucion" />
                    </label>


                    <label class="form-field">
                        <span>WhatsApp</span>
                        <input type="text"
                               maxlength="40"
                               placeholder="Ej. +54 9 221 ..."
                               @bind="_institucionForm.WhatsApp" />
                    </label>


                    <label class="form-field full">
                        <span>Dirección</span>
                        <input type="text"
                               maxlength="300"
                               placeholder="Dirección del natatorio"
                               @bind="_institucionForm.Direccion" />
                    </label>


                    <label class="form-field full">
                        <span>Logo · ruta o URL</span>
                        <input type="text"
                               maxlength="500"
                               placeholder="Ej. /images/logo-bebes-nadadores.png"
                               @bind="_institucionForm.LogoUrl" />
                        <small>
                            Por ahora se guarda la referencia. El logo actual del sistema
                            no se reemplaza automáticamente desde esta pantalla.
                        </small>
                    </label>

                </div>


                <div class="institution-preview">

                    <span class="institution-preview-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Pool" />
                    </span>

                    <span>
                        <small>VISTA PREVIA</small>
                        <strong>
                            @(string.IsNullOrWhiteSpace(_institucionForm.NombreInstitucion)
                                ? "Bebés Nadadores"
                                : _institucionForm.NombreInstitucion)
                        </strong>
                        <span>
                            @(!string.IsNullOrWhiteSpace(_institucionForm.Direccion)
                                ? _institucionForm.Direccion
                                : "Dirección no configurada")
                        </span>
                    </span>

                </div>


                <div class="panel-footer-actions">
                    <button type="button"
                            class="primary-action"
                            disabled="@_guardando"
                            @onclick="GuardarInstitucionAsync">

                        <MudIcon Icon="@Icons.Material.Filled.Save"
                                 Size="Size.Small" />

                        Guardar institución

                    </button>
                </div>

            </section>
        }


        @* =====================================================
           RESUMEN / ACCESOS OPERATIVOS
           ===================================================== *@

        @if (_seccion == SeccionConfiguracion.Resumen)
        {
            <section class="settings-overview">

                <div class="overview-callout">

                    <span class="overview-icon">
                        <MudIcon Icon="@Icons.Material.Filled.SettingsSuggest" />
                    </span>

                    <div>
                        <span class="panel-eyebrow">CENTRO DEL SISTEMA</span>
                        <h2>
                            @(_configuracion?.NombreInstitucion ?? "Bebés Nadadores")
                        </h2>
                        <p>
                            Los ABM operativos siguen viviendo dentro de sus módulos.
                            Desde acá tenés accesos directos sin duplicar funcionalidades.
                        </p>
                    </div>

                </div>


                <div class="overview-stats">

                    <div>
                        <span>Usuarios</span>
                        <strong>@UsuariosActivos</strong>
                        <small>activos</small>
                    </div>

                    <div>
                        <span>Planes</span>
                        <strong>@PlanesActivos</strong>
                        <small>activos</small>
                    </div>

                    <div>
                        <span>Recuperos</span>
                        <strong>@(_configuracion?.DiasVigenciaRecupero ?? 45)</strong>
                        <small>días de vigencia</small>
                    </div>

                    <div>
                        <span>Apto médico</span>
                        <strong>@(_configuracion?.MesesVigenciaApto ?? 1)</strong>
                        <small>mes de vigencia</small>
                    </div>

                    <div>
                        <span>Cuotas</span>
                        <strong>@(_configuracion?.DiaVencimientoCuota ?? 10)</strong>
                        <small>día de vencimiento</small>
                    </div>

                </div>

            </section>


            <section class="operational-section">

                <header>
                    <span class="panel-eyebrow">CONFIGURACIÓN OPERATIVA</span>
                    <h2>Accesos directos</h2>
                    <p>
                        Estas opciones ya tienen su propia pantalla y no se duplican dentro de Configuración.
                    </p>
                </header>


                <div class="operational-grid">

                    <button type="button"
                            @onclick="IrATurnera">
                        <span class="operational-icon turnera">
                            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" />
                        </span>
                        <span>
                            <strong>Turnera</strong>
                            <small>Grilla semanal, feriados y cierres</small>
                        </span>
                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                                 Size="Size.Small" />
                    </button>


                    <button type="button"
                            @onclick="IrANiveles">
                        <span class="operational-icon levels">
                            <MudIcon Icon="@Icons.Material.Filled.Layers" />
                        </span>
                        <span>
                            <strong>Niveles</strong>
                            <small>Edades, cupos y duración de clase</small>
                        </span>
                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                                 Size="Size.Small" />
                    </button>


                    <button type="button"
                            @onclick="IrAProfesores">
                        <span class="operational-icon teachers">
                            <MudIcon Icon="@Icons.Material.Filled.SupervisorAccount" />
                        </span>
                        <span>
                            <strong>Profesores</strong>
                            <small>Equipo docente y disponibilidad</small>
                        </span>
                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                                 Size="Size.Small" />
                    </button>


                    <button type="button"
                            @onclick="IrABancos">
                        <span class="operational-icon banks">
                            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" />
                        </span>
                        <span>
                            <strong>Bancos</strong>
                            <small>Cuentas y movimientos bancarios</small>
                        </span>
                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                                 Size="Size.Small" />
                    </button>


                    <button type="button"
                            @onclick="IrACaja">
                        <span class="operational-icon cash">
                            <MudIcon Icon="@Icons.Material.Filled.PointOfSale" />
                        </span>
                        <span>
                            <strong>Caja</strong>
                            <small>Apertura, movimientos y conceptos</small>
                        </span>
                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                                 Size="Size.Small" />
                    </button>

                </div>

            </section>
        }
    }

</div>


@* =============================================================
   MODAL USUARIO
   ============================================================= *@

@if (_mostrarUsuarioModal)
{
    <div class="settings-modal-backdrop"
         @onclick="() => _mostrarUsuarioModal = false">

        <section class="settings-modal user-modal"
                 @onclick:stopPropagation="true">

            <header class="modal-header">
                <div>
                    <span class="panel-eyebrow">ACCESO AL SISTEMA</span>
                    <h2>@(UsuarioEsNuevo ? "Nuevo usuario" : "Editar usuario")</h2>
                </div>

                <button type="button"
                        @onclick="() => _mostrarUsuarioModal = false">
                    <MudIcon Icon="@Icons.Material.Filled.Close" />
                </button>
            </header>


            <div class="modal-body">

                <div class="form-grid">

                    <label class="form-field full">
                        <span>Nombre completo *</span>
                        <input type="text"
                               maxlength="200"
                               placeholder="Nombre y apellido"
                               @bind="_usuarioForm.NombreCompleto" />
                    </label>

                    <label class="form-field full">
                        <span>Email / usuario *</span>
                        <input type="email"
                               maxlength="256"
                               placeholder="usuario@bebesnadadores.com"
                               @bind="_usuarioForm.Email" />
                    </label>

                    <label class="form-field">
                        <span>Rol *</span>
                        <select @bind="_usuarioForm.Rol"
                                @bind:after="RolUsuarioCambio">
                            @foreach (var rol in _roles)
                            {
                                <option value="@rol">
                                    @ObtenerNombreRol(rol)
                                </option>
                            }
                        </select>
                    </label>

                    <label class="toggle-field">
                        <span>
                            <strong>Usuario activo</strong>
                            <small>Puede iniciar sesión en el sistema.</small>
                        </span>
                        <input type="checkbox"
                               @bind="_usuarioForm.Activo" />
                    </label>


                    @if (EsRolProfesor)
                    {
                        <label class="form-field full">
                            <span>Profesor vinculado *</span>
                            <select @bind="_usuarioForm.ProfesorId">
                                <option value="">Seleccionar profesor...</option>
                                @foreach (var profesor in ProfesoresSeleccionables)
                                {
                                    <option value="@profesor.Id">
                                        @profesor.NombreCompleto
                                    </option>
                                }
                            </select>
                            <small>
                                La cuenta quedará vinculada a la ficha docente seleccionada.
                            </small>
                        </label>
                    }


                    @if (UsuarioEsNuevo)
                    {
                        <label class="form-field">
                            <span>Contraseña *</span>
                            <input type="password"
                                   autocomplete="new-password"
                                   @bind="_usuarioForm.Password" />
                        </label>

                        <label class="form-field">
                            <span>Confirmar contraseña *</span>
                            <input type="password"
                                   autocomplete="new-password"
                                   @bind="_confirmacionPassword" />
                        </label>

                        <div class="password-help full">
                            Mínimo 8 caracteres, una mayúscula, una minúscula y un número.
                        </div>
                    }

                </div>

            </div>


            <footer class="modal-footer">
                <button type="button"
                        class="secondary-action"
                        @onclick="() => _mostrarUsuarioModal = false">
                    Cancelar
                </button>

                <button type="button"
                        class="primary-action"
                        disabled="@_guardando"
                        @onclick="GuardarUsuarioAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Save"
                             Size="Size.Small" />
                    Guardar usuario
                </button>
            </footer>

        </section>

    </div>
}


@* =============================================================
   MODAL PASSWORD
   ============================================================= *@

@if (_mostrarPasswordModal &&
     _usuarioPassword is not null)
{
    <div class="settings-modal-backdrop"
         @onclick="() => _mostrarPasswordModal = false">

        <section class="settings-modal small-modal"
                 @onclick:stopPropagation="true">

            <header class="modal-header">
                <div>
                    <span class="panel-eyebrow">SEGURIDAD</span>
                    <h2>Cambiar contraseña</h2>
                    <p>@_usuarioPassword.NombreCompleto</p>
                </div>

                <button type="button"
                        @onclick="() => _mostrarPasswordModal = false">
                    <MudIcon Icon="@Icons.Material.Filled.Close" />
                </button>
            </header>

            <div class="modal-body">
                <div class="form-grid one-column">

                    <label class="form-field">
                        <span>Nueva contraseña *</span>
                        <input type="password"
                               autocomplete="new-password"
                               @bind="_nuevaPassword" />
                    </label>

                    <label class="form-field">
                        <span>Confirmar nueva contraseña *</span>
                        <input type="password"
                               autocomplete="new-password"
                               @bind="_confirmacionNuevaPassword" />
                    </label>

                    <div class="password-help">
                        Mínimo 8 caracteres, una mayúscula, una minúscula y un número.
                    </div>

                </div>
            </div>

            <footer class="modal-footer">
                <button type="button"
                        class="secondary-action"
                        @onclick="() => _mostrarPasswordModal = false">
                    Cancelar
                </button>

                <button type="button"
                        class="primary-action"
                        disabled="@_guardando"
                        @onclick="GuardarPasswordAsync">
                    <MudIcon Icon="@Icons.Material.Filled.LockReset"
                             Size="Size.Small" />
                    Cambiar contraseña
                </button>
            </footer>

        </section>

    </div>
}


@* =============================================================
   MODAL PLAN
   ============================================================= *@

@if (_mostrarPlanModal)
{
    <div class="settings-modal-backdrop"
         @onclick="() => _mostrarPlanModal = false">

        <section class="settings-modal small-modal"
                 @onclick:stopPropagation="true">

            <header class="modal-header">
                <div>
                    <span class="panel-eyebrow">PLAN DE ASISTENCIA</span>
                    <h2>@(_planForm.Id.HasValue ? "Editar plan" : "Nuevo plan")</h2>
                </div>

                <button type="button"
                        @onclick="() => _mostrarPlanModal = false">
                    <MudIcon Icon="@Icons.Material.Filled.Close" />
                </button>
            </header>

            <div class="modal-body">
                <div class="form-grid one-column">

                    <label class="form-field">
                        <span>Nombre *</span>
                        <input type="text"
                               maxlength="100"
                               placeholder="Ej. 2 veces por semana"
                               @bind="_planForm.Nombre" />
                    </label>

                    <label class="form-field">
                        <span>Clases por semana *</span>
                        <input type="number"
                               min="1"
                               max="7"
                               @bind="_planForm.VecesPorSemana" />
                        <small>
                            No puede modificarse si el plan tiene inscripciones activas.
                        </small>
                    </label>

                    <label class="form-field">
                        <span>Descripción</span>
                        <textarea rows="3"
                                  maxlength="500"
                                  placeholder="Descripción opcional del plan..."
                                  @bind="_planForm.Descripcion"></textarea>
                    </label>

                    <label class="toggle-field wide-toggle">
                        <span>
                            <strong>Plan activo</strong>
                            <small>Disponible para nuevas inscripciones.</small>
                        </span>
                        <input type="checkbox"
                               @bind="_planForm.Activo" />
                    </label>

                </div>
            </div>

            <footer class="modal-footer">
                <button type="button"
                        class="secondary-action"
                        @onclick="() => _mostrarPlanModal = false">
                    Cancelar
                </button>

                <button type="button"
                        class="primary-action"
                        disabled="@_guardando"
                        @onclick="GuardarPlanAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Save"
                             Size="Size.Small" />
                    Guardar plan
                </button>
            </footer>

        </section>

    </div>
}


@* =============================================================
   MODAL TARIFA
   ============================================================= *@

@if (_mostrarTarifaModal &&
     _planTarifaSeleccionado is not null)
{
    <div class="settings-modal-backdrop"
         @onclick="() => _mostrarTarifaModal = false">

        <section class="settings-modal small-modal"
                 @onclick:stopPropagation="true">

            <header class="modal-header">
                <div>
                    <span class="panel-eyebrow">
                        @(_corrigiendoTarifa ? "CORRECCIÓN DE TARIFA" : "NUEVA VIGENCIA")
                    </span>
                    <h2>@_planTarifaSeleccionado.Nombre</h2>
                    <p>
                        @_planTarifaSeleccionado.VecesPorSemana
                        @(_planTarifaSeleccionado.VecesPorSemana == 1
                            ? " clase por semana"
                            : " clases por semana")
                    </p>
                </div>

                <button type="button"
                        @onclick="() => _mostrarTarifaModal = false">
                    <MudIcon Icon="@Icons.Material.Filled.Close" />
                </button>
            </header>

            <div class="modal-body">
                <div class="form-grid one-column">

                    <label class="form-field">
                        <span>Precio mensual *</span>
                        <div class="money-input">
                            <span>$</span>
                            <input type="number"
                                   min="1"
                                   step="100"
                                   @bind="_tarifaForm.PrecioMensual" />
                        </div>
                    </label>

                    <div class="form-field">
                        <span>Vigente desde *</span>

                        <BnDatePicker Value="@_tarifaForm.VigenciaDesde"
                                      ValueChanged="CambiarVigenciaTarifaAsync"
                                      Placeholder="Seleccionar mes de vigencia" />

                        <small>
                            La tarifa se aplica desde el primer día del mes seleccionado.
                        </small>
                    </div>

                    <div class="tariff-info">
                        <MudIcon Icon="@Icons.Material.Filled.Info"
                                 Size="Size.Small" />
                        <span>
                            @if (_corrigiendoTarifa)
                            {
                                <text>
                                    Se corregirá el valor del período existente sin crear un duplicado.
                                </text>
                            }
                            else
                            {
                                <text>
                                    El período anterior se cerrará automáticamente y seguirá disponible en el historial.
                                </text>
                            }
                        </span>
                    </div>

                </div>
            </div>

            <footer class="modal-footer">
                <button type="button"
                        class="secondary-action"
                        @onclick="() => _mostrarTarifaModal = false">
                    Cancelar
                </button>

                <button type="button"
                        class="primary-action"
                        disabled="@_guardando"
                        @onclick="GuardarTarifaAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Save"
                             Size="Size.Small" />
                    @(_corrigiendoTarifa ? "Guardar corrección" : "Registrar tarifa")
                </button>
            </footer>

        </section>

    </div>
}
