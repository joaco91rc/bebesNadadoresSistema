@page "/administracion/migracion"
@rendermode InteractiveServer
@attribute [Authorize(Policy = PoliticasSistema.SoloAdministrador)]
@using System.Globalization
@using BebesNadadores.Web.Services.Migracion
@inject MigracionCargaService Carga
@inject MigracionEjecucionService Ejecutor
@inject NavigationManager Nav

<PageTitle>Migración | Bebés Nadadores</PageTitle>

<div class="migracion-page">
    <header class="migracion-header">
        <div>
            <span class="eyebrow">ADMINISTRACIÓN / MIGRACIÓN</span>
            <h1>Migración desde el sistema anterior</h1>
            <p>Restaurá el respaldo en MySQL aislado, simulá y revisá las diferencias antes de importar.</p>
        </div>
        <button type="button" class="bn-btn bn-btn-outline" @onclick="Volver">
            <span aria-hidden="true">←</span> Volver
        </button>
    </header>

    @if (_trabajando || Ejecutor.Ocupado)
    {
        <div class="migracion-global-status" role="status" aria-live="polite">
            <MudProgressCircular Indeterminate="true" Color="Color.Info" Size="Size.Small" />
            <div>
                <strong>@(string.IsNullOrWhiteSpace(_mensajeCarga) ? "Hay una operación en curso" : _mensajeCarga)</strong>
                <span>Los botones de operación permanecen deshabilitados para evitar ejecuciones duplicadas.</span>
            </div>
        </div>
    }

    <section class="migracion-card">
        <div class="migracion-section-head">
            <span class="migracion-num">01</span>
            <div>
                <h2>Cargar respaldo MySQL</h2>
                <p class="muted">Archivo .sql de hasta 150 MB. Se almacena fuera de wwwroot y nunca se ejecuta directamente sobre PostgreSQL.</p>
            </div>
        </div>

        <div class="bn-upload-box">
            <div class="bn-upload-icon" aria-hidden="true">↑</div>
            <div class="bn-upload-copy">
                <strong>Respaldo del sistema anterior</strong>
                <span>@(_analisis is null ? "Seleccioná el archivo .sql para analizarlo." : _analisis.NombreArchivo)</span>
            </div>
            <label for="migracion-archivo-sql" class="bn-btn bn-btn-primary @((_trabajando || Ejecutor.Ocupado) ? "bn-btn-disabled" : "")">
                Seleccionar archivo SQL
            </label>
            <span class="bn-file-native-hidden">
                <InputFile id="migracion-archivo-sql"
                           OnChange="Seleccionar" accept=".sql"
                           disabled="@(_trabajando || Ejecutor.Ocupado)" />
            </span>
        </div>

        @if (_fase == FaseOperacion.CargandoSql)
        {
            <div class="bn-working" role="status" aria-live="polite">
                <div class="bn-working-title">
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Info" />
                    <div>
                        <strong>Recibiendo y analizando SQL</strong>
                        <span>La carga del archivo puede tardar. No cierres la página.</span>
                    </div>
                </div>
                <MudProgressLinear Indeterminate="true" Color="Color.Info" Class="mt-3" />
            </div>
        }
        else if (_analisis is not null)
        {
            <div class="bn-result bn-result-ok"><span aria-hidden="true">✓</span> Respaldo cargado y analizado</div>
            <dl class="datos">
                <dt>Archivo</dt><dd>@_analisis.NombreArchivo</dd>
                <dt>Tamaño</dt><dd>@((_analisis.Bytes / 1048576.0).ToString("F1")) MB</dd>
                <dt>SHA-256</dt><dd><code class="hash">@_analisis.Sha256</code></dd>
                <dt>Base PostgreSQL conectada</dt><dd><strong>@_analisis.BaseDestino</strong></dd>
                <dt>Bebés / cuotas / pagos actuales</dt><dd>@_analisis.BebesExistentes / @_analisis.CuotasExistentes / @_analisis.PagosExistentes</dd>
            </dl>
        }
    </section>

    <section class="migracion-card">
        <div class="migracion-section-head">
            <span class="migracion-num">02</span>
            <div>
                <h2>Preparar y simular</h2>
                <p class="muted">Restaura MySQL temporal aislado y ejecuta una simulación con ROLLBACK. Requiere PostgreSQL operativo vacío y entorno habilitado.</p>
            </div>
        </div>

        <div class="bn-date-row">
            <div class="bn-date-field">
                <label class="bn-field-label">Fecha de corte del respaldo</label>
                <div class="bn-date-picker-shell">
                    <MudDatePicker Date="@((DateTime?)_corte)"
                                   DateChanged="CambiarCorte"
                                   DateFormat="dd/MM/yyyy"
                                   Culture="@Cultura"
                                   Editable="false"
                                   ShowToolbar="false"
                                   Color="Color.Primary"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.None"
                                   Disabled="@(_trabajando || Ejecutor.Ocupado)"
                                   Adornment="Adornment.End"
                                   AdornmentIcon="@Icons.Material.Filled.CalendarMonth"
                                   AnchorOrigin="Origin.BottomLeft"
                                   TransformOrigin="Origin.TopLeft" />
                </div>
            </div>
            <div class="bn-date-hint">La fecha debe coincidir con el corte del dump MySQL.</div>
        </div>

        <button type="button" class="bn-btn bn-btn-primary bn-btn-action"
                @onclick="Preparar"
                disabled="@(_analisis is null || _trabajando || Ejecutor.Ocupado)">
            @if (_fase == FaseOperacion.Simulando)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Inherit" />
                <span>Simulando migración...</span>
            }
            else
            {
                <span aria-hidden="true">↻</span>
                <span>Restaurar staging + simular (ROLLBACK)</span>
            }
        </button>

        @if (_fase == FaseOperacion.Simulando)
        {
            <div class="bn-working" role="status" aria-live="polite">
                <div class="bn-working-title">
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Info" />
                    <div>
                        <strong>Restaurando MySQL temporal y ejecutando simulación</strong>
                        <span>Analizando alumnos, inscripciones, asistencias y finanzas. La barra no representa un porcentaje.</span>
                    </div>
                </div>
                <MudProgressLinear Indeterminate="true" Color="Color.Info" Class="mt-3" />
                <p class="bn-working-state">Estado del servicio: @Ejecutor.Estado</p>
            </div>
        }
        else if (_analisis is not null && Ejecutor.PrevisualizacionCompleta && Ejecutor.CodigoPreparado == _analisis.Codigo)
        {
            <div class="bn-result bn-result-ok"><span aria-hidden="true">✓</span> Previsualización disponible para este SQL. Revisá los reportes antes de seguir.</div>
        }

        @if (_analisis is not null)
        {
            <p class="bn-report-path">Reportes: <code>@Ejecutor.CarpetaReportes(_analisis.Codigo)</code></p>
        }
    </section>

    <section class="migracion-card">
        <div class="migracion-section-head">
            <span class="migracion-num">03</span>
            <div>
                <h2>Subir tarifas históricas verificadas</h2>
                <p class="muted">Después de simular, cargá los CSV correspondientes al mismo respaldo SQL.</p>
            </div>
        </div>
        <div class="bn-csv-grid">
            <div class="bn-csv-panel">
                <strong>Tarifas mensuales</strong>
                <code>tarifas_validadas_2026.csv</code>
                <label for="tarifas-generales" class="bn-btn bn-btn-outline @((ArchivosDeshabilitados) ? "bn-btn-disabled" : "")">Seleccionar CSV</label>
                <span class="bn-file-native-hidden">
                    <InputFile id="tarifas-generales" OnChange="SubirTarifasGenerales" accept=".csv" disabled="@ArchivosDeshabilitados" />
                </span>
                @if (!string.IsNullOrEmpty(_tarifasGeneralesEstado)) { <p class="bn-csv-feedback">@_tarifasGeneralesEstado</p> }
            </div>
            <div class="bn-csv-panel">
                <strong>Excepciones por alumno</strong>
                <code>tarifas_excepciones_2026.csv</code>
                <span class="muted">Puede contener solo encabezado.</span>
                <label for="tarifas-excepciones" class="bn-btn bn-btn-outline @((ArchivosDeshabilitados) ? "bn-btn-disabled" : "")">Seleccionar CSV</label>
                <span class="bn-file-native-hidden">
                    <InputFile id="tarifas-excepciones" OnChange="SubirTarifasExcepciones" accept=".csv" disabled="@ArchivosDeshabilitados" />
                </span>
                @if (!string.IsNullOrEmpty(_tarifasExcepcionesEstado)) { <p class="bn-csv-feedback">@_tarifasExcepcionesEstado</p> }
            </div>
        </div>
        @if (_fase == FaseOperacion.SubiendoCsv)
        {
            <div class="bn-working" role="status">
                <div class="bn-working-title">
                    <MudProgressCircular Indeterminate="true" Color="Color.Info" Size="Size.Small" />
                    <strong>Validando archivo de tarifas...</strong>
                </div>
                <MudProgressLinear Indeterminate="true" Color="Color.Info" Class="mt-3" />
            </div>
        }
        <p class="muted bn-small-note">Formatos: <code>MES;TARIFA_NETA</code> y <code>IDPERSONA;MES;TARIFA_NETA</code>. Máximo 1 MB por archivo.</p>
        <div class="bn-result @(CSVListos ? "bn-result-ok" : "bn-result-neutral")">
            @(CSVListos ? "✓ Los dos CSV están cargados y verificados" : "Falta subir o verificar alguno de los dos CSV")
        </div>
    </section>

    <section class="migracion-card">
        <div class="migracion-section-head">
            <span class="migracion-num">04</span>
            <div>
                <h2>Confirmar y aplicar la migración</h2>
                <p class="muted">Importador principal, Turnera oficial y conciliación financiera V4.8. No acredita recuperos históricos sin verificar.</p>
            </div>
        </div>
        <div class="precaucion">
            <strong>Protección obligatoria</strong>
            <p>Revisá las tarifas y los reportes del SQL actual. La operación no es atómica entre etapas: si falla, restaurá el backup antes de reintentar.</p>
        </div>
        <label class="bn-check-row">
            <input type="checkbox" @bind="_confirmoTest" disabled="@(_trabajando || Ejecutor.Ocupado)" />
            <span>Confirmo que es una base de PRUEBA vacía y que revisé el informe y las tarifas.</span>
        </label>
        <button type="button" class="bn-btn bn-btn-primary bn-btn-action" @onclick="AplicarTest"
                disabled="@(_trabajando || Ejecutor.Ocupado || !Ejecutor.PrevisualizacionCompleta || !_confirmoTest || _analisis is null || !CSVListos)">
            @(_fase == FaseOperacion.AplicandoTest ? "Aplicando migración en TEST..." : "Aplicar solo en TEST")
        </button>
        @if (Ejecutor.ProduccionHabilitada)
        {
            <div class="precaucion bn-production">
                <strong>COMMIT PRODUCTIVO — acción irreversible sin restaurar backup</strong>
                <p>Confirmo mantenimiento, reportes y tarifas revisados, y diferencias históricas pendientes para la administrativa. Se hará pg_dump antes del primer COMMIT. No reintentar tras un fallo.</p>
                <label class="bn-check-row">
                    <input type="checkbox" @bind="_confirmoProduccion" disabled="@(_trabajando || Ejecutor.Ocupado)" />
                    <span>Acepto el plan de migración productiva</span>
                </label>
                <label class="bn-field-label" for="frase-produccion">Escribí MIGRAR seguido del nombre exacto de la base productiva</label>
                <input id="frase-produccion" class="bn-text-input" type="text" @bind="_fraseProduccion" autocomplete="off" disabled="@(_trabajando || Ejecutor.Ocupado)" />
                <button type="button" class="bn-btn bn-btn-danger" @onclick="AplicarProduccion"
                        disabled="@(_trabajando || Ejecutor.Ocupado || !Ejecutor.PrevisualizacionCompleta || !_confirmoProduccion || _analisis is null || !CSVListos)">
                    @(_fase == FaseOperacion.AplicandoProduccion ? "Ejecutando COMMIT productivo..." : "Confirmar COMMIT productivo")
                </button>
            </div>
        }
        else
        {
            <p class="bn-prod-disabled">Producción no habilitada en este entorno</p>
        }
        @if (_fase == FaseOperacion.AplicandoTest || _fase == FaseOperacion.AplicandoProduccion)
        {
            <div class="bn-working" role="status">
                <div class="bn-working-title">
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Info" />
                    <div>
                        <strong>@_mensajeCarga</strong>
                        <span>No cierres la página mientras termina la operación.</span>
                    </div>
                </div>
                <MudProgressLinear Indeterminate="true" Color="Color.Info" Class="mt-3" />
            </div>
        }
    </section>

    <section class="migracion-card">
        <div class="migracion-status-head">
            <h2>Estado de ejecución</h2>
            <button type="button" class="bn-btn bn-btn-outline bn-btn-small" @onclick="Refrescar">↻ Actualizar estado</button>
        </div>
        <p class="bn-executor-state"><strong>@Ejecutor.Estado</strong></p>
        @if (!string.IsNullOrEmpty(_error)) { <div class="bn-result bn-result-error" role="alert">@_error</div> }
        @if (!string.IsNullOrEmpty(_exito)) { <div class="bn-result bn-result-ok" role="status">@_exito</div> }
        <p class="muted bn-small-note">Última actualización: @_ultimaActualizacion</p>
        <details class="bn-diagnostics">
            <summary>Diagnóstico técnico</summary>
            <p>Trabajando=@_trabajando | Ejecutor ocupado=@Ejecutor.Ocupado | SQL cargado=@(_analisis is not null)</p>
        </details>
        @if (!string.IsNullOrWhiteSpace(Ejecutor.Registro))
        {
            <pre class="bn-log">@Ejecutor.Registro</pre>
        }
    </section>
</div>

@code {
    private enum FaseOperacion { Ninguna, CargandoSql, Simulando, SubiendoCsv, AplicandoTest, AplicandoProduccion }
    private static readonly CultureInfo Cultura = CultureInfo.GetCultureInfo("es-AR");
    private MigracionAnalisisDto? _analisis;
    private DateTime _corte = DateTime.Today;
    private bool _confirmoTest;
    private bool _confirmoProduccion;
    private string _fraseProduccion = "";
    private bool _trabajando;
    private FaseOperacion _fase = FaseOperacion.Ninguna;
    private string _mensajeCarga = "";
    private string? _tarifasGeneralesEstado, _tarifasExcepcionesEstado;
    private string? _error, _exito;
    private string _ultimaActualizacion = "Sin actualizar";

    private bool ArchivosDeshabilitados => _trabajando || Ejecutor.Ocupado ||
        !Ejecutor.PrevisualizacionCompleta || _analisis is null;

    private bool CSVListos => _analisis is not null &&
        Ejecutor.PrevisualizacionCompleta && Ejecutor.CodigoPreparado == _analisis.Codigo &&
        MigracionCargaService.TarifasSubidasYVerificadas(Ejecutor.CarpetaReportes(_analisis.Codigo));

    private Task CambiarCorte(DateTime? fecha)
    {
        if (fecha.HasValue)
            _corte = fecha.Value.Date;
        return Task.CompletedTask;
    }

    private void Volver() => Nav.NavigateTo("/configuracion");

    private void Refrescar()
    {
        _ultimaActualizacion = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
        StateHasChanged();
    }

    private async Task ComenzarOperacionAsync(FaseOperacion fase, string mensaje)
    {
        _trabajando = true;
        _fase = fase;
        _mensajeCarga = mensaje;
        _ultimaActualizacion = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
        await InvokeAsync(StateHasChanged);
        await Task.Yield(); // Permite dibujar la indicación antes del trabajo de servicio.
    }

    private async Task FinalizarOperacionAsync()
    {
        _trabajando = false;
        _fase = FaseOperacion.Ninguna;
        _mensajeCarga = "";
        _ultimaActualizacion = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss");
        await InvokeAsync(StateHasChanged);
    }

    private Task SubirTarifasGenerales(InputFileChangeEventArgs args) => SubirCsv(args, false);
    private Task SubirTarifasExcepciones(InputFileChangeEventArgs args) => SubirCsv(args, true);

    private async Task SubirCsv(InputFileChangeEventArgs args, bool excepciones)
    {
        if (_analisis is null || ArchivosDeshabilitados ||
            Ejecutor.CodigoPreparado != _analisis.Codigo)
            return;

        _error = _exito = null;
        await ComenzarOperacionAsync(FaseOperacion.SubiendoCsv, "Validando tarifas históricas...");
        try
        {
            var mensaje = await Carga.GuardarTarifasAsync(args.File, _analisis.Codigo, excepciones);
            if (excepciones) _tarifasExcepcionesEstado = mensaje;
            else _tarifasGeneralesEstado = mensaje;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { await FinalizarOperacionAsync(); }
    }

    private async Task Seleccionar(InputFileChangeEventArgs args)
    {
        if (_trabajando || Ejecutor.Ocupado) return;
        _error = _exito = null;
        _analisis = null;
        _confirmoTest = _confirmoProduccion = false;
        _tarifasGeneralesEstado = _tarifasExcepcionesEstado = null;
        await ComenzarOperacionAsync(FaseOperacion.CargandoSql, "Recibiendo y analizando el archivo SQL...");
        try { _analisis = await Carga.RecibirYAnalizarAsync(args.File); }
        catch (Exception ex) { _error = ex.Message; }
        finally { await FinalizarOperacionAsync(); }
    }

    private async Task Preparar()
    {
        if (_analisis is null || _trabajando || Ejecutor.Ocupado) return;
        _error = _exito = null;
        _confirmoTest = _confirmoProduccion = false;
        _tarifasGeneralesEstado = _tarifasExcepcionesEstado = null;
        await ComenzarOperacionAsync(FaseOperacion.Simulando, "Restaurando staging y simulando migración (ROLLBACK)...");
        try
        {
            await Ejecutor.PrepararAsync(_analisis.Codigo, DateOnly.FromDateTime(_corte));
            _exito = "Simulación terminada. Revisá los CSV antes de confirmar la aplicación TEST.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { await FinalizarOperacionAsync(); }
    }

    private async Task AplicarTest()
    {
        if (_analisis is null || !_confirmoTest || _trabajando || Ejecutor.Ocupado || !CSVListos) return;
        _error = _exito = null;
        await ComenzarOperacionAsync(FaseOperacion.AplicandoTest, "Aplicando migración en TEST...");
        try
        {
            await Ejecutor.AplicarSoloTestAsync(_analisis.Codigo);
            _exito = "Migración completada en TEST. No se modificó producción.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { await FinalizarOperacionAsync(); }
    }

    private async Task AplicarProduccion()
    {
        if (_analisis is null || !_confirmoProduccion || _trabajando || Ejecutor.Ocupado ||
            !Ejecutor.ProduccionHabilitada || !CSVListos) return;
        _error = _exito = null;
        await ComenzarOperacionAsync(FaseOperacion.AplicandoProduccion, "Ejecutando migración productiva...");
        try
        {
            await Ejecutor.AplicarProduccionAsync(_analisis.Codigo, _fraseProduccion);
            _exito = "Importación productiva terminada. Revisá reportes y pendientes manuales.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { await FinalizarOperacionAsync(); }
    }
}
