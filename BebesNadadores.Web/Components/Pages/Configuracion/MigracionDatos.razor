@page "/administracion/migracion"
@rendermode InteractiveServer
@attribute [Authorize(Policy = PoliticasSistema.SoloAdministrador)]
@using BebesNadadores.Web.Services.Migracion
@inject MigracionCargaService Carga
@inject MigracionEjecucionService Ejecutor
@inject NavigationManager Nav

<PageTitle>Migración | Bebés Nadadores</PageTitle>
<div class="migracion-page">
    <header class="migracion-header">
        <div>
            <span class="eyebrow">ADMINISTRACIÓN / MIGRACIÓN</span>
            <h1>Migración desde el sistema anterior</h1>
            <p>Restaurá el respaldo en MySQL aislado, simulá y revisá las diferencias antes de importar.</p>
        </div>
        <button @onclick="Volver">Volver</button>
    </header>
    <section class="migracion-card">
        <h2>1. Cargar respaldo MySQL</h2>
        <p class="muted">Archivo SQL de hasta 150 MB. No debe incluir contraseñas. La aplicación lo guarda fuera de wwwroot.</p>
        <InputFile OnChange="Seleccionar" accept=".sql" disabled="@(_trabajando || Ejecutor.Ocupado)" />
        @if (_analisis is not null)
        {
            <dl class="datos">
                <dt>Archivo</dt><dd>@_analisis.NombreArchivo</dd>
                <dt>Tamaño</dt><dd>@((_analisis.Bytes / 1048576.0).ToString("F1")) MB</dd>
                <dt>SHA-256</dt><dd><code class="hash">@_analisis.Sha256</code></dd>
                <dt>Base PostgreSQL conectada</dt><dd><strong>@_analisis.BaseDestino</strong></dd>
                <dt>Bebés / cuotas / pagos actuales</dt><dd>@_analisis.BebesExistentes / @_analisis.CuotasExistentes / @_analisis.PagosExistentes</dd>
            </dl>
        }
    </section>
    <section class="migracion-card">
        <h2>2. Preparar y simular</h2>
        <p class="muted">Requiere MySQL temporal aislado, PostgreSQL destino vacío de alumnos/pagos/cuotas, y entorno habilitado. El SQL original nunca se ejecuta en PostgreSQL.</p>
        <label>Fecha de corte del respaldo</label>
        <InputDate @bind-Value="_corte" disabled="@(_trabajando || Ejecutor.Ocupado)" />
        <div style="margin-top:12px">
            <button @onclick="Preparar" disabled="@(_analisis is null || _trabajando || Ejecutor.Ocupado)">Restaurar staging + simular (ROLLBACK)</button>
        </div>
        @if (_analisis is not null)
        {
            <p class="muted">Reportes: <code>@Ejecutor.CarpetaReportes(_analisis.Codigo)</code></p>
        }
    </section>
    <section class="migracion-card">
        <h2>3. Subir tarifas históricas verificadas</h2>
        <p class="muted">Después de simular, cargá los CSV correspondientes al mismo respaldo SQL. No hace falta acceder al VPS.</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:18px;margin:16px 0">
            <div>
                <label for="tarifas-generales"><strong>Tarifas mensuales</strong></label>
                <p class="muted"><code>tarifas_validadas_2026.csv</code></p>
                <InputFile id="tarifas-generales" OnChange="SubirTarifasGenerales" accept=".csv" disabled="@(_trabajando || Ejecutor.Ocupado || !Ejecutor.PrevisualizacionCompleta || _analisis is null)" />
                @if (!string.IsNullOrEmpty(_tarifasGeneralesEstado)) { <p>@_tarifasGeneralesEstado</p> }
            </div>
            <div>
                <label for="tarifas-excepciones"><strong>Excepciones por alumno</strong></label>
                <p class="muted"><code>tarifas_excepciones_2026.csv</code> (puede contener solo encabezado)</p>
                <InputFile id="tarifas-excepciones" OnChange="SubirTarifasExcepciones" accept=".csv" disabled="@(_trabajando || Ejecutor.Ocupado || !Ejecutor.PrevisualizacionCompleta || _analisis is null)" />
                @if (!string.IsNullOrEmpty(_tarifasExcepcionesEstado)) { <p>@_tarifasExcepcionesEstado</p> }
            </div>
        </div>
        <p class="muted">Formatos: <code>MES;TARIFA_NETA</code> y <code>IDPERSONA;MES;TARIFA_NETA</code>. Máximo 1 MB por archivo. El COMMIT requiere ambos CSV cargados y verificados desde esta pantalla.</p>
        <p><strong>Archivos preparados:</strong> @(CSVListos ? "Los dos CSV están cargados y verificados" : "Falta subir o verificar alguno de los dos CSV")</p>
    </section>
    <section class="migracion-card">
        <h2>4. Confirmar y aplicar la migración</h2>
        <p class="muted">Secuencia: importador principal, Turnera oficial y conciliación financiera V4.8. No acredita recuperos históricos sin verificar.</p>
        <div class="precaucion">
            <strong>Protección obligatoria</strong>
            <p>Revisá las tarifas cargadas y los reportes del SQL actual. La operación no es atómica entre etapas: si un paso falla, restaurá el respaldo antes de reintentar.</p>
        </div>
        <label style="display:block; margin:12px 0">
            <input type="checkbox" @bind="_confirmoTest" /> Confirmo que es una base de PRUEBA vacía y que revisé el informe y las tarifas.
        </label>
        <button @onclick="AplicarTest" disabled="@(_trabajando || Ejecutor.Ocupado || !Ejecutor.PrevisualizacionCompleta || !_confirmoTest || _analisis is null || !CSVListos)">Aplicar solo en TEST</button>
        @if (Ejecutor.ProduccionHabilitada)
        {
            <div class="precaucion" style="margin-top:15px">
                <strong>COMMIT PRODUCTIVO — acción irreversible sin restaurar el backup</strong>
                <p>Confirmo que el sistema está en mantenimiento, revisé los reportes y los CSV del corte,
                   y acepto que las diferencias históricas quedarán pendientes para la administrativa.
                   Se hará un respaldo pg_dump antes del primer COMMIT. No reintentar tras un fallo.</p>
                <label><input type="checkbox" @bind="_confirmoProduccion" /> Acepto el plan de migración productiva</label>
                <label>Escribí MIGRAR seguido del nombre exacto de la base de producción</label>
                <input type="text" @bind="_fraseProduccion" autocomplete="off" />
                <button @onclick="AplicarProduccion" disabled="@(_trabajando || Ejecutor.Ocupado || !Ejecutor.PrevisualizacionCompleta || !_confirmoProduccion || _analisis is null || !CSVListos)">Confirmar COMMIT productivo</button>
            </div>
        }
        else
        {
            <button disabled title="Requiere habilitación expresa y base autorizada">Producción no habilitada</button>
        }
    </section>
    <section class="migracion-card">
        <h2>Estado</h2>
        <p><strong>@Ejecutor.Estado</strong></p>
        @if (!string.IsNullOrEmpty(_error)) { <p class="error">@_error</p> }
        @if (!string.IsNullOrEmpty(_exito)) { <p>@_exito</p> }
        <button @onclick="Refrescar">Actualizar estado</button>
        @if (!string.IsNullOrWhiteSpace(Ejecutor.Registro))
        {
            <pre style="white-space:pre-wrap; overflow-wrap:anywhere; max-height:350px; overflow:auto">@Ejecutor.Registro</pre>
        }
    </section>
</div>
@code {
    private MigracionAnalisisDto? _analisis;
    private DateTime _corte = DateTime.Today;
    private bool _confirmoTest;
    private bool _confirmoProduccion;
    private string _fraseProduccion = "";
    private bool _trabajando;
    private string? _tarifasGeneralesEstado, _tarifasExcepcionesEstado;
    private bool CSVListos => _analisis is not null &&
        Ejecutor.PrevisualizacionCompleta && Ejecutor.CodigoPreparado == _analisis.Codigo &&
        MigracionCargaService.TarifasSubidasYVerificadas(Ejecutor.CarpetaReportes(_analisis.Codigo));

    private Task SubirTarifasGenerales(InputFileChangeEventArgs args) => SubirCsv(args, false);
    private Task SubirTarifasExcepciones(InputFileChangeEventArgs args) => SubirCsv(args, true);

    private async Task SubirCsv(InputFileChangeEventArgs args, bool excepciones)
    {
        _error = _exito = null;
        if (_analisis is null || !Ejecutor.PrevisualizacionCompleta ||
            Ejecutor.CodigoPreparado != _analisis.Codigo || Ejecutor.Ocupado) return;
        _trabajando = true;
        try
        {
            var message = await Carga.GuardarTarifasAsync(args.File, _analisis.Codigo, excepciones);
            if (excepciones) _tarifasExcepcionesEstado = message;
            else _tarifasGeneralesEstado = message;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _trabajando = false; }
    }

    private string? _error, _exito;
    private void Volver() => Nav.NavigateTo("/configuracion");
    private void Refrescar() => StateHasChanged();

    private async Task Seleccionar(InputFileChangeEventArgs args)
    {
        _error = _exito = null; _analisis = null; _confirmoTest = false;
        _confirmoProduccion = false; _tarifasGeneralesEstado = _tarifasExcepcionesEstado = null;
        _trabajando = true;
        try { _analisis = await Carga.RecibirYAnalizarAsync(args.File); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _trabajando = false; }
    }
    private async Task Preparar()
    {
        if (_analisis is null) return;
        _error = _exito = null; _trabajando = true;
        _confirmoTest = _confirmoProduccion = false;
        _tarifasGeneralesEstado = _tarifasExcepcionesEstado = null;
        try
        {
            await Ejecutor.PrepararAsync(_analisis.Codigo, DateOnly.FromDateTime(_corte));
            _exito = "Simulación terminada. Revisá los CSV antes de confirmar la aplicación TEST.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _trabajando = false; }
    }
    private async Task AplicarProduccion()
    {
        if (_analisis is null || !_confirmoProduccion) return;
        _error = _exito = null; _trabajando = true;
        try
        {
            await Ejecutor.AplicarProduccionAsync(_analisis.Codigo, _fraseProduccion);
            _exito = "Importación productiva terminada. Revisá reportes y pendientes manuales.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _trabajando = false; }
    }

    private async Task AplicarTest()
    {
        if (_analisis is null || !_confirmoTest) return;
        _error = _exito = null; _trabajando = true;
        try
        {
            await Ejecutor.AplicarSoloTestAsync(_analisis.Codigo);
            _exito = "Migración completada en TEST. No se modificó producción.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _trabajando = false; }
    }
}
