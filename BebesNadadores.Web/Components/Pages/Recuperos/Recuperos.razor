@page "/recuperos"

@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using BebesNadadores.Application.Recuperos.Dtos
@using BebesNadadores.Domain.Enums


<PageTitle>
    Recuperos | Bebés Nadadores
</PageTitle>


<div class="recovery-page">

    @* =========================================================
       HEADER
       ========================================================= *@

    <header class="recovery-header">

        <div class="header-main">

            <button type="button"
                    class="back-button"
                    title="Volver"
                    @onclick="Volver">

                <MudIcon Icon="@Icons.Material.Filled.ArrowBack"
                         Size="Size.Small" />

            </button>


            <div>

                <span class="page-eyebrow">
                    ASISTENCIA Y RECUPEROS
                </span>

                <h1>
                    Recuperos
                </h1>

                <p>
                    Administrá clases pendientes y lugares
                    liberados para recuperar.
                </p>

            </div>

        </div>


        <div class="header-actions">

            <button type="button"
                    class="secondary-action"
                    @onclick="IrSemanaActual">

                <MudIcon Icon="@Icons.Material.Filled.Today"
                         Size="Size.Small" />

                Esta semana

            </button>


            <button type="button"
                    class="secondary-action"
                    disabled="@_cargando"
                    @onclick="RefrescarAsync">

                <MudIcon Icon="@Icons.Material.Filled.Refresh"
                         Size="Size.Small" />

                Actualizar

            </button>

        </div>

    </header>


    @* =========================================================
       MENSAJES
       ========================================================= *@

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="message-box message-error">

            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline"
                     Size="Size.Small" />

            <span>
                @_error
            </span>


            <button type="button"
                    @onclick="() => _error = null">

                <MudIcon Icon="@Icons.Material.Filled.Close"
                         Size="Size.Small" />

            </button>

        </div>
    }


    @if (!string.IsNullOrWhiteSpace(_mensaje))
    {
        <div class="message-box message-success">

            <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                     Size="Size.Small" />

            <span>
                @_mensaje
            </span>


            <button type="button"
                    @onclick="() => _mensaje = null">

                <MudIcon Icon="@Icons.Material.Filled.Close"
                         Size="Size.Small" />

            </button>

        </div>
    }


    @if (_cargando)
    {
        <div class="page-loading">

            <MudProgressCircular Indeterminate="true"
                                 Size="Size.Large" />

            <span>
                Cargando recuperos...
            </span>

        </div>
    }
    else if (_panel is not null)
    {
        @* =====================================================
           KPIs
           ===================================================== *@

        <section class="recovery-stats">

            <article class="stat-card">

                <div class="stat-icon blue">

                    <MudIcon Icon="@Icons.Material.Filled.Replay" />

                </div>


                <div>

                    <span>
                        Recuperos disponibles
                    </span>

                    <strong>
                        @_panel.Resumen.Disponibles
                    </strong>

                    <small>
                        Pendientes de asignar
                    </small>

                </div>

            </article>


            <article class="stat-card">

                <div class="stat-icon warning">

                    <MudIcon Icon="@Icons.Material.Filled.Schedule" />

                </div>


                <div>

                    <span>
                        Vencen pronto
                    </span>

                    <strong>
                        @_panel.Resumen.VencenProximos
                    </strong>

                    <small>
                        Próximos 7 días
                    </small>

                </div>

            </article>


            <article class="stat-card">

                <div class="stat-icon violet">

                    <MudIcon Icon="@Icons.Material.Filled.EventAvailable" />

                </div>


                <div>

                    <span>
                        Reservados
                    </span>

                    <strong>
                        @_panel.Resumen.Reservados
                    </strong>

                    <small>
                        Ya tienen nueva clase
                    </small>

                </div>

            </article>


            <article class="stat-card">

                <div class="stat-icon green">

                    <MudIcon Icon="@Icons.Material.Filled.EventSeat" />

                </div>


                <div>

                    <span>
                        Lugares liberados
                    </span>

                    <strong>
                        @LugaresDisponiblesVisibles
                    </strong>

                    <small>
                        Por ausencias con aviso
                    </small>

                </div>

            </article>

        </section>


        @* =====================================================
           NAVEGACIÓN SEMANA
           ===================================================== *@

        <section class="week-toolbar">

            <div class="week-navigation">

                <button type="button"
                        class="week-nav-button"
                        title="Semana anterior"
                        @onclick="SemanaAnterior">

                    <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" />

                </button>


                <div class="week-title">

                    <span>
                        PERÍODO
                    </span>

                    <strong>
                        @TextoSemana
                    </strong>

                </div>


                <button type="button"
                        class="week-nav-button"
                        title="Semana siguiente"
                        @onclick="SemanaSiguiente">

                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />

                </button>

            </div>


            <div class="availability-legend">

                <span>

                    <i class="legend-dot temporary"></i>

                    Lugar liberado por aviso

                </span>


                <span>

                    <i class="legend-dot reserved"></i>

                    Recupero reservado

                </span>

            </div>

        </section>


        @* =====================================================
           CONTENIDO PRINCIPAL
           ===================================================== *@

        <div class="recovery-layout">

            @* =================================================
               LUGARES LIBERADOS
               ================================================= *@

            <section class="vacancies-panel">

                <div class="panel-heading">

                    <div>

                        <span class="section-eyebrow">
                            AGENDA
                        </span>

                        <h2>
                            Lugares para recupero
                        </h2>

                        <p>
                            Lugares temporales liberados por
                            ausencias con aviso.
                        </p>

                    </div>


                    <strong class="panel-counter">
                        @VacantesVisibles.Count
                    </strong>

                </div>


                @if (VacantesVisibles.Count == 0)
                {
                    <div class="empty-state">

                        <div class="empty-icon">

                            <MudIcon Icon="@Icons.Material.Filled.EventAvailable" />

                        </div>


                        <strong>
                            No hay lugares liberados
                        </strong>


                        <span>
                            Cuando un alumno habitual avise que no
                            asistirá, su lugar aparecerá acá para
                            poder asignarlo a un recupero.
                        </span>

                    </div>
                }
                else
                {
                    <div class="vacancy-days">

                        @foreach (var grupo in
                            VacantesVisibles
                                .GroupBy(x => x.Fecha)
                                .OrderBy(x => x.Key))
                        {
                            <section class="vacancy-day">

                                <header class="vacancy-day-header">

                                    <div class="date-block">

                                        <strong>
                                            @grupo.Key.Day.ToString("00")
                                        </strong>

                                        <span>
                                            @ObtenerMesCorto(
                                                grupo.Key.Month)
                                        </span>

                                    </div>


                                    <div class="day-description">

                                        <strong>
                                            @ObtenerNombreDia(
                                                grupo.Key)
                                        </strong>

                                        <span>

                                            @grupo.Count()

                                            @(grupo.Count() == 1
                                                ? " clase con lugar liberado"
                                                : " clases con lugares liberados")

                                        </span>

                                    </div>

                                </header>


                                <div class="vacancy-list">

                                    @foreach (var vacante in
                                        grupo.OrderBy(x =>
                                            x.HoraInicio))
                                    {
                                        <article class="vacancy-card">

                                            <div class="vacancy-main">

                                                @* =====================
                                                   HORARIO
                                                   ===================== *@

                                                <div class="vacancy-time">

                                                    <span>
                                                        HORARIO
                                                    </span>

                                                    <strong>
                                                        @vacante.HoraInicio.ToString("HH:mm")
                                                    </strong>

                                                    <small>

                                                        hasta

                                                        @vacante.HoraFin.ToString("HH:mm")

                                                    </small>

                                                </div>


                                                @* =====================
                                                   INFORMACIÓN
                                                   ===================== *@

                                                <div class="vacancy-info">

                                                    <div class="vacancy-title">

                                                        <strong>
                                                            @vacante.Nivel
                                                        </strong>


                                                        <span class="available-badge">

                                                            @vacante.VacantesParaRecupero

                                                            @(vacante.VacantesParaRecupero == 1
                                                                ? " lugar disponible"
                                                                : " lugares disponibles")

                                                        </span>

                                                    </div>


                                                    @if (vacante.Profesores.Count > 0)
                                                    {
                                                        <div class="vacancy-teacher">

                                                            <MudIcon Icon="@Icons.Material.Filled.Person"
                                                                     Size="Size.Small" />

                                                            <span>

                                                                @string.Join(
                                                                    " · ",
                                                                    vacante.Profesores)

                                                            </span>

                                                        </div>
                                                    }


                                                    <div class="vacancy-capacity">

                                                        <div>

                                                            <span>
                                                                Habituales
                                                            </span>

                                                            <strong>
                                                                @vacante.Regulares / @vacante.Cupo
                                                            </strong>

                                                        </div>


                                                        <div class="capacity-chip temporary">

                                                            <MudIcon Icon="@Icons.Material.Filled.NotificationsOff"
                                                                     Size="Size.Small" />

                                                            @vacante.VacantesLiberadasPorAviso

                                                            @(vacante.VacantesLiberadasPorAviso == 1
                                                                ? " lugar liberado"
                                                                : " lugares liberados")

                                                        </div>


                                                        @if (vacante.RecuperosReservados > 0)
                                                        {
                                                            <div class="capacity-chip reserved">

                                                                <MudIcon Icon="@Icons.Material.Filled.Replay"
                                                                         Size="Size.Small" />

                                                                @vacante.RecuperosReservados

                                                                @(vacante.RecuperosReservados == 1
                                                                    ? " recupero reservado"
                                                                    : " recuperos reservados")

                                                            </div>
                                                        }

                                                    </div>

                                                </div>


                                                @* =====================
                                                   ACCIÓN
                                                   ===================== *@

                                                <button type="button"
                                                        class="manage-vacancy-button"
                                                        @onclick="() => AbrirCandidatosAsync(vacante)">

                                                    <MudIcon Icon="@Icons.Material.Filled.Groups"
                                                             Size="Size.Small" />

                                                    Gestionar

                                                </button>

                                            </div>


                                            <div class="capacity-track">

                                                <div class="capacity-track-value"
                                                     style="@ObtenerEstiloOcupacion(vacante)">
                                                </div>

                                            </div>

                                        </article>
                                    }

                                </div>

                            </section>
                        }

                    </div>
                }

            </section>


            @* =================================================
               RECUPEROS ACTIVOS
               ================================================= *@

            <aside class="recoveries-panel">

                <div class="panel-heading recovery-panel-heading">

                    <div>

                        <span class="section-eyebrow">
                            PENDIENTES
                        </span>

                        <h2>
                            Recuperos activos
                        </h2>

                    </div>


                    <strong class="panel-counter">
                        @RecuperosFiltrados.Count
                    </strong>

                </div>


                <div class="recovery-search">

                    <MudIcon Icon="@Icons.Material.Filled.Search"
                             Size="Size.Small" />

                    <input type="text"
                           placeholder="Buscar bebé o nivel..."
                           @bind="_busqueda"
                           @bind:event="oninput" />

                </div>


                @if (RecuperosFiltrados.Count == 0)
                {
                    <div class="empty-state compact">

                        <div class="empty-icon">

                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />

                        </div>


                        <strong>
                            Sin recuperos pendientes
                        </strong>


                        <span>
                            No hay recuperos que coincidan
                            con la búsqueda.
                        </span>

                    </div>
                }
                else
                {
                    <div class="recoveries-list">

                        @foreach (var recupero in RecuperosFiltrados)
                        {
                            var reservado =
                                recupero.Estado ==
                                    EstadoRecuperacion.Reservada;


                            <article class="recovery-card @(reservado ? "reserved" : "")">

                                <div class="recovery-card-top">

                                    <div class="recovery-avatar">
                                        @ObtenerIniciales(
                                            recupero.Bebe)
                                    </div>


                                    <div class="recovery-person">

                                        <strong>
                                            @recupero.Bebe
                                        </strong>

                                        <span>
                                            @recupero.NivelOrigen
                                        </span>

                                    </div>


                                    <span class="recovery-status @(reservado ? "reserved" : "available")">

                                        @(reservado
                                            ? "RESERVADO"
                                            : "DISPONIBLE")

                                    </span>

                                </div>


                                <div class="recovery-origin">

                                    <span>
                                        ORIGEN
                                    </span>

                                    <strong>

                                        @recupero.FechaOrigen.ToString("dd/MM/yyyy")

                                        ·

                                        @recupero.HoraOrigen.ToString("HH:mm")

                                    </strong>

                                </div>


                                <div class="recovery-meta">

                                    <span>

                                        <MudIcon Icon="@Icons.Material.Filled.Replay"
                                                 Size="Size.Small" />

                                        @ObtenerTipoRecuperoTexto(
                                            recupero.Tipo)

                                    </span>


                                    <span class="@ObtenerClaseVencimiento(recupero)">

                                        <MudIcon Icon="@Icons.Material.Filled.Schedule"
                                                 Size="Size.Small" />

                                        @ObtenerTextoVencimiento(
                                            recupero)

                                    </span>

                                </div>


                                @if (reservado &&
                                     recupero.FechaUso.HasValue &&
                                     recupero.HoraUso.HasValue)
                                {
                                    <div class="reservation-detail">

                                        <MudIcon Icon="@Icons.Material.Filled.EventAvailable"
                                                 Size="Size.Small" />

                                        <div>

                                            <span>
                                                Nueva clase
                                            </span>

                                            <strong>

                                                @recupero.FechaUso.Value.ToString("dd/MM/yyyy")

                                                ·

                                                @recupero.HoraUso.Value.ToString("HH:mm")

                                            </strong>

                                        </div>

                                    </div>


                                    <button type="button"
                                            class="release-button"
                                            disabled="@(_liberandoId == recupero.RecuperacionId)"
                                            @onclick="() => LiberarReservaAsync(recupero)">

                                        @if (_liberandoId ==
                                             recupero.RecuperacionId)
                                        {
                                            <MudProgressCircular Indeterminate="true"
                                                                 Size="Size.Small" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Undo"
                                                     Size="Size.Small" />
                                        }

                                        Liberar reserva

                                    </button>
                                }

                            </article>
                        }

                    </div>
                }

            </aside>

        </div>
    }

</div>


@* =============================================================
   MODAL CANDIDATOS
   ============================================================= *@

@if (_sesionSeleccionada is not null)
{
    <div class="modal-backdrop"
         @onclick="CerrarCandidatos">

        <div class="candidates-modal"
             @onclick:stopPropagation="true">

            <header class="modal-header">

                <div>

                    <span class="modal-eyebrow">
                        ASIGNAR RECUPERO
                    </span>

                    <h2>
                        @_sesionSeleccionada.Nivel
                    </h2>

                    <p>

                        @ObtenerNombreDia(
                            _sesionSeleccionada.Fecha)

                        @_sesionSeleccionada.Fecha.ToString("dd/MM")

                        ·

                        @_sesionSeleccionada.HoraInicio.ToString("HH:mm")

                        —

                        @_sesionSeleccionada.HoraFin.ToString("HH:mm")

                    </p>

                </div>


                <button type="button"
                        class="modal-close"
                        @onclick="CerrarCandidatos">

                    <MudIcon Icon="@Icons.Material.Filled.Close" />

                </button>

            </header>


            @* =================================================
               RESUMEN DISPONIBILIDAD
               ================================================= *@

            <div class="modal-availability">

                <div>

                    <span>
                        DISPONIBLES
                    </span>

                    <strong>
                        @_sesionSeleccionada.VacantesParaRecupero
                    </strong>

                </div>


                <div>

                    <span>
                        LIBERADOS POR AVISO
                    </span>

                    <strong>
                        @_sesionSeleccionada.VacantesLiberadasPorAviso
                    </strong>

                </div>


                <div>

                    <span>
                        RECUPEROS RESERVADOS
                    </span>

                    <strong>
                        @_sesionSeleccionada.RecuperosReservados
                    </strong>

                </div>

            </div>


            @if (!string.IsNullOrWhiteSpace(_errorModal))
            {
                <div class="modal-error">

                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline"
                             Size="Size.Small" />

                    @_errorModal

                </div>
            }


            @* =================================================
               CANDIDATOS
               ================================================= *@

            <div class="candidates-heading">

                <div>

                    <span>
                        CANDIDATOS COMPATIBLES
                    </span>

                    <h3>
                        Recuperos disponibles
                    </h3>

                </div>


                <strong>
                    @_candidatos.Count
                </strong>

            </div>


            @if (_cargandoCandidatos)
            {
                <div class="modal-loading">

                    <MudProgressCircular Indeterminate="true"
                                         Size="Size.Medium" />

                    <span>
                        Buscando candidatos...
                    </span>

                </div>
            }
            else if (_candidatos.Count == 0)
            {
                <div class="empty-candidates">

                    <MudIcon Icon="@Icons.Material.Filled.PersonOff" />

                    <strong>
                        No hay candidatos compatibles
                    </strong>

                    <span>
                        No encontramos bebés del mismo nivel
                        con recuperos disponibles para esta fecha.
                    </span>

                </div>
            }
            else
            {
                <div class="candidates-list">

                    @foreach (var candidato in _candidatos)
                    {
                        <article class="candidate-card">

                            <div class="candidate-avatar">

                                @ObtenerIniciales(
                                    candidato.Bebe)

                            </div>


                            <div class="candidate-info">

                                <div class="candidate-name">

                                    <strong>
                                        @candidato.Bebe
                                    </strong>


                                    @if (candidato.CoincidePreferencia)
                                    {
                                        <span class="preference-match">
                                            PREFERENCIA
                                        </span>
                                    }

                                </div>


                                <div class="candidate-origin">

                                    Recupero originado

                                    @candidato.FechaOrigen.ToString("dd/MM/yyyy")

                                </div>


                                <div class="candidate-meta">

                                    <span class="@ObtenerClaseVencimiento(candidato)">

                                        <MudIcon Icon="@Icons.Material.Filled.Schedule"
                                                 Size="Size.Small" />

                                        @ObtenerTextoVencimiento(
                                            candidato)

                                    </span>


                                    @if (!string.IsNullOrWhiteSpace(
                                        candidato.Preferencia))
                                    {
                                        <span>

                                            <MudIcon Icon="@Icons.Material.Filled.Tune"
                                                     Size="Size.Small" />

                                            @candidato.Preferencia

                                        </span>
                                    }

                                </div>

                            </div>


                            <button type="button"
                                    class="reserve-button"
                                    disabled="@(_reservandoId.HasValue)"
                                    @onclick="() => ReservarAsync(candidato)">

                                @if (_reservandoId ==
                                     candidato.RecuperacionId)
                                {
                                    <MudProgressCircular Indeterminate="true"
                                                         Size="Size.Small" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Check"
                                             Size="Size.Small" />
                                }

                                Reservar

                            </button>

                        </article>
                    }

                </div>
            }

        </div>

    </div>
}