@page "/recuperos"



@attribute [Authorize(Policy = PoliticasSistema.GestionAdministrativa)]



@using BebesNadadores.Application.Recuperos.Dtos

@using BebesNadadores.Domain.Enums





<PageTitle>

    Recuperos | Bebés Nadadores

</PageTitle>





<div class="recovery-page">



    @* HEADER *@



    <header class="recovery-header">



        <div class="header-main">



            <button type="button"

                    class="back-button"

                    title="Volver"

                    @onclick="Volver">



                <MudIcon Icon="@Icons.Material.Filled.ArrowBack"

                         Size="Size.Small" />



            </button>





            <div>



                <span class="page-eyebrow">

                    ASISTENCIA Y RECUPEROS

                </span>



                <h1>

                    Recuperos

                </h1>



                <p>

                    Administrá clases pendientes y lugares

                    liberados para recuperar.

                </p>



            </div>



        </div>





        <AuthorizeView Policy="@PoliticasSistema.SoloAdministrador">
            <Authorized>
                <a class="secondary-action" href="/recuperos/regularizacion" style="text-decoration:none;align-self:center">Regularizar recuperos históricos</a>
            </Authorized>
        </AuthorizeView>

        <a href="/lista-espera" class="secondary-action" style="text-decoration:none;align-self:center">
            Lista para recuperos
        </a>

        <div class="header-actions">



            <button type="button"

                    class="secondary-action"

                    @onclick="IrSemanaActual">



                <MudIcon Icon="@Icons.Material.Filled.Today"

                         Size="Size.Small" />



                Esta semana



            </button>





            <button type="button"

                    class="secondary-action"

                    disabled="@_cargando"

                    @onclick="RefrescarAsync">



                <MudIcon Icon="@Icons.Material.Filled.Refresh"

                         Size="Size.Small" />



                Actualizar



            </button>



        </div>



    </header>

    @if (!_cargando && _primerasPendientes.Count > 0)
    {
        <details class="primeras-pendientes-panel">
            <summary>
                <MudIcon Icon="@Icons.Material.Filled.EventRepeat" Size="Size.Small" />
                <strong>Primeras clases pendientes de reprogramación (@_primerasPendientes.Count)</strong>
            </summary>
            <p>Estas clases no son recuperos habituales. Abrí el legajo para elegir una nueva fecha sin generar otra cuota.</p>
            <div class="primeras-pendientes-list">
                @foreach (var primeraPendiente in _primerasPendientes)
                {
                    <article class="primera-pendiente-row">
                        <div>
                            <strong>@primeraPendiente.Nombre</strong>
                            <small>@primeraPendiente.Nivel · Ausente con aviso: @primeraPendiente.Fecha.ToString("dd/MM/yyyy") · @primeraPendiente.Hora.ToString("HH:mm")</small>
                        </div>
                        <a class="secondary-action" href="@($"/clientes/{primeraPendiente.BebeId}?tab=inscripcion")">Reprogramar desde legajo</a>
                    </article>
                }
            </div>
        </details>
    }






    @* MENSAJES *@



    @if (!string.IsNullOrWhiteSpace(_error))

    {

        <div class="message-box message-error">



            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline"

                     Size="Size.Small" />



            <span>

                @_error

            </span>





            <button type="button"

                    @onclick="() => _error = null">



                <MudIcon Icon="@Icons.Material.Filled.Close"

                         Size="Size.Small" />



            </button>



        </div>

    }





    @if (!string.IsNullOrWhiteSpace(_mensaje))

    {

        <div class="message-box message-success">



            <MudIcon Icon="@Icons.Material.Filled.CheckCircle"

                     Size="Size.Small" />



            <span>

                @_mensaje

            </span>





            <button type="button"

                    @onclick="() => _mensaje = null">



                <MudIcon Icon="@Icons.Material.Filled.Close"

                         Size="Size.Small" />



            </button>



        </div>

    }





    @if (_cargando)

    {

        <div class="page-loading">



            <MudProgressCircular Indeterminate="true"

                                 Size="Size.Large" />



            <span>

                Cargando recuperos...

            </span>



        </div>

    }

    else if (_panel is not null)

    {

        @* KPIs *@



        <section class="recovery-stats">



            <article class="stat-card">



                <div class="stat-icon blue">



                    <MudIcon Icon="@Icons.Material.Filled.Replay" />



                </div>





                <div>



                    <span>

                        Recuperos disponibles

                    </span>



                    <strong>

                        @_panel.Resumen.Disponibles

                    </strong>



                    <small>

                        Pendientes de asignar

                    </small>



                </div>



            </article>





            <article class="stat-card">



                <div class="stat-icon warning">



                    <MudIcon Icon="@Icons.Material.Filled.Schedule" />



                </div>





                <div>



                    <span>

                        Vencen pronto

                    </span>



                    <strong>

                        @_panel.Resumen.VencenProximos

                    </strong>



                    <small>

                        Próximos 7 días

                    </small>



                </div>



            </article>





            <article class="stat-card">



                <div class="stat-icon violet">



                    <MudIcon Icon="@Icons.Material.Filled.EventAvailable" />



                </div>





                <div>



                    <span>

                        Reservados

                    </span>



                    <strong>

                        @_panel.Resumen.Reservados

                    </strong>



                    <small>

                        Ya tienen nueva clase

                    </small>



                </div>



            </article>





            <article class="stat-card">



                <div class="stat-icon green">



                    <MudIcon Icon="@Icons.Material.Filled.EventSeat" />



                </div>





                <div>



                    <span>

                        Lugares disponibles



                    </span>



                    <strong>

                        @LugaresDisponiblesVisibles

                    </strong>



                    <small>

                        para recuperos

                    </small>



                </div>



            </article>



        </section>





        @* NAVEGACIÓN SEMANA *@



        <section class="week-toolbar">



            <div class="week-navigation">



                <button type="button"

                        class="week-nav-button"

                        title="Semana anterior"

                        @onclick="SemanaAnterior">



                    <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" />



                </button>





                <div class="week-title">



                    <span>

                        @(BusquedaAmpliada ? "BÚSQUEDA AMPLIADA" : "PERÍODO SEMANAL")

                    </span>



                    <strong>

                        @(BusquedaAmpliada ? $"{Hoy:dd/MM} — {FinBusqueda:dd/MM/yyyy}" : TextoSemana)

                    </strong>



                </div>





                <button type="button"

                        class="week-nav-button"

                        title="Semana siguiente"

                        @onclick="SemanaSiguiente">



                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />



                </button>



            </div>





            @if (RecuperoSeleccionado is not null)
            {
                <button type="button" class="secondary-action" disabled="@_cargandoCompatibles" @onclick="CambiarAlcanceAsync">
                    @(BusquedaAmpliada ? "Ver por semana" : "Buscar hasta vencimiento")
                </button>
            }
            <div class="availability-legend">


                <span>

                    <i class="legend-dot free-capacity"></i>

                    Vacante libre

                </span>


                <span>



                    <i class="legend-dot temporary"></i>



                    Lugar liberado por aviso



                </span>





                <span>



                    <i class="legend-dot reserved"></i>



                    Recupero reservado



                </span>



            </div>



        </section>





        @* CONTENIDO PRINCIPAL *@



        <div class="recovery-layout">



            @* LUGARES LIBERADOS *@



            <section class="vacancies-panel">



                <div class="panel-heading">



                    <div>



                        <span class="section-eyebrow">

                            AGENDA

                        </span>



                        <h2>

                            Lugares para recupero

                        </h2>



                        <p>

                            Clases compatibles para asignar recuperos, con cupo informativo,

                            incluyendo vacantes libres y lugares liberados por aviso.

                        </p>



                    </div>





                    <strong class="panel-counter">

                        @VacantesVisibles.Count

                    </strong>



                </div>





                <div class="recovery-filters">

                    <div class="recovery-filter">

                        <label>
                            NIVEL
                        </label>

                        <select value="@(_nivelFiltroId?.ToString() ?? "")"
                                @onchange="CambiarNivelFiltro">

                            <option value="">
                                Todos los niveles
                            </option>

                            @foreach (var nivel in NivelesDisponibles)
                            {
                                <option value="@nivel.Id">
                                    @nivel.Nombre
                                </option>
                            }

                        </select>

                    </div>


                    <div class="recovery-filter recovery-filter-baby">
                       <label>CONSULTAR RECUPEROS DE UN ALUMNO</label>
                       <MudAutocomplete T="RecuperoAlumnoOpcion"
                                        Value="@_alumnoSeleccionado"
                                        ValueChanged="@SeleccionarAlumnoAutocompleteAsync"
                                        SearchFunc="@BuscarAlumnosRecuperosAsync"
                                        ToStringFunc="@TextoAlumnoRecuperos"
                                        Variant="Variant.Outlined"
                                        Margin="Margin.Dense"
                                        Dense="true"
                                        Clearable="true"
                                        ResetValueOnEmptyText="true"
                                        FullWidth="true"
                                        DebounceInterval="200"
                                        MinCharacters="0"
                                        MaxItems="50"
                                        Adornment="Adornment.Start"
                                        AdornmentIcon="@Icons.Material.Filled.Search"
                                        Placeholder="Buscar bebé por nombre o apellido..."
                                        Class="recovery-autocomplete" />
                   </div>

                </div>


                <div class="recovery-filters">
                    <div class="recovery-filter">
                        <label>DÍA</label>
                        <select @bind="_diaFiltro">
                            <option value="">Todos los días</option>
                            <option value="1">Lunes</option>
                            <option value="2">Martes</option>
                            <option value="3">Miércoles</option>
                            <option value="4">Jueves</option>
                            <option value="5">Viernes</option>
                            <option value="6">Sábado</option>
                            <option value="0">Domingo</option>
                        </select>
                    </div>
                    <div class="recovery-filter">
                        <label>HORARIO</label>
                        <select @bind="_horaFiltro">
                            <option value="">Todos los horarios</option>
                            @foreach (var hora in HorariosDisponibles)
                            {
                                <option value="@(hora.ToString("HH:mm"))">@hora.ToString("HH:mm")</option>
                            }
                        </select>
                    </div>
                </div>
                @if (RecuperoSeleccionado is not null)
                {
                    var recuperoSeleccionado =
                        RecuperoSeleccionado;

                    @if (RecuperosDelBebe.Count > 0)
                    {
                        <div class="recovery-credits-panel" style="margin:10px 0;padding:14px;border:1px solid var(--mud-palette-lines-default);border-radius:12px">
                            <div class="recovery-credits-heading">
                                <div>
                                    <strong>Recuperos disponibles de @recuperoSeleccionado.Bebe (@RecuperosDelBebe.Count)</strong>
                                    <p>Estas son todas las clases pendientes de este alumno. Elegí cuál querés asignar.</p>
                                </div>
                                <button type="button" class="secondary-action recovery-whatsapp"
                                        @onclick="() => RecordarRecuperosWhatsAppAsync(recuperoSeleccionado.BebeId)">
                                    <MudIcon Icon="@Icons.Material.Filled.Message" Size="Size.Small" />
                                    Recordar por WhatsApp
                                </button>
                            </div>
                            <div style="display:flex;gap:8px;flex-wrap:wrap">
                                @foreach (var credito in RecuperosDelBebe)
                                {
                                    <button type="button" class="@(_recuperacionSeleccionadaId == credito.RecuperacionId ? "primary-action" : "secondary-action")"
                                            @onclick="() => ElegirRecuperoAsync(credito.RecuperacionId)">
                                        @ObtenerTipoRecuperoTexto(credito.Tipo): @credito.FechaOrigen.ToString("dd/MM/yyyy")
                                        @if (credito.Tipo != TipoRecuperacion.SaldoHistoricoVerificado)
                                        {
                                            <span> · @credito.HoraOrigen.ToString("HH:mm")</span>
                                        }
                                        · @ObtenerTextoVencimiento(credito)
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    <div style="margin:8px 0;font-size:0.9rem">
                        @if (BusquedaAmpliada)
                        {
                            <span>Buscando desde hoy hasta @FinBusqueda.ToString("dd/MM/yyyy").</span>
                            @if (!recuperoSeleccionado.FechaVencimiento.HasValue)
                            {
                                <span> (Próximos 60 días; crédito sin vencimiento.)</span>
                            }
                        }
                        else
                        {
                            <span>Consultando únicamente la semana seleccionada.</span>
                        }
                    </div>
                    <div class="selected-recovery">

                        <div class="selected-recovery-main">

                            <div class="selected-recovery-avatar">
                                @ObtenerIniciales(
                                    recuperoSeleccionado.Bebe)
                            </div>


                            <div class="selected-recovery-info">

                                <span>
                                    BUSCANDO CLASE PARA
                                </span>

                                <strong>
                                    @recuperoSeleccionado.Bebe
                                </strong>

                                <small>
                                    @recuperoSeleccionado.NivelOrigen
                                    · @(recuperoSeleccionado.Tipo == TipoRecuperacion.SaldoHistoricoVerificado ? "acreditado" : "origen")
                                    @recuperoSeleccionado.FechaOrigen.ToString("dd/MM/yyyy")
                                    ·
                                    @ObtenerTextoVencimiento(recuperoSeleccionado)
                                </small>

                            </div>

                        </div>


                        <div class="selected-recovery-preference">

                            <div class="preference-state @(_respetarDiaPreferido ? "active" : "open")">

                                <MudIcon Icon="@(_respetarDiaPreferido
                                    ? Icons.Material.Filled.FilterAlt
                                    : Icons.Material.Filled.FilterAltOff)"
                                         Size="Size.Small" />

                                <div>

                                    <strong>
                                        @(_respetarDiaPreferido
                                            ? "Preferencias aplicadas"
                                            : "Sin restricciones de preferencia")
                                    </strong>

                                    <span>
                                        @(_respetarDiaPreferido
                                            ? "Sólo se muestran opciones que respetan la preferencia."
                                            : "Las preferencias de día y franja horaria están desactivadas.")
                                    </span>

                                </div>

                            </div>


                            <button type="button"
                                    class="preference-toggle"
                                    disabled="@_cargandoCompatibles"
                                    @onclick="CambiarRestriccionDia">

                                @if (_respetarDiaPreferido)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Visibility"
                                             Size="Size.Small" />

                                    <span>
                                        Ver todos los días y horarios
                                    </span>
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.FilterAlt"
                                             Size="Size.Small" />

                                    <span>
                                        Respetar preferencias
                                    </span>
                                }

                            </button>


                            <button type="button"
                                    class="clear-selection-button"
                                    @onclick="LimpiarRecuperoSeleccionado">

                                <MudIcon Icon="@Icons.Material.Filled.Close"
                                         Size="Size.Small" />

                                Limpiar

                            </button>

                        </div>

                    </div>
                }


                @if (_cargandoCompatibles)
                {
                    <div class="page-loading">

                        <MudProgressCircular Indeterminate="true"
                                             Size="Size.Medium" />

                        <span>
                            Buscando clases compatibles...
                        </span>

                    </div>
                }
                else if (VacantesVisibles.Count == 0)

                {

                    <div class="empty-state">



                        <div class="empty-icon">



                            <MudIcon Icon="@Icons.Material.Filled.EventAvailable" />



                        </div>





                        <strong>

                            No hay lugares disponibles

                        </strong>





                        <span>

                            @if (BusquedaAmpliada)
                            {
                                <span>No se encontraron clases compatibles con disponibilidad en el rango consultado y con los filtros actuales.</span>
                            }
                            else
                            {
                                <span>No hay clases compatibles para recuperos en esta semana.</span>
                            }

                        </span>
                        @if (!BusquedaAmpliada)
                        {
                            <button type="button" class="secondary-action" @onclick="SemanaSiguiente">
                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                                Consultar semana siguiente
                            </button>
                        }



                    </div>

                }

                else

                {

                    <div class="vacancy-days">



                        @foreach (var grupo in

                            VacantesVisibles

                                .GroupBy(x => x.Fecha)

                                .OrderBy(x => x.Key))

                        {

                            <section class="vacancy-day">



                                <header class="vacancy-day-header">



                                    <div class="date-block">



                                        <strong>

                                            @grupo.Key.Day.ToString("00")

                                        </strong>



                                        <span>

                                            @ObtenerMesCorto(

                                                grupo.Key.Month)

                                        </span>



                                    </div>





                                    <div class="day-description">



                                        <strong>

                                            @ObtenerNombreDia(

                                                grupo.Key)

                                        </strong>



                                        <span>



                                            @grupo.Count()



                                            @(grupo.Count() == 1

                                                ? " clase disponible para recupero"

                                                : " clases disponibles para recupero")



                                        </span>



                                    </div>



                                </header>





                                <div class="vacancy-list">



                                    @foreach (var vacante in

                                        grupo.OrderBy(x =>

                                            x.HoraInicio))

                                    {

                                        <article class="vacancy-card">



                                            <div class="vacancy-main">



                                                @* HORARIO *@



                                                <div class="vacancy-time">



                                                    <span>

                                                        HORARIO

                                                    </span>



                                                    <strong>

                                                        @vacante.HoraInicio.ToString("HH:mm")

                                                    </strong>



                                                    <small>



                                                        hasta



                                                        @vacante.HoraFin.ToString("HH:mm")



                                                    </small>



                                                </div>





                                                @* INFORMACIÓN *@



                                                <div class="vacancy-info">



                                                    <div class="vacancy-title">



                                                        <strong>

                                                            @vacante.Nivel

                                                        </strong>





                                                        <span class="available-badge">



                                                            @vacante.VacantesParaRecupero



                                                            @(vacante.VacantesParaRecupero == 1

                                                                ? " lugar disponible"

                                                                : " lugares disponibles")



                                                        </span>



                                                    </div>





                                                    @if (vacante.Profesores.Count > 0)

                                                    {

                                                        <div class="vacancy-teacher">



                                                            <MudIcon Icon="@Icons.Material.Filled.Person"

                                                                     Size="Size.Small" />



                                                            <span>



                                                                @string.Join(

                                                                    " · ",

                                                                    vacante.Profesores)



                                                            </span>



                                                        </div>

                                                    }





                                                    @if (vacante.ConSobrecupoPermitido)
                                                    {
                                                        <div class="overcapacity-recovery-warning" role="status">
                                                            Clase completa o excedida ·
                                                            @vacante.OcupacionActual / @vacante.Cupo alumnos (cupo informativo)
                                                        </div>
                                                    }
                                                    <div class="vacancy-capacity">



                                                        <div>



                                                            <span>

                                                                Habituales

                                                            </span>



                                                            <strong>

                                                                @vacante.Regulares / @vacante.Cupo

                                                            </strong>



                                                        </div>





                                                        @if (vacante.ClaseInicial > 0)
                                                        {
                                                            <div class="capacity-chip reserved">

                                                                <MudIcon Icon="@Icons.Material.Filled.ChildCare"
                                                                         Size="Size.Small" />

                                                                @vacante.ClaseInicial

                                                                @(vacante.ClaseInicial == 1
                                                                    ? " clase inicial"
                                                                    : " clases iniciales")

                                                            </div>
                                                        }


                                                        @if (vacante.VacantesFijas > 0)
                                                        {
                                                            <div class="capacity-chip free-capacity">

                                                                <MudIcon Icon="@Icons.Material.Filled.EventSeat"
                                                                         Size="Size.Small" />

                                                                @vacante.VacantesFijas

                                                                @(vacante.VacantesFijas == 1
                                                                    ? " vacante libre"
                                                                    : " vacantes libres")

                                                            </div>
                                                        }


                                                        @if (vacante.VacantesLiberadasPorAviso > 0)
                                                        {
                                                            <div class="capacity-chip temporary">

                                                                <MudIcon Icon="@Icons.Material.Filled.NotificationsOff"
                                                                         Size="Size.Small" />

                                                                @vacante.VacantesLiberadasPorAviso

                                                                @(vacante.VacantesLiberadasPorAviso == 1
                                                                    ? " lugar liberado"
                                                                    : " lugares liberados")

                                                            </div>
                                                        }





                                                        @if (vacante.RecuperosReservados > 0)

                                                        {

                                                            <div class="capacity-chip reserved">



                                                                <MudIcon Icon="@Icons.Material.Filled.Replay"

                                                                         Size="Size.Small" />



                                                                @vacante.RecuperosReservados



                                                                @(vacante.RecuperosReservados == 1

                                                                    ? " recupero reservado"

                                                                    : " recuperos reservados")



                                                            </div>

                                                        }



                                                    </div>



                                                </div>





                                                @* ACCIÓN *@



                                                @if (RecuperoSeleccionado is not null)
                                                {
                                                    <button type="button"
                                                            class="assign-direct-button"
                                                            disabled="@(_reservandoId.HasValue)"
                                                            @onclick="() => ReservarSeleccionadoAsync(vacante)">

                                                        @if (_reservandoId ==
                                                            RecuperoSeleccionado.RecuperacionId)
                                                        {
                                                            <MudProgressCircular Indeterminate="true"
                                                                                 Size="Size.Small" />
                                                        }
                                                        else
                                                        {
                                                            <MudIcon Icon="@Icons.Material.Filled.Check"
                                                                     Size="Size.Small" />
                                                        }

                                                        Asignar

                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button"
                                                            class="manage-vacancy-button"
                                                            @onclick="() => AbrirCandidatosAsync(vacante)">

                                                        <MudIcon Icon="@Icons.Material.Filled.Groups"
                                                                 Size="Size.Small" />

                                                        Gestionar

                                                    </button>
                                                }



                                            </div>





                                            <div class="capacity-track">



                                                <div class="capacity-track-value"

                                                     style="@ObtenerEstiloOcupacion(vacante)">

                                                </div>



                                            </div>



                                        </article>

                                    }



                                </div>



                            </section>

                        }



                    </div>

                }



            </section>





            @* RECUPEROS ACTIVOS *@



            <aside class="recoveries-panel">



                <div class="panel-heading recovery-panel-heading">



                    <div>



                        <span class="section-eyebrow">

                            PENDIENTES

                        </span>



                        <h2>

                            Recuperos activos

                        </h2>



                    </div>





                    <strong class="panel-counter">

                        @RecuperosFiltrados.Count

                    </strong>



                </div>





                <div class="recovery-search">



                    <MudIcon Icon="@Icons.Material.Filled.Search"

                             Size="Size.Small" />



                    <input type="text"

                           placeholder="Buscar bebé o nivel..."

                           @bind="_busqueda"

                           @bind:event="oninput" />



                </div>





                @if (RecuperosFiltrados.Count == 0)

                {

                    <div class="empty-state compact">



                        <div class="empty-icon">



                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />



                        </div>





                        <strong>

                            Sin recuperos pendientes

                        </strong>





                        <span>

                            No hay recuperos que coincidan

                            con la búsqueda.

                        </span>



                    </div>

                }

                else

                {

                    <div class="recoveries-list">



                        @foreach (var recupero in RecuperosFiltrados)

                        {

                            var reservado =

                                recupero.Estado ==

                                    EstadoRecuperacion.Reservada;





                            <article class="recovery-card @(reservado ? "reserved" : "")">



                                <div class="recovery-card-top">



                                    <div class="recovery-avatar">

                                        @ObtenerIniciales(

                                            recupero.Bebe)

                                    </div>





                                    <div class="recovery-person">



                                        <strong>

                                            @recupero.Bebe

                                        </strong>



                                        <span>

                                            @recupero.NivelOrigen

                                        </span>



                                    </div>





                                    <span class="recovery-status @(reservado ? "reserved" : "available")">



                                        @(reservado

                                            ? "RESERVADO"

                                            : "DISPONIBLE")



                                    </span>



                                </div>





                                <div class="recovery-origin">



                                    <span>

                                        @(recupero.Tipo == TipoRecuperacion.SaldoHistoricoVerificado ? "SALDO HISTÓRICO · ACREDITACIÓN" : ObtenerTipoRecuperoTexto(recupero.Tipo).ToUpperInvariant())

                                    </span>



                                    <strong>



                                        @recupero.FechaOrigen.ToString("dd/MM/yyyy")
                                        @if (recupero.Tipo != TipoRecuperacion.SaldoHistoricoVerificado)
                                        {
                                            <span> · @recupero.HoraOrigen.ToString("HH:mm")</span>
                                        }



                                    </strong>



                                </div>





                                <div class="recovery-meta">



                                    <span>



                                        <MudIcon Icon="@Icons.Material.Filled.Replay"

                                                 Size="Size.Small" />



                                        @ObtenerTipoRecuperoTexto(

                                            recupero.Tipo)



                                    </span>





                                    <span class="@ObtenerClaseVencimiento(recupero)">



                                        <MudIcon Icon="@Icons.Material.Filled.Schedule"

                                                 Size="Size.Small" />



                                        @ObtenerTextoVencimiento(

                                            recupero)



                                    </span>



                                </div>





                                @if (reservado &&

                                     recupero.FechaUso.HasValue &&

                                     recupero.HoraUso.HasValue)

                                {

                                    <div class="reservation-detail">



                                        <MudIcon Icon="@Icons.Material.Filled.EventAvailable"

                                                 Size="Size.Small" />



                                        <div>



                                            <span>

                                                Nueva clase

                                            </span>



                                            <strong>



                                                @recupero.FechaUso.Value.ToString("dd/MM/yyyy")



                                                ·



                                                @recupero.HoraUso.Value.ToString("HH:mm")



                                            </strong>



                                        </div>



                                    </div>





                                    <button type="button"

                                            class="release-button"

                                            disabled="@(_liberandoId == recupero.RecuperacionId)"

                                            @onclick="() => LiberarReservaAsync(recupero)">



                                        @if (_liberandoId ==

                                             recupero.RecuperacionId)

                                        {

                                            <MudProgressCircular Indeterminate="true"

                                                                 Size="Size.Small" />

                                        }

                                        else

                                        {

                                            <MudIcon Icon="@Icons.Material.Filled.Undo"

                                                     Size="Size.Small" />

                                        }



                                        Liberar reserva



                                    </button>

                                }
                                else
                                {
                                    <button type="button" class="secondary-action recovery-whatsapp"
                                            title="Abrir WhatsApp con un recordatorio de las clases pendientes de este alumno"
                                            @onclick="() => RecordarRecuperosWhatsAppAsync(recupero.BebeId)">
                                        <MudIcon Icon="@Icons.Material.Filled.Message" Size="Size.Small" />
                                        Recordar recupero
                                    </button>
                                }



                            </article>

                        }



                    </div>

                }



            </aside>



        </div>

    }



</div>





@* MODAL CANDIDATOS *@



@if (_sesionSeleccionada is not null)

{

    <div class="modal-backdrop"

         @onclick="CerrarCandidatos">



        <div class="candidates-modal"

             @onclick:stopPropagation="true">



            <header class="modal-header">



                <div>



                    <span class="modal-eyebrow">

                        ASIGNAR RECUPERO

                    </span>



                    <h2>

                        @_sesionSeleccionada.Nivel

                    </h2>



                    <p>



                        @ObtenerNombreDia(

                            _sesionSeleccionada.Fecha)



                        @_sesionSeleccionada.Fecha.ToString("dd/MM")



                        ·



                        @_sesionSeleccionada.HoraInicio.ToString("HH:mm")



                        —



                        @_sesionSeleccionada.HoraFin.ToString("HH:mm")



                    </p>



                </div>





                <button type="button"

                        class="modal-close"

                        @onclick="CerrarCandidatos">



                    <MudIcon Icon="@Icons.Material.Filled.Close" />



                </button>



            </header>





            @* RESUMEN DISPONIBILIDAD *@



            <div class="modal-availability">



                <div>



                    <span>

                        LUGARES LIBRES (REFERENCIA)

                    </span>



                    <strong>

                        @_sesionSeleccionada.VacantesParaRecupero

                    </strong>



                </div>





                <div>

                    <span>
                        VACANTES LIBRES
                    </span>

                    <strong>
                        @_sesionSeleccionada.VacantesFijas
                    </strong>

                </div>


                <div>



                    <span>

                        LIBERADOS POR AVISO

                    </span>



                    <strong>

                        @_sesionSeleccionada.VacantesLiberadasPorAviso

                    </strong>



                </div>





                <div>



                    <span>

                        RECUPEROS RESERVADOS

                    </span>



                    <strong>

                        @_sesionSeleccionada.RecuperosReservados

                    </strong>



                </div>



            </div>





            @if (!string.IsNullOrWhiteSpace(_errorModal))

            {

                <div class="modal-error">



                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline"

                             Size="Size.Small" />



                    @_errorModal



                </div>

            }





            @* CANDIDATOS *@



            <div class="candidates-heading">



                <div>



                    <span>

                        CANDIDATOS COMPATIBLES

                    </span>



                    <h3>

                        Recuperos disponibles

                    </h3>



                </div>





                <strong>

                    @_candidatos.Count

                </strong>



            </div>





            @if (_cargandoCandidatos)

            {

                <div class="modal-loading">



                    <MudProgressCircular Indeterminate="true"

                                         Size="Size.Medium" />



                    <span>

                        Buscando candidatos...

                    </span>



                </div>

            }

            else if (_candidatos.Count == 0)

            {

                <div class="empty-candidates">



                    <MudIcon Icon="@Icons.Material.Filled.PersonOff" />



                    <strong>

                        No hay candidatos compatibles

                    </strong>



                    <span>

                        No encontramos bebés del mismo nivel

                        con recuperos disponibles para esta fecha.

                    </span>



                </div>

            }

            else

            {

                <div class="candidates-list">



                    @foreach (var candidato in _candidatos)

                    {

                        <article class="candidate-card">



                            <div class="candidate-avatar">



                                @ObtenerIniciales(

                                    candidato.Bebe)



                            </div>





                            <div class="candidate-info">



                                <div class="candidate-name">



                                    <strong>

                                        @candidato.Bebe

                                    </strong>





                                    @if (candidato.CoincidePreferencia)

                                    {

                                        <span class="preference-match">

                                            PREFERENCIA

                                        </span>

                                    }



                                </div>





                                <div class="candidate-origin">



                                    Recupero originado



                                    @candidato.FechaOrigen.ToString("dd/MM/yyyy")



                                </div>





                                <div class="candidate-meta">



                                    <span class="@ObtenerClaseVencimiento(candidato)">



                                        <MudIcon Icon="@Icons.Material.Filled.Schedule"

                                                 Size="Size.Small" />



                                        @ObtenerTextoVencimiento(

                                            candidato)



                                    </span>





                                    @if (!string.IsNullOrWhiteSpace(

                                        candidato.Preferencia))

                                    {

                                        <span>



                                            <MudIcon Icon="@Icons.Material.Filled.Tune"

                                                     Size="Size.Small" />



                                            @candidato.Preferencia



                                        </span>

                                    }



                                </div>



                            </div>





                            <button type="button"

                                    class="reserve-button"

                                    disabled="@(_reservandoId.HasValue)"

                                    @onclick="() => ReservarAsync(candidato)">



                                @if (_reservandoId ==

                                     candidato.RecuperacionId)

                                {

                                    <MudProgressCircular Indeterminate="true"

                                                         Size="Size.Small" />

                                }

                                else

                                {

                                    <MudIcon Icon="@Icons.Material.Filled.Check"

                                             Size="Size.Small" />

                                }



                                Reservar



                            </button>



                        </article>

                    }



                </div>

            }



        </div>



    </div>

}