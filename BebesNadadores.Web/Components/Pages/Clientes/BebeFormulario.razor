
@page "/clientes/nuevo"
@page "/clientes/{BebeId:guid}/editar"

@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using BebesNadadores.Application.Bebes
@using BebesNadadores.Application.Bebes.Dtos
@using BebesNadadores.Application.Niveles
@using BebesNadadores.Application.Niveles.Dtos
@using BebesNadadores.Application.Inscripciones
@using BebesNadadores.Application.Inscripciones.Dtos
@using BebesNadadores.Domain.Enums
@using BebesNadadores.Web.Components.Shared.Utils




<PageTitle>
    @(_editando
        ? "Editar bebé | Bebés Nadadores"
        : "Inscribir bebé | Bebés Nadadores")
</PageTitle>


<div class="enrollment-page">

    @* =========================================================
       HEADER
       ========================================================= *@

    <header class="enrollment-header">

        <div class="enrollment-header-left">

            <button type="button"
                    class="back-button"
                    @onclick="Volver">

                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" />

            </button>


            <div>

                <span class="page-eyebrow">

                    @(_editando
                        ? "EDITAR LEGAJO"
                        : "NUEVA INSCRIPCIÓN")

                </span>


                <h1>

                    @(_editando
                        ? "Editar bebé"
                        : "Inscribir bebé")

                </h1>


                <p>

                    @(_editando
                        ? "Actualizá los datos personales y responsables."
                        : "Registrá al bebé, su familia, plan y horarios semanales.")

                </p>

            </div>

        </div>

    </header>


    @* =========================================================
       CARGANDO
       ========================================================= *@

    @if (_cargando)
    {
        <div class="page-loading">

            <MudProgressCircular Indeterminate="true"
                                 Size="Size.Large" />

            <span>
                Cargando información...
            </span>

        </div>
    }
    else
    {
        @* =====================================================
           ERROR
           ===================================================== *@

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="form-error">

                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline"
                         Size="Size.Small" />

                <span>
                    @_error
                </span>

                <button type="button"
                        @onclick="() => _error = null">

                    <MudIcon Icon="@Icons.Material.Filled.Close"
                             Size="Size.Small" />

                </button>

            </div>
        }


        @* =====================================================
           PRIMERA FILA
           ===================================================== *@

        <div class="enrollment-layout">

            @* =================================================
               01 - DATOS DEL BEBÉ
               ================================================= *@

            <section class="workspace-card baby-data-section">

                <div class="section-heading">

                    <span class="section-number">
                        01
                    </span>


                    <div>

                        <strong>
                            Datos del bebé
                        </strong>

                        <small>
                            Información personal y nivel actual.
                        </small>

                    </div>

                </div>


                <div class="form-grid">

                    @* NOMBRE *@

                    <div class="form-field">

                        <label>
                            Nombre *
                        </label>

                        <input type="text"
                               maxlength="100"
                               autocomplete="off"
                               @bind="_form.Nombre" />

                    </div>


                    @* APELLIDO *@

                    <div class="form-field">

                        <label>
                            Apellido *
                        </label>

                        <input type="text"
                               maxlength="100"
                               autocomplete="off"
                               @bind="_form.Apellido" />

                    </div>


                    @* NACIMIENTO *@

                    <div class="form-field">

                        <label>
                            Fecha de nacimiento *
                        </label>

                       <BnDatePicker @bind-Value="_form.FechaNacimiento" />

                    </div>


                    @* SEXO *@

                    <div class="form-field">

                        <label>
                            Sexo
                        </label>

                        <select @bind="_form.Sexo">

                            @foreach (var sexo in
                                Enum.GetValues<Sexo>())
                            {
                                <option value="@sexo">
                                    @ObtenerSexoTexto(sexo)
                                </option>
                            }

                        </select>

                    </div>


                    @* DNI *@

                    <div class="form-field">

                        <label>
                            DNI
                        </label>

                        <input type="text"
                               maxlength="20"
                               placeholder="Opcional"
                               autocomplete="off"
                               @bind="_form.Dni" />

                    </div>


                    @* NIVEL *@

                    <div class="form-field">

                        <label>
                            Nivel actual *
                        </label>

                        <select @bind="_form.NivelActualId"
                                @bind:after="NivelCambioAsync">

                            <option value="">
                                Seleccionar nivel...
                            </option>

                            @foreach (var nivel in _niveles)
                            {
                                <option value="@nivel.Id">
                                    @nivel.Nombre
                                </option>
                            }

                        </select>

                    </div>

                </div>

            </section>


            @* =================================================
               02 - RESPONSABLES
               ================================================= *@

            <section class="workspace-card responsible-section">

                <div class="section-heading section-heading-actions">

                    <div class="heading-left">

                        <span class="section-number">
                            02
                        </span>


                        <div>

                            <strong>
                                Responsables
                            </strong>

                            <small>
                                Debe existir exactamente un contacto principal.
                            </small>

                        </div>

                    </div>


                    <button type="button"
                            class="add-responsible"
                            @onclick="AgregarResponsable">

                        <MudIcon Icon="@Icons.Material.Filled.Add"
                                 Size="Size.Small" />

                        Agregar

                    </button>

                </div>


                <div class="responsibles-grid">

                    @for (var i = 0;
                          i < _form.Responsables.Count;
                          i++)
                    {
                        var index = i;

                        var responsable =
                            _form.Responsables[index];


                        <article class="responsible-card">

                            <header>

                                <div>

                                    <span>
                                        RESPONSABLE @(index + 1)
                                    </span>


                                    <strong>

                                        @(string.IsNullOrWhiteSpace(
                                            responsable.Nombre)

                                            ? "Nuevo responsable"

                                            : $"{responsable.Nombre} {responsable.Apellido}")

                                    </strong>

                                </div>


                                @if (_form.Responsables.Count > 1)
                                {
                                    <button type="button"
                                            title="Quitar responsable"
                                            @onclick="() => QuitarResponsable(index)">

                                        <MudIcon Icon="@Icons.Material.Filled.DeleteOutline"
                                                 Size="Size.Small" />

                                    </button>
                                }

                            </header>


                            <div class="responsible-fields">

                                @* NOMBRE *@

                                <div class="form-field">

                                    <label>
                                        Nombre *
                                    </label>

                                    <input type="text"
                                           maxlength="100"
                                           autocomplete="off"
                                           @bind="responsable.Nombre" />

                                </div>


                                @* APELLIDO *@

                                <div class="form-field">

                                    <label>
                                        Apellido *
                                    </label>

                                    <input type="text"
                                           maxlength="100"
                                           autocomplete="off"
                                           @bind="responsable.Apellido" />

                                </div>


                                @* RELACIÓN *@

                                <div class="form-field">

                                    <label>
                                        Relación
                                    </label>

                                    <select @bind="responsable.Relacion">

                                        @foreach (var relacion in
                                            Enum.GetValues<RelacionResponsable>())
                                        {
                                            <option value="@relacion">
                                                @ObtenerRelacionTexto(relacion)
                                            </option>
                                        }

                                    </select>

                                </div>


                                @* DNI *@

                                <div class="form-field">

                                    <label>
                                        DNI
                                    </label>

                                    <input type="text"
                                           maxlength="20"
                                           autocomplete="off"
                                           @bind="responsable.Dni" />

                                </div>


                                @* TELÉFONO *@

                                <div class="form-field">

                                    <label>
                                        Teléfono
                                    </label>

                                    <input type="tel"
                                           maxlength="50"
                                           autocomplete="off"
                                           @bind="responsable.Telefono" />

                                </div>


                                @* WHATSAPP *@

                                <div class="form-field">

                                    <label>
                                        WhatsApp
                                    </label>

                                    <input type="tel"
                                           maxlength="50"
                                           autocomplete="off"
                                           placeholder="Ej. 221..."
                                           @bind="responsable.WhatsApp" />

                                </div>


                                @* EMAIL *@

                                <div class="form-field full">

                                    <label>
                                        Email
                                    </label>

                                    <input type="email"
                                           maxlength="200"
                                           autocomplete="off"
                                           @bind="responsable.Email" />

                                </div>


                                @* DOMICILIO *@

                                <div class="form-field full">

                                    <label>
                                        Domicilio
                                    </label>

                                    <input type="text"
                                           maxlength="300"
                                           autocomplete="off"
                                           @bind="responsable.Domicilio" />

                                </div>

                            </div>


                            @* =====================================
                               OPCIONES RESPONSABLE
                               ===================================== *@

                            <div class="responsible-options">

                                <label>

                                    <input type="checkbox"
                                           checked="@responsable.EsContactoPrincipal"
                                           @onchange="e => CambiarPrincipal(
                                               index,
                                               (bool)(e.Value ?? false))" />

                                    <span>
                                        Contacto principal
                                    </span>

                                </label>


                                <label>

                                    <input type="checkbox"
                                           @bind="responsable.AutorizaComunicaciones" />

                                    <span>
                                        Autoriza comunicaciones
                                    </span>

                                </label>

                            </div>

                        </article>
                    }

                </div>

            </section>

        </div>


        @* =====================================================
           03 - INSCRIPCIÓN INICIAL
           Sólo en alta
           ===================================================== *@

        @if (!_editando)
        {
            <section class="workspace-card enrollment-section">

                <div class="section-heading">

                    <span class="section-number">
                        03
                    </span>


                    <div>

                        <strong>
                            Inscripción inicial
                        </strong>

                        <small>
                            Elegí el plan y los horarios semanales
                            que ocupará el bebé.
                        </small>

                    </div>

                </div>


                @* =================================================
                   DATOS DE INSCRIPCIÓN
                   ================================================= *@

                <div class="enrollment-data-grid">

                    @* PLAN *@

                   <div class="form-field">

    <label>
        Plan *
    </label>


    @* =====================================================
       SIN PLANES
       ===================================================== *@

    @if (_planes.Count == 0)
    {
        <div class="plan-unavailable-card">

            <MudIcon Icon="@Icons.Material.Filled.WarningAmber"
                     Size="Size.Small" />

            <span>
                No hay planes activos disponibles para esta fecha.
            </span>

        </div>
    }


    @* =====================================================
       UN ÚNICO PLAN
       ===================================================== *@

    else if (_planes.Count == 1 &&
             PlanSeleccionado is not null)
    {
        <div class="single-plan-card">

            <div class="single-plan-main">

                <div class="single-plan-icon">

                    <MudIcon Icon="@Icons.Material.Filled.Pool"
                             Size="Size.Small" />

                </div>


                <div class="single-plan-text">

                    <strong>
                        @PlanSeleccionado.Nombre
                    </strong>

                    <span>

                        @PlanSeleccionado.VecesPorSemana

                        @(PlanSeleccionado.VecesPorSemana == 1
                            ? " clase por semana"
                            : " clases por semana")

                    </span>

                </div>

            </div>


            <div class="single-plan-price">

                @if (PlanSeleccionado.PrecioMensual.HasValue)
                {
                    <strong>
                        @FormatearPrecio(
                            PlanSeleccionado.PrecioMensual.Value)
                    </strong>

                    <span>
                        POR MES
                    </span>
                }
                else
                {
                    <span>
                        TARIFA NO CONFIGURADA
                    </span>
                }

            </div>

        </div>
    }


    @* =====================================================
       MÁS DE UN PLAN
       ===================================================== *@

    else
    {
        <select @bind="_form.PlanId"
                @bind:after="PlanCambio">

            <option value="">
                Seleccionar plan...
            </option>

            @foreach (var plan in _planes)
            {
                <option value="@plan.Id">

                    @plan.Nombre

                    @if (plan.PrecioMensual.HasValue)
                    {
                        @($" · {FormatearPrecio(plan.PrecioMensual.Value)}")
                    }

                </option>
            }

        </select>


        @if (PlanSeleccionado is not null)
        {
            <small class="field-helper">

                @if (PlanSeleccionado.PrecioMensual.HasValue)
                {
                    <span>

                        @FormatearPrecio(
                            PlanSeleccionado.PrecioMensual.Value)

                        mensuales

                    </span>
                }
                else
                {
                    <span>
                        Tarifa aún no configurada
                    </span>
                }

            </small>
        }
    }

</div>


                    @* FECHA INICIO *@

                    <div class="form-field">

                        <label>
                            Fecha de inicio *
                        </label>

                       <BnDatePicker Value="_form.FechaInicioInscripcion"
              ValueChanged="FechaInicioCambiadaAsync" />

                    </div>


                    @* MEDIO DE PAGO *@

                    <div class="form-field">

                        <label>
                            Medio de pago preferido
                        </label>

                        <select @bind="_form.MedioPagoPreferido">

                            @foreach (var medio in
                                Enum.GetValues<MedioPago>())
                            {
                                <option value="@medio">
                                    @ObtenerMedioPagoTexto(medio)
                                </option>
                            }

                        </select>

                    </div>

                </div>

                <div class="discount-box">

   <label class="discount-toggle">

    <input type="checkbox"
           class="discount-toggle-input"
           checked="@AplicaDescuento"
           @onchange="CambiarDescuento" />


    <span class="discount-switch">
        <span class="discount-switch-dot"></span>
    </span>


    <div class="discount-toggle-text">

        <strong>
            Aplicar descuento manual
        </strong>

        <span>
            Por ejemplo descuento por hermano.
        </span>

    </div>

</label>


    @if (AplicaDescuento)
    {
        <div class="discount-fields">

            <div class="form-field">

                <label>
                    Tipo
                </label>

                <select @bind="_form.TipoDescuento">

                    <option value="@TipoDescuento.MontoFijo">
                        Monto fijo
                    </option>

                    <option value="@TipoDescuento.Porcentaje">
                        Porcentaje
                    </option>

                </select>

            </div>


            <div class="form-field">

                <label>

                    @(_form.TipoDescuento ==
                        TipoDescuento.Porcentaje
                            ? "Porcentaje"
                            : "Monto de descuento")

                </label>

                <input type="number"
                       min="0"
                       step="0.01"
                       @bind="_form.ValorDescuento" />

            </div>


            <div class="form-field">

                <label>
                    Motivo
                </label>

                <input type="text"
                       maxlength="200"
                       placeholder="Ej. Descuento hermano"
                       @bind="_form.MotivoDescuento" />

            </div>

        </div>


        @if (PlanSeleccionado?.PrecioMensual is decimal precio)
        {
            <div class="discount-summary">

                <div>
                    <span>Tarifa base</span>
                    <strong>
                        @FormatearPrecio(precio)
                    </strong>
                </div>

                <div>
                    <span>Descuento</span>
                    <strong>
                        - @FormatearPrecio(CalcularDescuento(precio))
                    </strong>
                </div>

                <div class="discount-total">
                    <span>Total mensual</span>
                    <strong>
                        @FormatearPrecio(CalcularTotal(precio))
                    </strong>
                </div>

            </div>
        }
    }

</div>


                @* =================================================
                   GRILLA SEMANAL
                   ================================================= *@

                <div class="schedule-picker">

                    <div class="schedule-picker-header">

                        <div>

                            <span class="schedule-eyebrow">
                                GRILLA SEMANAL
                            </span>


                            <h3>

    @if (PlanTieneMultiplesClases)
    {
        <text>
            Elegí los horarios en los que asistirá
            @NombreBebeParaHorario
        </text>
    }
    else
    {
        <text>
            Elegí el horario en el que asistirá
            @NombreBebeParaHorario
        </text>
    }

</h3>


@if (NivelSeleccionado is not null &&
     PlanSeleccionado is not null)
{
    <p>

        Nivel:

        <strong>
            @NivelSeleccionado.Nombre
        </strong>

        <span>
            ·
        </span>

        <strong>
            @PlanSeleccionado.VecesPorSemana
        </strong>

        @(PlanSeleccionado.VecesPorSemana == 1
            ? " clase semanal"
            : " clases semanales")

    </p>
}
else if (NivelSeleccionado is not null)
{
    <p>

        Nivel:

        <strong>
            @NivelSeleccionado.Nombre
        </strong>

    </p>
}
else
{
    <p>
        Seleccioná el nivel para consultar
        los horarios disponibles.
    </p>
}

                        </div>


                        @if (PlanSeleccionado is not null)
                        {
                            <div class="selected-counter
                                        @(CantidadTurnosCorrecta
                                            ? "complete"
                                            : "")">

                                <strong>
                                    @_form.TurnosIds.Count
                                </strong>

                                <span>
                                    /
                                    @PlanSeleccionado.VecesPorSemana
                                </span>

                                <small>
                                    seleccionados
                                </small>

                            </div>
                        }

                    </div>


                    @* =============================================
                       SIN NIVEL
                       ============================================= *@

                    @if (!_form.NivelActualId.HasValue)
                    {
                        <div class="schedule-empty">

                            <MudIcon Icon="@Icons.Material.Filled.Pool" />

                            <div>

                                <strong>
                                    Primero seleccioná el nivel
                                </strong>

                                <span>
                                    Los horarios se filtran automáticamente
                                    según el nivel del bebé.
                                </span>

                            </div>

                        </div>
                    }

                    @* =============================================
                       CARGANDO
                       ============================================= *@

                    else if (_cargandoTurnos)
                    {
                        <div class="schedule-loading">

                            <MudProgressCircular Indeterminate="true"
                                                 Size="Size.Small" />

                            <span>
                                Cargando horarios disponibles...
                            </span>

                        </div>
                    }

                    @* =============================================
                       SIN TURNOS
                       ============================================= *@

                    else if (_turnosDisponibles.Count == 0)
                    {
                        <div class="schedule-empty">

                            <MudIcon Icon="@Icons.Material.Filled.EventBusy" />

                            <div>

                                <strong>
                                    No hay horarios disponibles
                                </strong>

                                <span>
                                    No encontramos turnos vigentes para
                                    el nivel y la fecha seleccionados.
                                </span>

                            </div>

                        </div>
                    }

                    @* =============================================
                       TURNOS DISPONIBLES
                       ============================================= *@

                    else
                    {
                        <div class="available-schedules">

                            @foreach (var grupo in
                                _turnosDisponibles
                                    .GroupBy(x => x.DiaSemana)
                                    .OrderBy(x => x.Key))
                            {
                                <div class="schedule-day-group">

                                    <div class="schedule-day-title">

                                        <span>
                                            @ObtenerDiaSemanaTexto(
                                                grupo.Key)
                                        </span>

                                        <small>

                                            @grupo.Count()

                                            @(grupo.Count() == 1
                                                ? "horario"
                                                : "horarios")

                                        </small>

                                    </div>


                                    <div class="schedule-options">

                                        @foreach (var turno in
                                            grupo.OrderBy(x =>
                                                x.HoraInicio))
                                        {
                                            var seleccionado =
                                                _form.TurnosIds.Contains(
                                                    turno.TurnoId);


                                            var sinCupo =
                                                turno.Disponibles <= 0
                                                &&
                                                !seleccionado;


                                            <button type="button"
                                                    class="schedule-option
                                                           @(seleccionado
                                                               ? "selected"
                                                               : "")
                                                           @(sinCupo
                                                               ? "full"
                                                               : "")"
                                                    disabled="@sinCupo"
                                                    @onclick="() => AlternarTurno(turno)">

                                                @* CHECK *@

                                                <div class="schedule-option-check">

                                                    @if (seleccionado)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.Check"
                                                                 Size="Size.Small" />
                                                    }

                                                </div>


                                                @* HORARIO *@

                                                <div class="schedule-option-time">

                                                    <strong>

                                                        @turno.HoraInicio.ToString("HH:mm")

                                                        —

                                                        @turno.HoraFin.ToString("HH:mm")

                                                    </strong>


                                                    <span>
                                                        @turno.Nivel
                                                    </span>


                                                    @if (!string.IsNullOrWhiteSpace(
                                                        turno.Sector))
                                                    {
                                                        <small>
                                                            @turno.Sector
                                                        </small>
                                                    }

                                                </div>


                                                @* CUPO *@

                                                <div class="schedule-option-capacity">

                                                    @if (turno.Disponibles <= 0)
                                                    {
                                                        <span class="no-capacity">
                                                            SIN CUPO
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <strong>
                                                            @turno.Disponibles
                                                        </strong>

                                                        <span>
                                                            de @turno.Cupo libres
                                                        </span>
                                                    }

                                                </div>

                                            </button>
                                        }

                                    </div>

                                </div>
                            }

                        </div>
                    }

                </div>

            </section>
        }


        @* =====================================================
           ACCIONES
           ===================================================== *@

        <footer class="page-actions">

            <button type="button"
                    class="secondary-action"
                    disabled="@_guardando"
                    @onclick="Volver">

                <MudIcon Icon="@Icons.Material.Filled.Close"
                         Size="Size.Small" />

                Cancelar

            </button>


            <button type="button"
                    class="primary-action"
                    disabled="@_guardando"
                    @onclick="GuardarAsync">

                @if (_guardando)
                {
                    <MudProgressCircular Indeterminate="true"
                                         Size="Size.Small" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Save"
                             Size="Size.Small" />
                }


                @(_editando
                    ? "Guardar cambios"
                    : "Inscribir bebé")

            </button>

        </footer>
    }

</div>


