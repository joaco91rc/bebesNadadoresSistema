

@page "/clientes/nuevo"

@page "/clientes/{BebeId:guid}/editar"

@attribute [Authorize(Policy = PoliticasSistema.GestionAdministrativa)]

@using BebesNadadores.Application.Bebes

@using BebesNadadores.Application.Bebes.Dtos

@using BebesNadadores.Application.Niveles

@using BebesNadadores.Application.Niveles.Dtos

@using BebesNadadores.Application.Inscripciones

@using BebesNadadores.Application.Inscripciones.Dtos

@using BebesNadadores.Domain.Enums
@using BebesNadadores.Application.Cuotas

@using BebesNadadores.Web.Components.Shared.Utils

<PageTitle>

    @(_editando

        ? "Editar bebé | Bebés Nadadores"

        : "Inscribir bebé | Bebés Nadadores")

</PageTitle>

<div class="enrollment-page">

    @* =========================================================

       HEADER

       ========================================================= *@

    <header class="enrollment-header">

        <div class="enrollment-header-left">

            <button type="button"

                    class="back-button"

                    @onclick="Volver">

                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" />

            </button>

            <div>

                <span class="page-eyebrow">

                    @(_editando

                        ? "EDITAR LEGAJO"

                        : "NUEVA INSCRIPCIÓN")

                </span>

                <h1>

                    @(_editando

                        ? "Editar bebé"

                        : "Inscribir bebé")

                </h1>

                <p>

                    @(_editando

                        ? "Actualizá los datos personales y responsables."

                        : "Registrá al bebé, su familia, plan, primera clase y pago inicial.")

                </p>

            </div>

        </div>

    </header>

    @* =========================================================

       CARGANDO

       ========================================================= *@

    @if (_cargando)

    {

        <div class="page-loading">

            <MudProgressCircular Indeterminate="true"

                                 Size="Size.Large" />

            <span>

                Cargando información...

            </span>

        </div>

    }

    else

    {
        @if (!string.IsNullOrWhiteSpace(_avisoListaEspera))
        {
            <div class="form-error" role="status" style="border-color:var(--mud-palette-primary);color:var(--mud-palette-text-primary)">
                <MudIcon Icon="@Icons.Material.Filled.Info" />
                <span>@_avisoListaEspera</span>
            </div>
        }

        @* =====================================================

           ERROR

           ===================================================== *@

        @if (!string.IsNullOrWhiteSpace(_error))

        {

            <div class="form-error">

                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline"

                         Size="Size.Small" />

                <span>

                    @_error

                </span>

                <button type="button"

                        @onclick="() => _error = null">

                    <MudIcon Icon="@Icons.Material.Filled.Close"

                             Size="Size.Small" />

                </button>

            </div>

        }

        @* =====================================================

           PRIMERA FILA

           ===================================================== *@

        <div class="enrollment-layout">

            @* =================================================

               01 - DATOS DEL BEBÉ

               ================================================= *@

            <section class="workspace-card baby-data-section">

                <div class="section-heading">

                    <span class="section-number">

                        01

                    </span>

                    <div>

                        <strong>

                            Datos del bebé

                        </strong>

                        <small>

                            Información personal y nivel actual.

                        </small>

                    </div>

                </div>

                <div class="form-grid">

                    @* NOMBRE *@

                    <div class="form-field">

                        <label>

                            Nombre *

                        </label>

                        <input type="text"

                               maxlength="100"

                               autocomplete="off"

                               @bind="_form.Nombre" />

                    </div>

                    @* APELLIDO *@

                    <div class="form-field">

                        <label>

                            Apellido *

                        </label>

                        <input type="text"

                               maxlength="100"

                               autocomplete="off"

                               @bind="_form.Apellido" />

                    </div>

                    @* NACIMIENTO *@

                    <div class="form-field">

                        <label>

                            Fecha de nacimiento *

                        </label>

                       <BnDatePicker @bind-Value="_form.FechaNacimiento" />

                    </div>

                    @* SEXO *@

                    <div class="form-field">

                        <label>

                            Sexo

                        </label>

                        <select @bind="_form.Sexo">

                            @foreach (var sexo in

                                Enum.GetValues<Sexo>())

                            {

                                <option value="@sexo">

                                    @ObtenerSexoTexto(sexo)

                                </option>

                            }

                        </select>

                    </div>

                    @* DNI *@

                    <div class="form-field">

                        <label>

                            DNI

                        </label>

                        <input type="text"

                               maxlength="20"

                               placeholder="Opcional"

                               autocomplete="off"

                               @bind="_form.Dni" />

                    </div>

                    @* NIVEL *@

                    <div class="form-field">

                        <label>

                            Nivel actual *

                        </label>

                        <select @bind="_form.NivelActualId"

                                @bind:after="NivelCambioAsync">

                            <option value="">

                                Seleccionar nivel...

                            </option>

                            @foreach (var nivel in _niveles)

                            {

                                <option value="@nivel.Id">

                                    @nivel.Nombre

                                </option>

                            }

                        </select>

                    </div>

                </div>

                <div class="health-declaration">

                    <div class="health-declaration-heading">

                        <span class="health-declaration-icon">

                            <MudIcon Icon="@Icons.Material.Filled.MedicalInformation"
                                     Size="Size.Small" />

                        </span>

                        <div>

                            <strong>
                                Antecedentes de salud
                            </strong>

                            <small>
                                Declaración realizada por la familia al momento de la inscripción.
                            </small>

                        </div>

                    </div>


                   <div class="health-question-grid">

    @* =====================================================
       HOSPITALIZACIÓN
       ===================================================== *@

    <div class="health-question">

        <div class="health-question-content">

            <span class="health-question-label">
                ¿Permaneció en el hospital más de 5 días? *
            </span>

            <div class="health-answer-options">

                <button type="button"
                        class="@RespuestaSaludCss(
                            _form.PermanecioHospitalMasDe5Dias,
                            true)"
                        @onclick="() => CambiarHospitalizacion(true)">

                    Sí

                </button>

                <button type="button"
                        class="@RespuestaSaludCss(
                            _form.PermanecioHospitalMasDe5Dias,
                            false)"
                        @onclick="() => CambiarHospitalizacion(false)">

                    No

                </button>

            </div>


            @if (_form.PermanecioHospitalMasDe5Dias == true)
            {
                <div class="health-detail">

                    <label>
                        Detalle de la hospitalización *
                    </label>

                    <textarea @bind="_form.DetalleHospitalizacion"
                              maxlength="500"
                              rows="3"
                              placeholder="Motivo, duración, antecedentes u otra información relevante...">
                    </textarea>

                    <span>
                        Máximo 500 caracteres
                    </span>

                </div>
            }

        </div>

    </div>


    @* =====================================================
       TRATAMIENTO
       ===================================================== *@

    <div class="health-question">

        <div class="health-question-content">

            <span class="health-question-label">
                ¿Recibe algún tratamiento? *
            </span>

            <div class="health-answer-options">

                <button type="button"
                        class="@RespuestaSaludCss(
                            _form.RecibeTratamiento,
                            true)"
                        @onclick="() => CambiarTratamiento(true)">

                    Sí

                </button>

                <button type="button"
                        class="@RespuestaSaludCss(
                            _form.RecibeTratamiento,
                            false)"
                        @onclick="() => CambiarTratamiento(false)">

                    No

                </button>

            </div>


            @if (_form.RecibeTratamiento == true)
            {
                <div class="health-detail">

                    <label>
                        Detalle del tratamiento *
                    </label>

                    <textarea @bind="_form.DetalleTratamiento"
                              maxlength="500"
                              rows="3"
                              placeholder="Tratamiento, medicación, terapia, controles u otra información relevante...">
                    </textarea>

                    <span>
                        Máximo 500 caracteres
                    </span>

                </div>
            }

        </div>

    </div>

</div>

                </div>


            </section>

            @* =================================================

               02 - RESPONSABLES

               ================================================= *@

            <section class="workspace-card responsible-section">

                <div class="section-heading section-heading-actions">

                    <div class="heading-left">

                        <span class="section-number">

                            02

                        </span>

                        <div>

                            <strong>

                                Responsables

                            </strong>

                            <small>

                                Debe existir exactamente un contacto principal.

                            </small>

                        </div>

                    </div>

                    <button type="button"

                            class="add-responsible"

                            @onclick="AgregarResponsable">

                        <MudIcon Icon="@Icons.Material.Filled.Add"

                                 Size="Size.Small" />

                        Agregar

                    </button>

                </div>

                <div class="responsibles-grid">

                    @for (var i = 0;

                          i < _form.Responsables.Count;

                          i++)

                    {

                        var index = i;

                        var responsable =

                            _form.Responsables[index];

                        <article class="responsible-card">

                            <header>

                                <div>

                                    <span>

                                        RESPONSABLE @(index + 1)

                                    </span>

                                    <strong>

                                        @(string.IsNullOrWhiteSpace(

                                            responsable.Nombre)

                                            ? "Nuevo responsable"

                                            : $"{responsable.Nombre} {responsable.Apellido}")

                                    </strong>

                                </div>

                                @if (_form.Responsables.Count > 1)

                                {

                                    <button type="button"

                                            title="Quitar responsable"

                                            @onclick="() => QuitarResponsable(index)">

                                        <MudIcon Icon="@Icons.Material.Filled.DeleteOutline"

                                                 Size="Size.Small" />

                                    </button>

                                }

                            </header>

                            <div class="responsible-fields">

                                @* NOMBRE *@

                                <div class="form-field">

                                    <label>

                                        Nombre *

                                    </label>

                                    <input type="text"

                                           maxlength="100"

                                           autocomplete="off"

                                           @bind="responsable.Nombre" />

                                </div>

                                @* APELLIDO *@

                                <div class="form-field">

                                    <label>

                                        Apellido *

                                    </label>

                                    <input type="text"

                                           maxlength="100"

                                           autocomplete="off"

                                           @bind="responsable.Apellido" />

                                </div>

                                @* RELACIÓN *@

                                <div class="form-field">

                                    <label>

                                        Relación

                                    </label>

                                    <select @bind="responsable.Relacion">

                                        @foreach (var relacion in

                                            Enum.GetValues<RelacionResponsable>())

                                        {

                                            <option value="@relacion">

                                                @ObtenerRelacionTexto(relacion)

                                            </option>

                                        }

                                    </select>

                                </div>

                                @* DNI *@

                                <div class="form-field">

                                    <label>

                                        DNI

                                    </label>

                                    <input type="text"

                                           maxlength="20"

                                           autocomplete="off"

                                           @bind="responsable.Dni" />

                                </div>

                                @* TELÉFONO *@

                                <div class="form-field">

                                    <label>

                                        Teléfono

                                    </label>

                                    <input type="tel"

                                           maxlength="50"

                                           autocomplete="off"

                                           @bind="responsable.Telefono" />

                                </div>

                                @* WHATSAPP *@

                                <div class="form-field">

                                    <label>

                                        WhatsApp

                                    </label>

                                    <input type="tel"

                                           maxlength="50"

                                           autocomplete="off"

                                           placeholder="Ej. 221..."

                                           @bind="responsable.WhatsApp" />

                                </div>

                                @* EMAIL *@

                                <div class="form-field full">

                                    <label>

                                        Email

                                    </label>

                                    <input type="email"

                                           maxlength="200"

                                           autocomplete="off"

                                           @bind="responsable.Email" />

                                </div>

                                @* DOMICILIO *@

                                <div class="form-field full">

                                    <label>

                                        Domicilio

                                    </label>

                                    <input type="text"

                                           maxlength="300"

                                           autocomplete="off"

                                           @bind="responsable.Domicilio" />

                                </div>

                            </div>

                            @* =====================================

                               OPCIONES RESPONSABLE

                               ===================================== *@

                            <div class="responsible-options">

                                <label>

                                    <input type="checkbox"

                                           checked="@responsable.EsContactoPrincipal"

                                           @onchange="e => CambiarPrincipal(

                                               index,

                                               (bool)(e.Value ?? false))" />

                                    <span>

                                        Contacto principal

                                    </span>

                                </label>

                                <label>

                                    <input type="checkbox"

                                           @bind="responsable.AutorizaComunicaciones" />

                                    <span>

                                        Autoriza comunicaciones

                                    </span>

                                </label>

                            </div>

                        </article>

                    }

                </div>

            </section>

        </div>

        @* =====================================================

           03 - INSCRIPCIÓN INICIAL

           Sólo en alta

           ===================================================== *@

        @if (!_editando)

        {

            <section class="workspace-card enrollment-section">

                <div class="section-heading">

                    <span class="section-number">

                        03

                    </span>

                    <div>

                        <strong>

                            Inscripción inicial

                        </strong>

                       <small>

    Configurá el plan, la modalidad de asistencia

    y el pago inicial.

</small>

                    </div>

                </div>

                @* =================================================

                   DATOS DE INSCRIPCIÓN

                   ================================================= *@

                <div class="enrollment-data-grid">

                    @* PLAN *@

                   <div class="form-field">

    <label>

        Plan *

    </label>

    @* =====================================================

       SIN PLANES

       ===================================================== *@

    @if (_planes.Count == 0)

    {

        <div class="plan-unavailable-card">

            <MudIcon Icon="@Icons.Material.Filled.WarningAmber"

                     Size="Size.Small" />

            <span>

                No hay planes activos disponibles para esta fecha.

            </span>

        </div>

    }

    @* =====================================================

       UN ÚNICO PLAN

       ===================================================== *@

    else if (_planes.Count == 1 &&

             PlanSeleccionado is not null)

    {

        <div class="single-plan-card">

            <div class="single-plan-main">

                <div class="single-plan-icon">

                    <MudIcon Icon="@Icons.Material.Filled.Pool"

                             Size="Size.Small" />

                </div>

                <div class="single-plan-text">

                    <strong>

                        @PlanSeleccionado.Nombre

                    </strong>

                    <span>

                        @PlanSeleccionado.VecesPorSemana

                        @(PlanSeleccionado.VecesPorSemana == 1

                            ? " clase por semana"

                            : " clases por semana")

                    </span>

                </div>

            </div>

            <div class="single-plan-price">

                @if (PlanSeleccionado.PrecioMensual.HasValue)

                {

                    <strong>

                        @FormatearPrecio(

                            PlanSeleccionado.PrecioMensual.Value)

                    </strong>

                    <span>

                        POR MES

                    </span>

                }

                else

                {

                    <span>

                        TARIFA NO CONFIGURADA

                    </span>

                }

            </div>

        </div>

    }

    @* =====================================================

       MÁS DE UN PLAN

       ===================================================== *@

    else

    {

        <select @bind="_form.PlanId"

                @bind:after="PlanCambio">

            <option value="">

                Seleccionar plan...

            </option>

            @foreach (var plan in _planes)

            {

                <option value="@plan.Id">

                    @plan.Nombre

                    @if (plan.PrecioMensual.HasValue)

                    {

                        @($" · {FormatearPrecio(plan.PrecioMensual.Value)}")

                    }

                </option>

            }

        </select>

        @if (PlanSeleccionado is not null)

        {

            <small class="field-helper">

                @if (PlanSeleccionado.PrecioMensual.HasValue)

                {

                    <span>

                        @FormatearPrecio(

                            PlanSeleccionado.PrecioMensual.Value)

                        mensuales

                    </span>

                }

                else

                {

                    <span>

                        Tarifa aún no configurada

                    </span>

                }

            </small>

        }

    }

</div>

                    @* FECHA INICIO *@

                    <div class="form-field">

                        <label>

                            Fecha de inicio *

                        </label>

                       <BnDatePicker Value="_form.FechaInicioInscripcion"

              ValueChanged="FechaInicioCambiadaAsync" />

                       @* Del 15 en adelante: media cuota + recupero o arrancar el 1° del mes siguiente *@
                       <BnInicioMitadMes FechaElegida="FechaElegidaInicio"
                                         FechaActual="_form.FechaInicioInscripcion"
                                         ImporteMensual="@(PlanSeleccionado?.PrecioMensual is decimal precioMes ? CalcularTotal(precioMes) : null)"
                                         OnElegir="ElegirInicioAsync" />

                    </div>

                    @* MEDIO DE PAGO *@

                    <div class="form-field">

                        <label>

                            Medio de pago preferido

                        </label>

                        <select @bind="_form.MedioPagoPreferido">

                            @foreach (var medio in

                                Enum.GetValues<MedioPago>())

                            {

                                <option value="@medio">

                                    @ObtenerMedioPagoTexto(medio)

                                </option>

                            }

                        </select>

                    </div>

                </div>

                <div class="discount-box">

   <label class="discount-toggle">

    <input type="checkbox"

           class="discount-toggle-input"

           checked="@AplicaDescuento"

           @onchange="CambiarDescuento" />

    <span class="discount-switch">

        <span class="discount-switch-dot"></span>

    </span>

    <div class="discount-toggle-text">

        <strong>

            Aplicar descuento manual

        </strong>

        <span>

            Por ejemplo descuento por hermano.

        </span>

    </div>

</label>

    @if (AplicaDescuento)

    {

        <div class="discount-fields">

            <div class="form-field">

                <label>

                    Tipo

                </label>

                <select @bind="_form.TipoDescuento">

                    <option value="@TipoDescuento.MontoFijo">

                        Monto fijo

                    </option>

                    <option value="@TipoDescuento.Porcentaje">

                        Porcentaje

                    </option>

                </select>

            </div>

            <div class="form-field">

                <label>

                    @(_form.TipoDescuento ==

                        TipoDescuento.Porcentaje

                            ? "Porcentaje"

                            : "Monto de descuento")

                </label>

                <input type="number"

                       min="0"

                       step="0.01"

                       @bind="_form.ValorDescuento" />

            </div>

            <div class="form-field">

                <label>

                    Motivo

                </label>

                <input type="text"

                       maxlength="200"

                       placeholder="Ej. Descuento hermano"

                       @bind="_form.MotivoDescuento" />

            </div>

        </div>

        @if (PlanSeleccionado?.PrecioMensual is decimal precio)

        {

            <div class="discount-summary">

                <div>

                    <span>Tarifa base</span>

                    <strong>

                        @FormatearPrecio(precio)

                    </strong>

                </div>

                <div>

                    <span>Descuento</span>

                    <strong>

                        - @FormatearPrecio(CalcularDescuento(precio))

                    </strong>

                </div>

                <div class="discount-total">

                    <span>Total mensual</span>

                    <strong>

                        @FormatearPrecio(CalcularTotal(precio))

                    </strong>

                </div>

            </div>

        }

    }

</div>


@if (PlanSeleccionado?.PrecioMensual is decimal precioPagoInicial)
{
    /*
     * Misma regla que el servidor (ReglasCuota):
     * cuota completa -> se cobra el 50 %; media cuota -> se cobra entera.
     */
    var mediaCuota =
        ReglasCuota.EsInicioAMitadDeMes(_form.FechaInicioInscripcion);

    var totalPrimeraCuota =
        ReglasCuota.CalcularImportePrimerMes(
            CalcularTotal(precioPagoInicial),
            _form.FechaInicioInscripcion);

    var importePagoInicial =
        mediaCuota
            ? totalPrimeraCuota
            : Math.Round(
                totalPrimeraCuota * 0.50m,
                2,
                MidpointRounding.AwayFromZero);

    var saldoPosterior =
        totalPrimeraCuota -
        importePagoInicial;

    <div class="discount-summary initial-payment-summary">

        <div>
            <span>@(mediaCuota ? "Media cuota (inicio a mitad de mes)" : "Primera cuota")</span>
            <strong>@FormatearPrecio(totalPrimeraCuota)</strong>
        </div>

        <div>
            <span>@(mediaCuota ? "Se cobra completa" : "Pago para confirmar · 50%")</span>
            <strong>@FormatearPrecio(importePagoInicial)</strong>
        </div>

        <div>
            <span>Saldo posterior</span>
            <strong>@FormatearPrecio(saldoPosterior)</strong>
        </div>

        <div class="form-field">
            <label>
                Medio del pago inicial
            </label>

            <select @bind="_form.MedioPagoInicial">

                @foreach (var medio in
                    Enum.GetValues<MedioPago>())
                {
                    <option value="@medio">
                        @ObtenerMedioPagoTexto(medio)
                    </option>
                }

            </select>
            @if (_form.MedioPagoInicial.RequiereCuentaBancaria())
{
    <div class="form-field">

        <label>
            Cuenta que recibió el pago *
        </label>

        <select @bind="_form.CuentaBancariaId">

            <option value="">
                Seleccionar cuenta...
            </option>

            @foreach (var cuenta in
                _cuentasBancarias)
            {
                <option value="@cuenta.Id">

                    @cuenta.Banco
                    ·
                    @cuenta.Nombre

                    @if (!string.IsNullOrWhiteSpace(
                        cuenta.Alias))
                    {
                        @($" · {cuenta.Alias}")
                    }

                </option>
            }

        </select>

    </div>
}
else if (_form.MedioPagoInicial.IngresaACaja())
{
    <small class="field-hint">
        Se registra en la caja del día. La caja tiene que estar abierta.
    </small>
}
        </div>

    </div>
}

@* =================================================
   MODALIDAD DE HORARIO
   ================================================= *@

<div class="schedule-mode-section">

    <div class="schedule-mode-heading">

        <span class="schedule-eyebrow">
            MODALIDAD DE ASISTENCIA
        </span>

        <h3>
            ¿Ya tiene definido su horario habitual?
        </h3>

        <p>
            Podés asignar ahora el horario semanal o reservar
            solamente la primera clase y definirlo más adelante.
        </p>

    </div>

    <div class="schedule-mode-options">

        <button type="button"
                class="schedule-mode-card @(_form.DefinirHorarioHabitualAhora ? "selected" : "")"
                @onclick="() => CambiarModalidadHorarioAsync(true)">

            <div class="schedule-mode-icon">
                <MudIcon Icon="@Icons.Material.Filled.EventRepeat" />
            </div>

            <div>

                <strong>
                    Sí, ya tiene horario habitual
                </strong>

                <span>
                    Se reservará su lugar fijo todas las semanas.
                </span>

            </div>

            <div class="schedule-mode-check">

                @if (_form.DefinirHorarioHabitualAhora)
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                             Size="Size.Small" />
                }

            </div>

        </button>

        <button type="button"
                class="schedule-mode-card @(!_form.DefinirHorarioHabitualAhora ? "selected" : "")"
                @onclick="() => CambiarModalidadHorarioAsync(false)">

            <div class="schedule-mode-icon">
                <MudIcon Icon="@Icons.Material.Filled.EventAvailable" />
            </div>

            <div>

                <strong>
                    No, todavía no
                </strong>

                <span>
