    // =========================================================
    // BAJA
    // =========================================================

    private void AbrirBaja(
        BebeDto bebe)
    {
        _bebeBaja =
            bebe;


        _fechaBaja =
            DateOnly.FromDateTime(
                DateTime.Today);


        _motivoBaja =
            string.Empty;


        _errorBaja =
            null;
    }


    private void CerrarBaja()
    {
        if (_guardando)
            return;


        _bebeBaja =
            null;


        _motivoBaja =
            string.Empty;


        _errorBaja =
            null;
    }


    private async Task ConfirmarBajaAsync()
    {
        if (_bebeBaja is null || _guardando)
            return;

        if (!_puedeGestionar)
        {
            _errorBaja =
                "No tiene permisos para dar de baja.";

            return;
        }


        if (string.IsNullOrWhiteSpace(
            _motivoBaja))
        {
            _errorBaja =
                "Debe indicar el motivo de la baja.";

            return;
        }


        try
        {
            _guardando =
                true;


            _errorBaja =
                null;


            var bebe =
                _bebeBaja;


            await BebeService
                .DarDeBajaAsync(
                    bebe.Id,
                    new DarDeBajaBebeDto
                    {
                        Fecha =
                            _fechaBaja,

                        Motivo =
                            _motivoBaja
                    });


            _mensaje =
                $"{bebe.NombreCompleto} fue dado de baja.";


            /*
             * No llamamos CerrarBaja() acá porque mientras
             * _guardando == true ese método no cierra.
             */
            _bebeBaja =
                null;

            _motivoBaja =
                string.Empty;

            _errorBaja =
                null;


            await CargarBebesAsync();
        }
        catch (Exception ex)
        {
            _errorBaja =
                Errores.Mensaje(ex);
        }
        finally
        {
            _guardando =
                false;
        }
    }


    // =========================================================
    // REACTIVAR
    // =========================================================

    private async Task ReactivarAsync(
        BebeDto bebe)
    {
        try
        {
            _error =
                null;

            await Permisos.ExigirAsync(
                PoliticasSistema.GestionAdministrativa);


            await BebeService
                .ReactivarAsync(
                    bebe.Id);


            _mensaje =
                $"{bebe.NombreCompleto} fue reactivado.";


            await CargarBebesAsync();
        }
        catch (Exception ex)
        {
            _error =
                Errores.Mensaje(ex);
        }
    }


