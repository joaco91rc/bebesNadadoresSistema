@using BebesNadadores.Web.Components.Shared.Utils
@page "/clientes"
@page "/bebes"

@attribute [Authorize(Policy = PoliticasSistema.ConsultaGeneral)]

@using BebesNadadores.Application.Bebes
@using BebesNadadores.Application.Bebes.Dtos
@using BebesNadadores.Domain.Enums
@using BebesNadadores.Infrastructure.Services.Turnera

@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<BebesNadadores.Infrastructure.Persistence.AppDbContext> DbHorarios
@inject IBebeService BebeService
@inject NavigationManager Navigation
@inject PermisosUsuario Permisos


<PageTitle>
    Bebés y familias | Bebés Nadadores
</PageTitle>


<div class="babies-page">

    @* =========================================================
       HEADER
       ========================================================= *@

    <section class="babies-header">

        <div>

            <span class="babies-eyebrow">
                COMUNIDAD
            </span>

            <h1>
                Bebés y familias
            </h1>

            <p>
                Administrá los bebés, sus responsables
                y la información principal de cada familia.
            </p>

        </div>


        @if (_puedeGestionar)
        {
            <button type="button" class="primary-action" @onclick="NuevoBebe">

                <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small" />

                Inscribir bebé

            </button>
        }

    </section>


    @* =========================================================
       MENSAJES
       ========================================================= *@

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="message-box message-error">

            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" />

            <span>
                @_error
            </span>

            <button type="button" @onclick="() => _error = null">

                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />

            </button>

        </div>
    }


    @if (!string.IsNullOrWhiteSpace(_mensaje))
    {
        <div class="message-box message-success">

            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />

            <span>
                @_mensaje
            </span>

            <button type="button" @onclick="() => _mensaje = null">

                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />

            </button>

        </div>
    }


    @* =========================================================
       ESTADÍSTICAS
       ========================================================= *@

    <section class="babies-stats">

        <article>

            <div class="stat-icon blue">

                <MudIcon Icon="@Icons.Material.Filled.ChildCare" />

            </div>


            <div>

                <span>
                    Bebés activos
                </span>

                <strong>
                    @CantidadActivos
                </strong>

            </div>

        </article>


        <article>

            <div class="stat-icon cyan">

                <MudIcon Icon="@Icons.Material.Filled.Cake" />

            </div>


            <div>

                <span>
                    Cumpleaños este mes
                </span>

                <strong>
                    @CantidadCumpleaniosMes
                </strong>

            </div>

        </article>


        <article>

            <div class="stat-icon warning">

                <MudIcon Icon="@Icons.Material.Filled.Schedule" />

            </div>


            <div>

                <span>
                    Próximos a 7 años
                </span>

                <strong>
                    @CantidadProximosEdadMaxima
                </strong>

            </div>

        </article>


        <article>

            <div class="stat-icon muted">

                <MudIcon Icon="@Icons.Material.Filled.PersonOff" />

            </div>


            <div>

                <span>
                    De baja
                </span>

                <strong>
                    @CantidadBajas
                </strong>

            </div>

        </article>

    </section>


    @* =========================================================
       TOOLBAR
       ========================================================= *@

    <section class="babies-toolbar">

        <div class="search-box">

            <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />

            <input type="text" placeholder="Buscar bebé, DNI, responsable, teléfono, WhatsApp o email..."
                   @bind="_busqueda" @bind:event="oninput" @bind:after="ReiniciarPagina" />

        </div>


        <label class="show-disabled">

            <input type="checkbox" @bind="_mostrarBajas" @bind:after="RecargarAsync" />

            <span>
                Mostrar bajas
            </span>

        </label>

    </section>


    @* =========================================================
       CONTENIDO
       ========================================================= *@

    @if (_cargando)
    {
        <section class="loading-panel">

            <MudProgressCircular Indeterminate="true" Size="Size.Large" />

            <span>
                Cargando bebés...
            </span>

        </section>
    }
    else if (!BebesFiltrados.Any())
    {
        <section class="empty-panel">

            <div class="empty-icon">

                <MudIcon Icon="@Icons.Material.Filled.ChildCare" />

            </div>


            <h3>
                No encontramos bebés
            </h3>


            <p>
                Modificá la búsqueda o registrá un nuevo bebé.
            </p>


            @if (_puedeGestionar)
            {
                <button type="button" class="primary-action" @onclick="NuevoBebe">

                    <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small" />

                    Inscribir bebé

                </button>
            }

        </section>
    }
    else
    {
        <section class="babies-grid">

            @foreach (var bebe in BebesPagina)
            {
                var responsable =
                    ObtenerResponsablePrincipal(
                        bebe);


                <article @key="bebe.Id" class="baby-card
                    @(bebe.Estado == EstadoBebe.Baja
                                  ? "inactive"
                                  : "")">

                    @* =========================================
                       HEADER
                       ========================================= *@

                    <div class="baby-card-header">

                        <div class="baby-avatar">

                            @ObtenerIniciales(
                                bebe.NombreCompleto)

                        </div>


                        <div class="baby-identity">

                            <div class="baby-name">

                                <h3>
                                    @bebe.NombreCompleto
                                </h3>


                                @if (bebe.Estado ==
                                    EstadoBebe.Activo)
                                {
                                    <span class="status-badge active">
                                        ACTIVO
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge disabled">
                                        BAJA
                                    </span>
                                }

                            </div>


                            <span>

                                @ObtenerEdadTexto(bebe)

                                ·

                                @(string.IsNullOrWhiteSpace(
                                    bebe.NivelActual)
                                    ? "Sin nivel asignado"
                                    : bebe.NivelActual)

                            </span>

                        </div>


                        @if (_puedeGestionar)
                        {
                            <button type="button" class="edit-button" title="Editar bebé" @onclick="() => EditarBebe(bebe.Id)">

                                <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />

                            </button>
                        }

                    </div>


                    @* =========================================
                       DATOS
                       ========================================= *@

                    <div class="baby-data-grid">

                        <div>

                            <div class="info-icon">

                                <MudIcon Icon="@Icons.Material.Filled.Cake" Size="Size.Small" />

                            </div>


                            <div>

                                <small>
                                    NACIMIENTO
                                </small>

                                <strong>
                                    @bebe.FechaNacimiento.ToString(
                                        "dd/MM/yyyy")
                                </strong>

                            </div>

                        </div>


                        <div>

                            <div class="info-icon">

                                <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" />

                            </div>


                            <div>

                                <small>
                                    DNI
                                </small>

                                <strong>

                                    @(string.IsNullOrWhiteSpace(
                                        bebe.Dni)
                                        ? "No informado"
                                        : bebe.Dni)

                                </strong>

                            </div>

                        </div>


                        <div>

                            <div class="info-icon">

                                <MudIcon Icon="@Icons.Material.Filled.Pool" Size="Size.Small" />

                            </div>


                            <div>

                                <small>
                                    NIVEL
                                </small>

                                <strong>

                                    @(bebe.NivelActual
                                        ?? "Sin asignar")

                                </strong>

                            </div>

                        </div>


                        <div>

                            <div class="info-icon">

                                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" />

                            </div>


                            <div>

                                <small>
                                    ALTA
                                </small>

                                <strong>
                                    @bebe.FechaAlta.ToString(
                                        "dd/MM/yyyy")
                                </strong>

                            </div>

                        </div>

                    </div>


                    @* =========================================
                       RESPONSABLE PRINCIPAL
                       ========================================= *@

                    <div class="responsible-preview">

                        <div class="responsible-preview-title">

                            <span>
                                CONTACTO PRINCIPAL
                            </span>


                            @if (bebe.Responsables.Count > 1)
                            {
                                <small>

                                    +@(bebe.Responsables.Count - 1)
                                    responsable(s)

                                </small>
                            }

                        </div>


                        @if (responsable is null)
                        {
                            <div class="no-responsible">

                                <MudIcon Icon="@Icons.Material.Filled.PersonOff" Size="Size.Small" />

                                Sin responsable principal

                            </div>
                        }
                        else
                        {
                            <div class="responsible-person">

                                <div class="responsible-avatar">

                                    @ObtenerIniciales(
                                        responsable.NombreCompleto)

                                </div>


                                <div>

                                    <strong>
                                        @responsable.NombreCompleto
                                    </strong>

                                    <span>
                                        @ObtenerRelacionTexto(
                                            responsable.Relacion)
                                    </span>

                                </div>

                            </div>


                            <div class="contact-lines">

                                @if (!string.IsNullOrWhiteSpace(
                                    responsable.WhatsApp))
                                {
                                    <span>

                                        <MudIcon Icon="@Icons.Material.Filled.Chat" Size="Size.Small" />

                                        @responsable.WhatsApp

                                    </span>
                                }


                                @if (!string.IsNullOrWhiteSpace(
                                    responsable.Email))
                                {
                                    <span>

                                        <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" />

                                        @responsable.Email

                                    </span>
                                }

                            </div>
                        }

                    </div>


                    @* =========================================
                       AVISO EDAD MÁXIMA
                       ========================================= *@

                    @if (bebe.AlcanzoEdadMaxima)
                    {
                        <div class="age-warning">

                            <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small" />

                            <span>
                                Alcanzó la edad máxima de 7 años.
                            </span>

                        </div>
                    }


                    @* =========================================
                       MOTIVO BAJA
                       ========================================= *@

                    @if (
                        bebe.Estado ==
                            EstadoBebe.Baja
                        &&
                        !string.IsNullOrWhiteSpace(
                            bebe.MotivoBaja))
                    {
                        <div class="inactive-reason">

                            <span>
                                Motivo de baja
                            </span>

                            <strong>
                                @bebe.MotivoBaja
                            </strong>

                        </div>
                    }


                    @* =========================================
                       FOOTER
                       ========================================= *@

                    <div class="baby-schedule-grid @((_primerasPendientes.ContainsKey(bebe.Id) || _primerasClases.ContainsKey(bebe.Id) || (!_horariosHabituales.ContainsKey(bebe.Id) && _primerasRealizadas.ContainsKey(bebe.Id))) ? "has-first-class" : "")">
                        <div class="baby-schedule"><span class="baby-schedule-icon"><MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small"/></span><div><small>HORARIO FIJO</small><strong>@(_horariosHabituales.GetValueOrDefault(bebe.Id) ?? "Sin horario fijo")</strong></div></div>
                        @if (_primerasPendientes.TryGetValue(bebe.Id, out var fechaAusencia))
                        {
                            <div class="baby-schedule baby-first-class baby-first-followup"><span class="baby-schedule-icon"><MudIcon Icon="@Icons.Material.Filled.EventRepeat" Size="Size.Small"/></span><div><small>PRIMERA CLASE A REPROGRAMAR</small><strong>Ausente con aviso · @fechaAusencia</strong></div></div>
                        }
                        else if (_primerasClases.TryGetValue(bebe.Id, out var primeraClase))
                        {
                            <div class="baby-schedule baby-first-class"><span class="baby-schedule-icon"><MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small"/></span><div><small>PRIMERA CLASE RESERVADA</small><strong>@primeraClase</strong></div></div>
                        }
                        else if (!_horariosHabituales.ContainsKey(bebe.Id) && _primerasRealizadas.TryGetValue(bebe.Id, out var realizada))
                        {
                            <div class="baby-schedule baby-first-class baby-first-followup"><span class="baby-schedule-icon"><MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small"/></span><div><small>PENDIENTE DE DEFINIR HORARIO</small><strong>Primera clase realizada: @realizada.ToString("dd/MM/yyyy")</strong></div></div>
                        }
                    </div>
                    <div class="baby-card-footer">

                        <button type="button" class="profile-button" @onclick="() => AbrirFicha(bebe.Id)">

                            <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />

                            Ver ficha

                        </button>


                        <AuthorizeView Policy="@PoliticasSistema.GestionCaja"><Authorized><a class="profile-button" href="@($"/pagos?bebe={bebe.Id}")">Pagos</a></Authorized></AuthorizeView>
                        <a class="profile-button" href="@($"/clientes/{bebe.Id}?tab=asistencia")">Asistencia</a>
                        @if (!_puedeGestionar)
                        {
                            @* Solo lectura: sin acciones de alta / baja. *@
                        }
                        else if (bebe.Estado ==
                            EstadoBebe.Activo)
                        {
                            <button type="button" class="toggle-status disable" @onclick="() => AbrirBaja(bebe)">

                                <MudIcon Icon="@Icons.Material.Filled.PersonOff" Size="Size.Small" />

                                Dar de baja

                            </button>
                        }
                        else
                        {
                            <button type="button" class="toggle-status enable" @onclick="() => ReactivarAsync(bebe)">

                                <MudIcon Icon="@Icons.Material.Filled.Restore" Size="Size.Small" />

                                Reactivar

                            </button>
                        }

                    </div>

                </article>
            }

        </section>
        <nav class="babies-pagination" aria-label="Páginas de bebés">
            <span>Mostrando @(_bebes.Count == 0 ? 0 : (_pagina - 1) * TamañoPagina + 1)-@Math.Min(_pagina * TamañoPagina, CantidadFiltrados) de @CantidadFiltrados bebés</span>
            <div>
                <button type="button" disabled="@(_pagina <= 1)" @onclick="() => CambiarPagina(_pagina - 1)">Anterior</button>
                <strong>Página @_pagina de @TotalPaginas</strong>
                <button type="button" disabled="@(_pagina >= TotalPaginas)" @onclick="() => CambiarPagina(_pagina + 1)">Siguiente</button>
            </div>
        </nav>
    }

</div>


@* =============================================================
   MODAL BAJA

   Este modal SÍ lo conservamos porque es una operación corta.
   ============================================================= *@

@if (_bebeBaja is not null)
{
    <div class="modal-backdrop">

        <section class="low-modal">

            <header class="modal-header">

                <div>

                    <span class="modal-eyebrow danger">
                        BAJA
                    </span>

                    <h2>
                        Dar de baja
                    </h2>

                </div>


                <button type="button" class="modal-close" @onclick="CerrarBaja">

                    <MudIcon Icon="@Icons.Material.Filled.Close" />

                </button>

            </header>


            <div class="low-content">

                <div class="low-person">

                    <div class="baby-avatar">

                        @ObtenerIniciales(
                            _bebeBaja.NombreCompleto)

                    </div>


                    <div>

                        <strong>
                            @_bebeBaja.NombreCompleto
                        </strong>

                        <span>
                            @ObtenerEdadTexto(
                                _bebeBaja)
                        </span>

                    </div>

                </div>


                <p>
                    La baja conserva todo el historial del bebé.
                    Se finaliza su inscripción (deja de generar cuotas y
                    libera su lugar en el turno) y se anulan sus recuperos
                    y reservas pendientes. Podrá reactivarse posteriormente
                    con una nueva inscripción.
                </p>


                <div class="form-field">

                    <label>
                        Fecha de baja
                    </label>

                    <BnDatePicker @bind-Value="_fechaBaja" MaxDate="@DateOnly.FromDateTime(DateTime.Today)" />

                </div>


                <div class="form-field">

                    <label>
                        Motivo *
                    </label>

                    <textarea rows="4" maxlength="300" placeholder="Indicá el motivo de la baja..." @bind="_motivoBaja">
                    </textarea>

                </div>


                @if (!string.IsNullOrWhiteSpace(
                    _errorBaja))
                {
                    <div class="modal-error">

                        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" />

                        @_errorBaja

                    </div>
                }

            </div>


            <footer class="modal-actions">

                <button type="button" class="secondary-action" disabled="@_guardando" @onclick="CerrarBaja">

                    Cancelar

                </button>


                <button type="button" class="danger-action" disabled="@_guardando" @onclick="ConfirmarBajaAsync">

                    @if (_guardando)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.PersonOff" Size="Size.Small" />
                    }

                    Confirmar baja

                </button>

            </footer>

        </section>

    </div>
}


@code {

    // =========================================================
    // ESTADO
    // =========================================================

    private const int TamañoPagina = 24;
    private int _pagina = 1;
    private int CantidadFiltrados => BebesFiltrados.Count();
    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(CantidadFiltrados / (double)TamañoPagina));
    private IEnumerable<BebeDto> BebesPagina => BebesFiltrados.Skip((_pagina - 1) * TamañoPagina).Take(TamañoPagina);
    private void ReiniciarPagina() => _pagina = 1;
    private void CambiarPagina(int pagina) => _pagina = Math.Clamp(pagina, 1, TotalPaginas);

    private Dictionary<Guid, string> _horariosHabituales = new();
    private Dictionary<Guid, string> _primerasClases = new();
    private Dictionary<Guid, string> _primerasPendientes = new();
    private Dictionary<Guid, DateOnly> _primerasRealizadas = new();
    private readonly List<BebeDto> _bebes = [];


    private BebeDto? _bebeBaja;


    private bool _cargando =
        true;


    private bool _guardando;


    private bool _mostrarBajas;


    private string _busqueda =
        string.Empty;


    private string _motivoBaja =
        string.Empty;


    private DateOnly _fechaBaja =
        DateOnly.FromDateTime(
            DateTime.Today);


    private string? _error;

    private string? _mensaje;

    private string? _errorBaja;


    // =========================================================
    // FILTRADO
    // =========================================================

    private IEnumerable<BebeDto> BebesFiltrados
    {
        get
        {
            IEnumerable<BebeDto> query =
                _bebes;


            if (string.IsNullOrWhiteSpace(
                _busqueda))
            {
                return query;
            }


            var buscar =
                _busqueda.Trim();


            return query.Where(bebe =>

                Contiene(
                    bebe.NombreCompleto,
                    buscar)

                ||

                Contiene(
                    bebe.Dni,
                    buscar)

                ||

                Contiene(
                    bebe.NivelActual,
                    buscar)

                ||

                bebe.Responsables.Any(r =>

                    Contiene(
                        r.NombreCompleto,
                        buscar)

                    ||

                    Contiene(
                        r.Dni,
                        buscar)

                    ||

                    Contiene(
                        r.Telefono,
                        buscar)

                    ||

                    Contiene(
                        r.WhatsApp,
                        buscar)

                    ||

                    Contiene(
                        r.Email,
                        buscar)));
        }
    }


    // =========================================================
    // ESTADÍSTICAS
    // =========================================================

    private int CantidadActivos =>
        _bebes.Count(x =>
            x.Estado ==
                EstadoBebe.Activo);


    private int CantidadBajas =>
        _bebes.Count(x =>
            x.Estado ==
                EstadoBebe.Baja);


    private int CantidadCumpleaniosMes =>
        _bebes.Count(x =>
            x.Estado ==
                EstadoBebe.Activo
            &&
            x.FechaNacimiento.Month ==
                DateTime.Today.Month);


    private int CantidadProximosEdadMaxima
    {
        get
        {
            return _bebes.Count(x =>
                x.Estado ==
                    EstadoBebe.Activo
                &&
                x.EdadMeses >= 72
                &&
                x.EdadMeses < 84);
        }
    }


    // =========================================================
    // INICIALIZACIÓN
    // =========================================================

    private bool _puedeGestionar;


    protected override async Task OnInitializedAsync()
    {
        _puedeGestionar =
            await Permisos.TieneAsync(
                PoliticasSistema.GestionAdministrativa);

        await InicializarAsync();
    }


    private async Task InicializarAsync()
    {
        try
        {
            _cargando =
                true;

            _error =
                null;


            await CargarBebesAsync();
        }
        catch (Exception ex)
        {
            _error =
                Errores.Mensaje(ex);
        }
        finally
        {
            _cargando =
                false;
        }
    }


    private async Task CargarBebesAsync()
    {
        var datos =
            await BebeService
                .ListarAsync(
                    _mostrarBajas);


        _bebes.Clear();


        _bebes.AddRange(
            datos);
        _pagina = 1;
        var hoy = BebesNadadores.Domain.Common.FechaArgentina.Hoy;
        await using var db = await DbHorarios.CreateDbContextAsync();
        var ids = datos.Select(x => x.Id).ToArray();
        var horarios = await db.InscripcionesTurnos.AsNoTracking().Where(x => ids.Contains(x.Inscripcion.BebeId) && x.Inscripcion.Estado == EstadoInscripcion.Activa && (x.Inscripcion.FechaFin == null || x.Inscripcion.FechaFin >= hoy) && x.Turno.Estado == EstadoTurno.Activo && (x.Turno.VigenteHasta == null || x.Turno.VigenteHasta >= hoy))
            .Select(x => new { x.Inscripcion.BebeId, x.Turno.DiaSemana, x.Turno.HoraInicio, Desde = x.Inscripcion.FechaInicio > x.Turno.VigenteDesde ? x.Inscripcion.FechaInicio : x.Turno.VigenteDesde, HastaInscripcion = x.Inscripcion.FechaFin, HastaTurno = x.Turno.VigenteHasta }).ToListAsync();
        var pendientes = await PrimeraClasePendiente.Consultar(db).Where(x => ids.Contains(x.BebeId))
            .Select(x => new { x.BebeId, x.SesionClase.Fecha, x.SesionClase.HoraInicio }).ToListAsync();
        _primerasPendientes = pendientes.GroupBy(x => x.BebeId).ToDictionary(g => g.Key, g =>
        {
            var p = g.OrderByDescending(x => x.Fecha).ThenByDescending(x => x.HoraInicio).First();
            return $"{p.Fecha:dd/MM/yyyy} · {p.HoraInicio:HH:mm}";
        });
        var primeras = await db.ReservasSesionesClase.AsNoTracking()
            .Where(x => ids.Contains(x.BebeId) && x.Bebe.Estado == EstadoBebe.Activo
                && x.Tipo == TipoReservaSesion.InscripcionInicial && x.Estado == EstadoReservaSesion.Activa
                && x.Inscripcion.Estado == EstadoInscripcion.Activa
                && (x.Inscripcion.FechaFin == null || x.Inscripcion.FechaFin >= hoy)
                && x.SesionClase.Estado == EstadoSesionClase.Programada
                && !db.Asistencias.Any(a => a.InscripcionId == x.InscripcionId && a.Estado == EstadoAsistencia.Presente)
                && !db.Asistencias.Any(a => a.BebeId == x.BebeId && a.SesionClaseId == x.SesionClaseId && a.Estado != EstadoAsistencia.Pendiente))
            .Select(x => new { x.BebeId, x.SesionClase.Fecha, x.SesionClase.HoraInicio }).ToListAsync();
        var realizadas = await db.ReservasSesionesClase.AsNoTracking()
            .Where(x => ids.Contains(x.BebeId) && x.Bebe.Estado == EstadoBebe.Activo
                && x.Tipo == TipoReservaSesion.InscripcionInicial
                && db.Asistencias.Any(a => a.BebeId == x.BebeId && a.SesionClaseId == x.SesionClaseId && a.Estado == EstadoAsistencia.Presente))
            .Select(x => new { x.BebeId, x.SesionClase.Fecha }).ToListAsync();
        _primerasRealizadas = realizadas.GroupBy(x => x.BebeId).ToDictionary(g => g.Key, g => g.Min(x => x.Fecha));
        _primerasClases = primeras.GroupBy(x => x.BebeId).ToDictionary(g => g.Key, g => {
            var p = g.OrderBy(x => x.Fecha).ThenBy(x => x.HoraInicio).First();
            return $"{p.Fecha:dd/MM/yyyy} · {p.HoraInicio:HH:mm}";
        });
        _horariosHabituales = horarios.Where(x => (x.HastaInscripcion == null || x.Desde <= x.HastaInscripcion) && (x.HastaTurno == null || x.Desde <= x.HastaTurno)).GroupBy(x => x.BebeId).ToDictionary(g => g.Key, g =>
        {
            var fecha = g.Min(x => x.Desde) <= hoy ? hoy : g.Min(x => x.Desde);
            var texto = string.Join(" · ", g.Where(x => x.Desde <= fecha).OrderBy(x => x.DiaSemana).ThenBy(x => x.HoraInicio).Select(x => $"{x.DiaSemana} {x.HoraInicio:HH:mm}").Distinct());
            return fecha > hoy ? $"Desde {fecha:dd/MM}: {texto}" : texto;
        });
    }


    private async Task RecargarAsync()
    {
        try
        {
            _error =
                null;


            await CargarBebesAsync();
        }
        catch (Exception ex)
        {
            _error =
                Errores.Mensaje(ex);
        }
    }


