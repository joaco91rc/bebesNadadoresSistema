    private static ResponsableBebeDto?
        ObtenerResponsablePrincipal(
            BebeDto bebe)
    {
        return bebe.Responsables
            .FirstOrDefault(x =>
                x.EsContactoPrincipal)
            ??
            bebe.Responsables
                .FirstOrDefault();
    }


    private static string ObtenerEdadTexto(
        BebeDto bebe)
    {
        if (bebe.EdadMeses < 12)
        {
            return bebe.EdadMeses == 1
                ? "1 mes"
                : $"{bebe.EdadMeses} meses";
        }


        var anios =
            bebe.EdadMeses / 12;


        var meses =
            bebe.EdadMeses % 12;


        if (meses == 0)
        {
            return anios == 1
                ? "1 año"
                : $"{anios} años";
        }


        return $"{anios} {(anios == 1 ? "año" : "años")} y {meses} {(meses == 1 ? "mes" : "meses")}";
    }


    private static string ObtenerIniciales(
        string nombre)
    {
        var partes =
            nombre.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (partes.Length == 0)
        {
            return "?";
        }


        if (partes.Length == 1)
        {
            return partes[0][0]
                .ToString()
                .ToUpperInvariant();
        }


        return string.Concat(
                partes[0][0],
                partes[^1][0])
            .ToUpperInvariant();
    }


    private static bool Contiene(
        string? texto,
        string buscar)
    {
        return
            !string.IsNullOrWhiteSpace(
                texto)
            &&
            texto.Contains(
                buscar,
                StringComparison.OrdinalIgnoreCase);
    }


    private static string ObtenerRelacionTexto(
        RelacionResponsable relacion)
    {
        return relacion
            .ToString()
            .Replace(
                "_",
                " ");
    }
