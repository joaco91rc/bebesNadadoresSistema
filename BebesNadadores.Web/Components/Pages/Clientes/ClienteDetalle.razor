@code {

    [Parameter]
    public Guid BebeId { get; set; }


    private static readonly CultureInfo Cultura =
        CultureInfo.GetCultureInfo(
            "es-AR");


    private BebeLegajoDto? _legajo;

    private bool _cargando = true;

    private string? _error;

    [SupplyParameterFromQuery(Name = "tab")] public string? TabInicial { get; set; }
    private TabLegajo _tab =
        TabLegajo.Resumen;


    private IEnumerable<AlertaLegajo> Alertas
    {
        get
        {
            if (_legajo is null)
                return [];


            var alertas =
                new List<AlertaLegajo>();


            if (_legajo.AlcanzoEdadMaxima)
            {
                alertas.Add(
                    new AlertaLegajo(
                        "Alcanzó la edad máxima de 7 años.",
                        "warning",
                        Icons.Material.Filled.WarningAmber));
            }


            if (_legajo.ResponsablePrincipal is null)
            {
                alertas.Add(
                    new AlertaLegajo(
                        "No tiene contacto principal.",
                        "danger",
                        Icons.Material.Filled.PersonOff));
            }


            if (_legajo.InscripcionActual is null)
            {
                alertas.Add(
                    new AlertaLegajo(
                        "No tiene inscripción activa.",
                        "warning",
                        Icons.Material.Filled.EventBusy));
            }


            if (_legajo.PrimeraClasePorReprogramar is not null)
                alertas.Add(new AlertaLegajo("Primera clase pendiente de reprogramación.", "warning", Icons.Material.Filled.EventRepeat));
            if (_legajo.InscripcionActual is { } actual && actual.Turnos.Count == 0)
                alertas.Add(new AlertaLegajo("Horario fijo pendiente de definir.", "warning", Icons.Material.Filled.Schedule));

            if (_legajo.AptoActual is null)
            {
                alertas.Add(
                    new AlertaLegajo(
                        "No posee apto médico registrado.",
                        "danger",
                        Icons.Material.Filled.MedicalServices));
            }
            else if (!_legajo.AptoActual.Vigente)
            {
                alertas.Add(
                    new AlertaLegajo(
                        "El apto médico no está vigente.",
                        "danger",
                        Icons.Material.Filled.MedicalServices));
            }


            return alertas;
        }
    }


    private int RecuperosDisponibles =>
        _legajo?.Recuperaciones.Count(x =>
            x.Estado ==
                EstadoRecuperacion.Disponible)
        ?? 0;


    private int RecuperosPorVencer
    {
        get
        {
            if (_legajo is null)
                return 0;


            var hoy =
                DateOnly.FromDateTime(
                    DateTime.Today);


            return _legajo.Recuperaciones
                .Count(x =>
                    x.Estado ==
                        EstadoRecuperacion.Disponible
                    &&
                    x.FechaVencimiento.HasValue
                    &&
                    x.FechaVencimiento.Value >= hoy
                    &&
                    x.FechaVencimiento.Value <=
                        hoy.AddDays(7));
        }
    }


    private Guid? _origenPrimeraClase;
    private string _destinoPrimeraClase = "";
    private string? _errorPrimeraClase;
    private bool _cargandoPrimeraClase, _guardandoPrimeraClase;
    private IReadOnlyList<OpcionPrimeraClaseDto> _opcionesPrimeraClase = Array.Empty<OpcionPrimeraClaseDto>();

    private async Task AbrirPrimeraClaseAsync(Guid sesionId)
    {
        if (!_puedeGestionar || _guardandoPrimeraClase) return;
        _origenPrimeraClase = sesionId;
        _destinoPrimeraClase = "";
        _errorPrimeraClase = null;
        _opcionesPrimeraClase = Array.Empty<OpcionPrimeraClaseDto>();
        _cargandoPrimeraClase = true;
        try { _opcionesPrimeraClase = await AsistenciaPrimeraClase.ListarReprogramacionAsync(sesionId, BebeId); }
        catch (Exception ex) { _errorPrimeraClase = Errores.Mensaje(ex); }
        finally { _cargandoPrimeraClase = false; }
    }

    private void CerrarPrimeraClase()
    {
        if (!_guardandoPrimeraClase) _origenPrimeraClase = null;
    }

    private async Task ConfirmarPrimeraClaseAsync()
    {
        if (!_puedeGestionar || _guardandoPrimeraClase || _origenPrimeraClase is not Guid origen
            || !Guid.TryParse(_destinoPrimeraClase, out var destino)) return;
        _guardandoPrimeraClase = true;
        _errorPrimeraClase = null;
        try
        {
            var auth = await AuthPrimeraClase.GetAuthenticationStateAsync();
            Guid? usuario = Guid.TryParse(auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : null;
            await AsistenciaPrimeraClase.MoverReservaPrimeraClaseAsync(origen, BebeId, destino, usuario);
            _origenPrimeraClase = null;
            await CargarAsync();
        }
        catch (Exception ex) { _errorPrimeraClase = Errores.Mensaje(ex); }
        finally { _guardandoPrimeraClase = false; }
    }

    private bool _puedeGestionar;


    protected override async Task OnInitializedAsync()
    {
        _puedeGestionar =
            await Permisos.TieneAsync(
                PoliticasSistema.GestionAdministrativa);
    }


    protected override async Task OnParametersSetAsync()
    {
        _origenPrimeraClase = null;
        if (string.Equals(TabInicial, "asistencia", StringComparison.OrdinalIgnoreCase)) _tab = TabLegajo.Asistencia;
        else if (string.Equals(TabInicial, "inscripcion", StringComparison.OrdinalIgnoreCase)) _tab = TabLegajo.Inscripcion;
        await CargarAsync();
    }


    private async Task CargarAsync()
    {
        try
        {
            _cargando =
                true;

            _error =
                null;


            _legajo =
                await LegajoService
                    .ObtenerAsync(
                        BebeId);


            if (_legajo is null)
            {
                _error =
                    "El bebé indicado no existe.";
            }
        }
        catch (Exception ex)
        {
            _error =
                Errores.Mensaje(ex);
        }
        finally
        {
            _cargando =
                false;
        }
    }


    private string ObtenerEdadTexto()
    {
        if (_legajo is null)
            return string.Empty;


        if (_legajo.EdadMeses < 12)
        {
            return _legajo.EdadMeses == 1
                ? "1 mes"
                : $"{_legajo.EdadMeses} meses";
        }


        var anios =
            _legajo.EdadMeses / 12;

        var meses =
            _legajo.EdadMeses % 12;


        if (meses == 0)
        {
            return anios == 1
                ? "1 año"
                : $"{anios} años";
        }


        return $"{anios} años · {meses} meses";
    }


    private string TabCss(
        TabLegajo tab)
    {
        return
            $"profile-tab {(tab == _tab ? "active" : "")}";
    }


    private static string ProfesoresTexto(
        IReadOnlyList<string> profesores)
    {
        return profesores.Count == 0
            ? "Sin profesor asignado"
            : string.Join(
                " + ",
                profesores);
    }


    private static string ObtenerIniciales(
        string nombre)
    {
        var partes =
            nombre.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (partes.Length == 0)
            return "?";


        if (partes.Length == 1)
        {
            return partes[0][0]
                .ToString()
                .ToUpperInvariant();
        }


        return string.Concat(
                partes[0][0],
                partes[^1][0])
            .ToUpperInvariant();
    }


    private static string FormatearDinero(
        decimal importe)
    {
        return importe.ToString(
            "C0",
            Cultura);
    }

    private static string TextoEstadoSalud(
    bool? valor)
    {
        return valor switch
        {
            true =>
                "Sí",

            false =>
                "No",

            null =>
                "Sin informar"
        };
    }


    private static string EstadoSaludCss(
        bool? valor)
    {
        return valor switch
        {
            true =>
                "warning",

            false =>
                "ok",

            null =>
                "unknown"
        };
    }


    private static string IconoEstadoSalud(
        bool? valor)
    {
        return valor switch
        {
            true =>
                Icons.Material.Filled.PriorityHigh,

            false =>
                Icons.Material.Filled.Check,

            null =>
                Icons.Material.Filled.QuestionMark
        };
    }


    private static string EstadoAsistenciaCss(
        EstadoAsistencia estado)
    {
        return estado switch
        {
            EstadoAsistencia.Presente =>
                "present",

            EstadoAsistencia.AusenteConAviso =>
                "notified",

            EstadoAsistencia.Ausente =>
                "absent",

            _ =>
                "pending"
        };
    }


    private static string EstadoAsistenciaTexto(
        EstadoAsistencia estado)
    {
        return estado switch
        {
            EstadoAsistencia.Presente =>
                "PRESENTE",

            EstadoAsistencia.AusenteConAviso =>
                "CON AVISO",

            EstadoAsistencia.Ausente =>
                "AUSENTE",

            _ =>
                "PENDIENTE"
        };
    }


    private static string EstadoRecuperoCss(
        EstadoRecuperacion estado)
    {
        return estado switch
        {
            EstadoRecuperacion.Disponible =>
                "available",

            EstadoRecuperacion.Reservada =>
                "reserved",

            EstadoRecuperacion.Utilizada =>
                "used",

            EstadoRecuperacion.Vencida =>
                "expired",

            _ =>
                "cancelled"
        };
    }


    private static string EstadoRecuperoTexto(
        EstadoRecuperacion estado)
    {
        return estado switch
        {
            EstadoRecuperacion.Disponible =>
                "DISPONIBLE",

            EstadoRecuperacion.Reservada =>
                "RESERVADO",

            EstadoRecuperacion.Utilizada =>
                "UTILIZADO",

            EstadoRecuperacion.Vencida =>
                "VENCIDO",

            EstadoRecuperacion.Anulada =>
                "ANULADO",

            _ =>
                estado.ToString().ToUpperInvariant()
        };
    }


    private static string TipoRecuperoTexto(
        TipoRecuperacion tipo)
    {
        return tipo.ObtenerTexto();
    }


    private void AbrirAsistencia(
        Guid sesionId)
    {
        // SoloLectura no tiene acceso a la pantalla de asistencia.
        if (!_puedeGestionar)
            return;

        Navigation.NavigateTo(
            $"/asistencia?sesionId={sesionId}");
    }

    private void GestionarInscripcion()
    {
        if (!_puedeGestionar)
            return;

        Navigation.NavigateTo(
            $"/clientes/{BebeId}/inscripcion/editar");
    }

    private string ObtenerWhatsAppUrl()
    {
        /*
         * Mismo armado de número que el resto del sistema
         * (agrega 549 y saca el 0 del código de área).
         */
        return WhatsAppService.CrearUrlChat(
                   _legajo?
                       .ResponsablePrincipal?
                       .WhatsApp)
               ?? "#";
    }


    private void Volver()
    {
        Navigation.NavigateTo(
            "/clientes");
    }


    private enum TabLegajo
    {
        Resumen,
        Responsables,
        Inscripcion,
        AptoMedico,
        Asistencia,
        Recuperos,
        Pagos
    }


    private sealed record AlertaLegajo(
        string Texto,
        string Css,
        string Icono);
}