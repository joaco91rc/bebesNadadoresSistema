@page "/clientes/{BebeId:guid}"

@attribute [Authorize(Policy = PoliticasSistema.ConsultaGeneral)]

@using System.Globalization
@using System.Security.Claims
@using BebesNadadores.Application.Asistencia
@using BebesNadadores.Application.Asistencia.Dtos
@using BebesNadadores.Domain.Common
@using BebesNadadores.Application.Bebes
@using BebesNadadores.Application.Bebes.Dtos
@using BebesNadadores.Domain.Enums

@inject IBebeLegajoService LegajoService
@inject IAsistenciaService AsistenciaPrimeraClase
@inject AuthenticationStateProvider AuthPrimeraClase
@inject NavigationManager Navigation
@inject BebesNadadores.Application.Comunicaciones.IWhatsAppService WhatsAppService
@inject PermisosUsuario Permisos

<PageTitle>Legajo | Bebés Nadadores</PageTitle>


@if (_cargando)
{
    <div class="legajo-loading">

        <MudProgressCircular Indeterminate="true" Size="Size.Large" />

        <span>
            Cargando legajo...
        </span>

    </div>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="legajo-error">

        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" />

        <h2>
            No pudimos abrir el legajo
        </h2>

        <p>
            @_error
        </p>

        <button type="button" class="secondary-action" @onclick="Volver">

            Volver a bebés

        </button>

    </div>
}
else if (_legajo is not null)
{
    <div class="legajo-page">

        @* =====================================================
           HEADER
           ===================================================== *@

        <section class="profile-hero">

            <div class="hero-glow"></div>


            <div class="hero-top">

                <button type="button" class="back-button" @onclick="Volver">

                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />

                    Bebés y familias

                </button>


                <div class="hero-actions">
                    <AuthorizeView Policy="@PoliticasSistema.GestionCaja">
                        <Authorized>
                            <a class="whatsapp-button" href="@($"/clientes/{BebeId}/datos-fiscales")"><MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" /> Datos fiscales</a>
                        </Authorized>
                    </AuthorizeView>

                    @if (_legajo.ResponsablePrincipal is not null
                         &&
                         !string.IsNullOrWhiteSpace(
                             _legajo.ResponsablePrincipal.WhatsApp))
                    {
                        <a class="whatsapp-button" href="@ObtenerWhatsAppUrl()" target="_blank" rel="noopener noreferrer">

                            <MudIcon Icon="@Icons.Material.Filled.Chat" Size="Size.Small" />

                            WhatsApp

                        </a>
                    }

                </div>

            </div>


            <div class="hero-profile">

                <div class="hero-avatar">

                    @ObtenerIniciales(
                        _legajo.NombreCompleto)

                </div>


                <div class="hero-identity">

                    <div class="hero-name-row">

                        <h1>
                            @_legajo.NombreCompleto
                        </h1>


                        @if (_legajo.Estado ==
                             EstadoBebe.Activo)
                        {
                            <span class="profile-status active">
                                ACTIVO
                            </span>
                        }
                        else
                        {
                            <span class="profile-status inactive">
                                BAJA
                            </span>
                        }

                    </div>


                    <div class="hero-meta">

                        <span>

                            <MudIcon Icon="@Icons.Material.Filled.Cake" Size="Size.Small" />

                            @ObtenerEdadTexto()

                        </span>


                        <span>

                            <MudIcon Icon="@Icons.Material.Filled.Pool" Size="Size.Small" />

                            @(_legajo.NivelActual
                                ?? "Sin nivel asignado")

                        </span>


                        <span>

                            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" />

                            Alta
                            @_legajo.FechaAlta.ToString("dd/MM/yyyy")

                        </span>


                        @if (!string.IsNullOrWhiteSpace(
                            _legajo.Dni))
                        {
                            <span>

                                <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" />

                                DNI @_legajo.Dni

                            </span>
                        }

                    </div>

                </div>

            </div>


            @if (Alertas.Any())
            {
                <div class="hero-alerts">

                    @foreach (var alerta in Alertas)
                    {
                        <div class="hero-alert @alerta.Css">

                            <MudIcon Icon="@alerta.Icono" Size="Size.Small" />

                            <span>
                                @alerta.Texto
                            </span>

                        </div>
                    }

                </div>
            }

        </section>

        <HistorialBebePanel BebeId="@BebeId" />



        @* =====================================================
           NAVEGACIÓN
           ===================================================== *@

        <nav class="profile-tabs">

            <button class="@TabCss(TabLegajo.Resumen)" @onclick="() => _tab = TabLegajo.Resumen">

                <MudIcon Icon="@Icons.Material.Filled.SpaceDashboard" Size="Size.Small" />

                Resumen

            </button>


            <button class="@TabCss(TabLegajo.Responsables)" @onclick="() => _tab = TabLegajo.Responsables">

                <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" />

                Responsables

                <span class="tab-count">
                    @_legajo.Responsables.Count
                </span>

            </button>


            <button class="@TabCss(TabLegajo.Inscripcion)" @onclick="() => _tab = TabLegajo.Inscripcion">

                <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Size="Size.Small" />

                Inscripción

            </button>


            <button class="@TabCss(TabLegajo.AptoMedico)" @onclick="() => _tab = TabLegajo.AptoMedico">

                <MudIcon Icon="@Icons.Material.Filled.MedicalServices" Size="Size.Small" />

                Apto médico

            </button>


            <button class="@TabCss(TabLegajo.Asistencia)" @onclick="() => _tab = TabLegajo.Asistencia">

                <MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Small" />

                Asistencia

            </button>


            <button class="@TabCss(TabLegajo.Recuperos)" @onclick="() => _tab = TabLegajo.Recuperos">

                <MudIcon Icon="@Icons.Material.Filled.Autorenew" Size="Size.Small" />

                Recuperos

                @if (RecuperosDisponibles > 0)
                {
                    <span class="tab-count accent">
                        @RecuperosDisponibles
                    </span>
                }

            </button>


            <button class="@TabCss(TabLegajo.Pagos)" @onclick="() => _tab = TabLegajo.Pagos">

                <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" />

                Pagos

            </button>

        </nav>


        @* =====================================================
           RESUMEN
           ===================================================== *@

        @if (_tab == TabLegajo.Resumen)
        {
            <section class="summary-grid">

                <article class="summary-kpi">

                    <div class="summary-kpi-icon blue">

                        <MudIcon Icon="@Icons.Material.Filled.Schedule" />

                    </div>

                    <span>
                        Próxima clase
                    </span>


                    @if (_legajo.ProximaClase is null)
                    {
                        <strong>
                            Sin clase
                        </strong>

                        <small>
                            No tiene turnos activos.
                        </small>
                    }
                    else
                    {
                        <strong>
                            @_legajo.ProximaClase.DiaSemana
                            @_legajo.ProximaClase.HoraInicio.ToString("HH:mm")
                        </strong>

                        <small>
                            @_legajo.ProximaClase.Fecha.ToString("dd/MM")
                            ·
                            @_legajo.ProximaClase.Nivel
                        </small>
                    }

                </article>


                <article class="summary-kpi">

                    <div class="summary-kpi-icon medical">

                        <MudIcon Icon="@Icons.Material.Filled.MedicalServices" />

                    </div>

                    <span>
                        Apto médico
                    </span>

                    @if (_legajo.AptoActual is null)
                    {
                        <strong class="warning-text">
                            Sin apto
                        </strong>

                        <small>
                            Requiere revisión.
                        </small>
                    }
                    else if (_legajo.AptoActual.Vigente)
                    {
                        <strong class="success-text">
                            Vigente
                        </strong>

                        <small>
                            Hasta
                            @_legajo.AptoActual.VigenciaHasta.ToString("dd/MM/yyyy")
                        </small>
                    }
                    else
                    {
                        <strong class="danger-text">
                            No vigente
                        </strong>

                        <small>
                            Último:
                            @_legajo.AptoActual.VigenciaHasta.ToString("dd/MM/yyyy")
                        </small>
                    }

                </article>


                <article class="summary-kpi">

                    <div class="summary-kpi-icon recovery">

                        <MudIcon Icon="@Icons.Material.Filled.Autorenew" />

                    </div>

                    <span>
                        Recuperos disponibles
                    </span>

                    <strong>
                        @RecuperosDisponibles
                    </strong>

                    <small>
                        @RecuperosPorVencer próximos a vencer
                    </small>

                </article>


                <article class="summary-kpi">

                    <div class="summary-kpi-icon payment">

                        <MudIcon Icon="@Icons.Material.Filled.Payments" />

                    </div>

                    <span>
                        Pagado este mes
                    </span>

                    <strong>
                        @FormatearDinero(
                            _legajo.PagadoMesActual)
                    </strong>

                    <small>
                        @_legajo.Pagos.Count movimientos registrados
                    </small>

                </article>

            </section>


            <section class="overview-layout">

                <div class="overview-main">

                    @* PRÓXIMA CLASE *@

                    <article class="content-card">

                        <div class="content-card-header">

                            <div>

                                <span class="section-eyebrow">
                                    AGENDA
                                </span>

                                <h2>
                                    Próxima clase
                                </h2>

                            </div>

                            <MudIcon Icon="@Icons.Material.Filled.Pool" Class="header-icon" />

                        </div>


                        @if (_legajo.ProximaClase is null)
                        {
                            <div class="empty-inline">

                                No hay una próxima clase configurada.

                            </div>
                        }
                        else
                        {
                            <div class="next-class">

                                <div class="next-class-date">

                                    <span>
                                        @(_legajo.ProximaClase.Fecha
                                            .ToString("ddd", Cultura)
                                            .TrimEnd('.')
                                            .ToUpperInvariant())
                                    </span>

                                    <strong>
                                        @_legajo.ProximaClase.Fecha.Day
                                    </strong>

                                </div>


                                <div class="next-class-info">

                                    <strong>
                                        @_legajo.ProximaClase.Nivel
                                    </strong>

                                    <span>
                                        @_legajo.ProximaClase.HoraInicio.ToString("HH:mm")
                                        —
                                        @_legajo.ProximaClase.HoraFin.ToString("HH:mm")
                                    </span>

                                    <span>
                                        @ProfesoresTexto(
                                            _legajo.ProximaClase.Profesores)
                                    </span>

                                </div>

                            </div>
                        }

                    </article>


                    @* ASISTENCIA *@

                    <article class="content-card">

                        <div class="content-card-header">

                            <div>

                                <span class="section-eyebrow">
                                    ÚLTIMOS 90 DÍAS
                                </span>

                                <h2>
                                    Asistencia
                                </h2>

                            </div>


                            <strong class="attendance-percentage">
                                @_legajo.AsistenciaResumen.PorcentajeAsistencia%
                            </strong>

                        </div>


                        <div class="mini-stats">

                            <div>
                                <span class="dot present"></span>
                                <strong>
                                    @_legajo.AsistenciaResumen.Presentes
                                </strong>
                                <small>Presentes</small>
                            </div>

                            <div>
                                <span class="dot notified"></span>
                                <strong>
                                    @_legajo.AsistenciaResumen.AusentesConAviso
                                </strong>
                                <small>Con aviso</small>
                            </div>

                            <div>
                                <span class="dot absent"></span>
                                <strong>
                                    @_legajo.AsistenciaResumen.Ausentes
                                </strong>
                                <small>Ausentes</small>
                            </div>

                        </div>


                        <button type="button" class="card-link" @onclick="() => _tab = TabLegajo.Asistencia">

                            Ver historial completo

                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />

                        </button>

                    </article>

                </div>


                <aside class="overview-side">

                    @* RESPONSABLE *@

                    <article class="content-card">

                        <div class="content-card-header">

                            <div>

                                <span class="section-eyebrow">
                                    FAMILIA
                                </span>

                                <h2>
                                    Contacto principal
                                </h2>

                            </div>

                        </div>


                        @if (_legajo.ResponsablePrincipal is null)
                        {
                            <div class="empty-inline">
                                No tiene responsable principal.
                            </div>
                        }
                        else
                        {
                            var responsable =
                                _legajo.ResponsablePrincipal;

                            <div class="main-responsible">

                                <div class="responsible-avatar">

                                    @ObtenerIniciales(
                                        responsable.NombreCompleto)

                                </div>


                                <div>

                                    <strong>
                                        @responsable.NombreCompleto
                                    </strong>

                                    <span>
                                        @responsable.Relacion
                                    </span>

                                </div>

                            </div>


                            <div class="responsible-contact">

                                <span>

                                    <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" />

                                    @responsable.Telefono

                                </span>

                                <span>

                                    <MudIcon Icon="@Icons.Material.Filled.Chat" Size="Size.Small" />

                                    @responsable.WhatsApp

                                </span>

                                <span>

                                    <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" />

                                    @responsable.Email

                                </span>

                            </div>
                        }

                    </article>


                    @* INSCRIPCIÓN *@

                    <article class="content-card">

                        <div class="content-card-header">

                            <div>

                                <span class="section-eyebrow">
                                    PLAN
                                </span>

                                <h2>
                                    Inscripción
                                </h2>

                            </div>

                        </div>


                        @if (_legajo.InscripcionActual is null)
                        {
                            <div class="empty-inline">
                                No tiene una inscripción activa.
                            </div>
                        }
                        else
                        {
                            <div class="plan-summary">

                                <strong>
                                    @_legajo.InscripcionActual.Plan
                                </strong>

                                <span>
                                    @_legajo.InscripcionActual.VecesPorSemana
                                    @(_legajo.InscripcionActual.VecesPorSemana == 1
                                        ? "vez"
                                        : "veces")
                                    por semana
                                </span>


                                @if (_legajo.InscripcionActual.TarifaMensual.HasValue)
                                {
                                    <div class="plan-price">

                                        <span>
                                            Tarifa actual
                                        </span>

                                        <strong>
                                            @FormatearDinero(
                                                _legajo.InscripcionActual.TarifaMensual.Value)
                                        </strong>

                                    </div>
                                }

                            </div>


                            <button type="button" class="card-link" @onclick="() => _tab = TabLegajo.Inscripcion">

                                Ver inscripción

                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />

                            </button>
                        }

                    </article>
                    @* =====================================================
   ANTECEDENTES DE SALUD
   ===================================================== *@

                    <article class="content-card health-history-card">

                        <div class="content-card-header">

                            <div>

                                <span class="section-eyebrow">
                                    SALUD
                                </span>

                                <h2>
                                    Antecedentes de salud
                                </h2>

                            </div>

                            <MudIcon Icon="@Icons.Material.Filled.MedicalInformation" Class="header-icon" />

                        </div>


                        <div class="health-history-list">

                            @* HOSPITALIZACIÓN *@

                            <div class="health-history-item">

                                <div class="health-history-question">

                                    <span class="health-history-status
                                        @EstadoSaludCss(
                                              _legajo.PermanecioHospitalMasDe5Dias)">

                                        <MudIcon Icon="@IconoEstadoSalud(
                                                                                       _legajo.PermanecioHospitalMasDe5Dias)" Size="Size.Small" />

                                    </span>


                                    <div>

                                        <span>
                                            ¿Permaneció en el hospital más de 5 días?
                                        </span>

                                        <strong>
                                            @TextoEstadoSalud(
                                                _legajo.PermanecioHospitalMasDe5Dias)
                                        </strong>

                                    </div>

                                </div>


                                @if (
                                    _legajo.PermanecioHospitalMasDe5Dias == true
                                    &&
                                    !string.IsNullOrWhiteSpace(
                                        _legajo.DetalleHospitalizacion))
                                {
                                    <div class="health-history-detail">

                                        <span>
                                            Detalle
                                        </span>

                                        <p>
                                            @_legajo.DetalleHospitalizacion
                                        </p>

                                    </div>
                                }

                            </div>


                            @* TRATAMIENTO *@

                            <div class="health-history-item">

                                <div class="health-history-question">

                                    <span class="health-history-status
                                        @EstadoSaludCss(
                                              _legajo.RecibeTratamiento)">

                                        <MudIcon Icon="@IconoEstadoSalud(
                                                                                       _legajo.RecibeTratamiento)" Size="Size.Small" />

                                    </span>


                                    <div>

                                        <span>
                                            ¿Recibe algún tratamiento?
                                        </span>

                                        <strong>
                                            @TextoEstadoSalud(
                                                _legajo.RecibeTratamiento)
                                        </strong>

                                    </div>

                                </div>


                                @if (
                                    _legajo.RecibeTratamiento == true
                                    &&
                                    !string.IsNullOrWhiteSpace(
                                        _legajo.DetalleTratamiento))
                                {
                                    <div class="health-history-detail">

                                        <span>
                                            Detalle
                                        </span>

                                        <p>
                                            @_legajo.DetalleTratamiento
                                        </p>

                                    </div>
                                }

                            </div>

                        </div>

                    </article>

                </aside>

            </section>
        }


        @* =====================================================
           RESPONSABLES
           ===================================================== *@

        @if (_tab == TabLegajo.Responsables)
        {
            <section class="tab-section">

                <div class="tab-heading">

                    <div>
                        <span class="section-eyebrow">
                            FAMILIA
                        </span>

                        <h2>
                            Responsables
                        </h2>

                        <p>
                            Personas vinculadas y autorizadas
                            para recibir comunicaciones.
                        </p>
                    </div>

                </div>


                <div class="responsibles-grid">

                    @foreach (var responsable in
                        _legajo.Responsables)
                    {
                        <article class="responsible-card
                            @(responsable.EsContactoPrincipal
                                     ? "principal"
                                     : "")">

                            <div class="responsible-card-header">

                                <div class="responsible-avatar large">

                                    @ObtenerIniciales(
                                        responsable.NombreCompleto)

                                </div>


                                <div>

                                    <div class="responsible-name">

                                        <h3>
                                            @responsable.NombreCompleto
                                        </h3>

                                        @if (responsable.EsContactoPrincipal)
                                        {
                                            <span class="principal-badge">
                                                PRINCIPAL
                                            </span>
                                        }

                                    </div>

                                    <span>
                                        @responsable.Relacion
                                    </span>

                                </div>

                            </div>


                            <div class="detail-lines">

                                @if (!string.IsNullOrWhiteSpace(
                                    responsable.Dni))
                                {
                                    <div>
                                        <span>DNI</span>
                                        <strong>@responsable.Dni</strong>
                                    </div>
                                }

                                <div>
                                    <span>Teléfono</span>
                                    <strong>@responsable.Telefono</strong>
                                </div>

                                <div>
                                    <span>WhatsApp</span>
                                    <strong>@responsable.WhatsApp</strong>
                                </div>

                                <div>
                                    <span>Email</span>
                                    <strong>@responsable.Email</strong>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(
                                    responsable.Domicilio))
                                {
                                    <div>
                                        <span>Domicilio</span>
                                        <strong>@responsable.Domicilio</strong>
                                    </div>
                                }

                            </div>


                            <div class="communication-status
                                @(responsable.AutorizaComunicaciones
                                     ? "allowed"
                                     : "disabled")">

                                <MudIcon Icon="@(responsable.AutorizaComunicaciones
                                                                             ? Icons.Material.Filled.CheckCircle
                                                                         : Icons.Material.Filled.Block)" Size="Size.Small" />

                                @(responsable.AutorizaComunicaciones
                                    ? "Autoriza comunicaciones"
                                    : "No autoriza comunicaciones")

                            </div>

                        </article>
                    }

                </div>

            </section>
        }


        @* =====================================================
           INSCRIPCIÓN
           ===================================================== *@

        @if (_tab == TabLegajo.Inscripcion)
        {
            <section class="tab-section">

                <div class="tab-heading tab-heading-actions">

                    <div>

                        <span class="section-eyebrow">
                            ACTIVIDAD
                        </span>

                        <h2>
                            Inscripción y turnos
                        </h2>

                        <p>
                            Plan, nivel y horarios semanales asignados.
                        </p>

                    </div>


                    @if (_legajo.InscripcionActual is not null && _puedeGestionar)
                    {
                        <button type="button" class="manage-enrollment-button" @onclick="GestionarInscripcion">

                            <MudIcon Icon="@Icons.Material.Filled.EditCalendar" Size="Size.Small" />

                            @(_legajo.InscripcionActual.Turnos.Count == 0 ? "Asignar horario fijo" : "Gestionar inscripción")

                        </button>
                    }

                </div>


                @if (_legajo.PrimeraClasePorReprogramar is { } pendiente)
                {
                    <div class="initial-class-grid">
                        <div class="initial-class-tile initial-class-highlight">
                            <small>PRIMERA CLASE PENDIENTE DE REPROGRAMACIÓN</small>
                            <strong>Ausente con aviso · @pendiente.Fecha.ToString("dd/MM/yyyy") · @pendiente.HoraInicio.ToString("HH:mm")</strong>
                            <span>@pendiente.Nivel · No es un recupero habitual.</span>
                            @if (_puedeGestionar)
                            {
                                <button type="button" class="manage-enrollment-button" @onclick="() => AbrirPrimeraClaseAsync(pendiente.SesionClaseId)">
                                    <MudIcon Icon="@Icons.Material.Filled.EventRepeat" Size="Size.Small" /> Reprogramar primera clase
                                </button>
                            }
                        </div>
                    </div>
                }
                else if (_legajo.PrimeraClaseReservada is { } primera)
                {
                    <div class="initial-class-grid">
                        <div class="initial-class-tile initial-class-highlight">
                            <small>PRIMERA CLASE RESERVADA</small>
                            <strong>@primera.Fecha.ToString("dd/MM/yyyy") · @primera.HoraInicio.ToString("HH:mm")</strong><span>@primera.Nivel</span>
                            @if (_puedeGestionar && _legajo.PrimeraClaseReservadaSesionId is Guid sesionPrimera)
                            {
                                @if (primera.Fecha > FechaArgentina.Hoy || (primera.Fecha == FechaArgentina.Hoy && primera.HoraInicio > TimeOnly.FromDateTime(DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(-3)).DateTime)))
                                {
                                    <button type="button" class="manage-enrollment-button" @onclick="() => AbrirPrimeraClaseAsync(sesionPrimera)">Modificar primera clase</button>
                                }
                                else
                                {
                                    <button type="button" class="manage-enrollment-button" @onclick="() => AbrirAsistencia(sesionPrimera)">Registrar asistencia de primera clase</button>
                                }
                            }
                        </div>
                    </div>
                }
                else if (_legajo.PrimeraClaseRealizada is { } realizada && _legajo.InscripcionActual?.Turnos.Count == 0)
                {
