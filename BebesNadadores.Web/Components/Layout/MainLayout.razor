@using BebesNadadores.Web.Themes
@using MudBlazor

@inherits LayoutComponentBase




<MudThemeProvider
    Theme="@BebesNadadoresTheme.Theme"
    @bind-IsDarkMode="_isDarkMode" />

<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />


<div class="app-shell @(_menuCollapsed ? "menu-collapsed" : "")">

    @* =========================================================
       SIDEBAR
       ========================================================= *@

    <aside class="app-sidebar">

        <SideMenu
            Collapsed="_menuCollapsed"
            OnToggle="ToggleMenu" />

    </aside>


    @* =========================================================
       MAIN AREA
       ========================================================= *@

    <section class="app-main">

        <TopBar
            IsDarkMode="_isDarkMode"
            OnThemeChanged="ToggleTheme"
            OnMenuToggle="ToggleMenu" />


        <main class="app-content">

            @* Un error no controlado muestra un aviso en lugar de congelar la pantalla. *@
            <BnErrorBoundary @ref="_errorBoundary">
                @Body
            </BnErrorBoundary>

        </main>

    </section>

</div>


@code {

    private bool _isDarkMode = true;

    private bool _menuCollapsed;

    private BnErrorBoundary? _errorBoundary;


    /*
     * Al navegar a otra pantalla se limpia el aviso de error.
     */
    protected override void OnParametersSet()
    {
        _errorBoundary?.Recover();
    }


    private void ToggleTheme()
    {
        _isDarkMode =
            !_isDarkMode;
    }


    private void ToggleMenu()
    {
        _menuCollapsed =
            !_menuCollapsed;
    }

}