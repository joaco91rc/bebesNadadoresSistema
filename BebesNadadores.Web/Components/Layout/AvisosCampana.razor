@using BebesNadadores.Application.Avisos
@implements IDisposable

@inject IAvisosService AvisosService
@inject NavigationManager Navigation
@inject PermisosUsuario Permisos
@inject BebesNadadores.Application.Abstractions.INotificadorCambios Notificador

@*
    =================================================================
    CAMPANA DE AVISOS (barra superior)
    =================================================================

    Muestra avisos calculados en el momento (ver IAvisosService):
    caja sin abrir o sin cerrar, cuotas vencidas, aptos médicos,
    recuperos por vencer, cumpleaños, planes sin tarifa...
    Cada rol ve solo lo suyo. Al resolver el problema, el aviso
    desaparece solo.

    Se actualiza sola:
      - cuando el usuario guarda algo (un pago, una anulación, un apto…):
        lo avisa la auditoría por INotificadorCambios;
      - cada 2 minutos, para tomar lo que cargan otros usuarios;
      - al abrir el panel y al cambiar de pantalla.
*@

@if (TieneAvisos)
{
<div class="bn-avisos">

    <button type="button"
            class="topbar-icon-button notification-button"
            title="Avisos"
            @onclick="AlternarAsync">

        <MudIcon Icon="@(_avisos.Count > 0
                          ? Icons.Material.Filled.NotificationsActive
                          : Icons.Material.Filled.NotificationsNone)" />

        @if (_avisos.Count > 0)
        {
            <span class="notification-count @(HayUrgentes ? "" : "suave")">
                @(_avisos.Count > 9 ? "9+" : _avisos.Count.ToString())
            </span>
        }

    </button>


    @if (_abierto)
    {
        <div class="bn-avisos-backdrop"
             @onclick="Cerrar"></div>

        <div class="bn-avisos-panel">

            <div class="bn-avisos-header">
                <strong>Avisos</strong>
                <small>
                    @(_avisos.Count == 0
                        ? "Nada pendiente"
                        : _avisos.Count == 1 ? "1 pendiente" : $"{_avisos.Count} pendientes")
                </small>
            </div>

            @if (_cargando && _avisos.Count == 0)
            {
                <div class="bn-avisos-vacio">
                    <MudProgressCircular Size="Size.Small"
                                         Indeterminate="true" />
                </div>
            }
            else if (_avisos.Count == 0)
            {
                <div class="bn-avisos-vacio">
                    <MudIcon Icon="@Icons.Material.Filled.TaskAlt" />
                    <span>Todo en orden.</span>
                </div>
            }
            else
            {
                <div class="bn-avisos-lista">

                    @foreach (var aviso in _avisos)
                    {
                        <button type="button"
                                class="bn-aviso nivel-@aviso.Nivel.ToString().ToLowerInvariant()"
                                @onclick="() => Ir(aviso)">

                            <span class="bn-aviso-icono">
                                <MudIcon Icon="@ObtenerIcono(aviso.Nivel)"
                                         Size="Size.Small" />
                            </span>

                            <span class="bn-aviso-texto">
                                <strong>@aviso.Titulo</strong>
                                <small>@aviso.Detalle</small>
                            </span>

                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight"
                                     Size="Size.Small"
                                     Class="bn-aviso-ir" />

                        </button>
                    }

                </div>
            }

        </div>
    }

</div>
}


@code {

    private static readonly TimeSpan IntervaloMinimo =
        TimeSpan.FromMinutes(1);

    private static readonly TimeSpan IntervaloPeriodico =
        TimeSpan.FromMinutes(2);

    /*
     * Un cobro guarda varias veces seguidas (pago, imputaciones,
     * saldos a favor): se espera un momento y se recalcula una vez.
     */
    private static readonly TimeSpan DemoraTrasGuardar =
        TimeSpan.FromMilliseconds(800);

    private readonly CancellationTokenSource _vida = new();

    private CancellationTokenSource? _demora;

    private List<AvisoDto> _avisos = [];

    private AlcanceAvisos? _alcance;

    private DateTime _ultimaCarga = DateTime.MinValue;

    private bool _abierto;

    private bool _cargando;

    private bool _recargarAlTerminar;


    /*
     * Un rol sin ningún grupo de avisos (Solo lectura) no ve la campana.
     */
    private bool TieneAvisos =>
        _alcance is { } a && (a.Caja || a.Administrativos || a.Medicos || a.Administracion);


    private bool HayUrgentes =>
        _avisos.Any(x => x.Nivel >= NivelAviso.Advertencia);


    protected override async Task OnInitializedAsync()
    {
        _alcance =
            new AlcanceAvisos(
                Caja: await Permisos.TieneAsync(PoliticasSistema.GestionCaja),
                Administrativos: await Permisos.TieneAsync(PoliticasSistema.GestionAdministrativa),
                Medicos: await Permisos.TieneAsync(PoliticasSistema.GestionMedica),
                Administracion: await Permisos.TieneAsync(PoliticasSistema.SoloAdministrador));

        if (!TieneAvisos)
            return;

        Navigation.LocationChanged += AlNavegar;

        Notificador.DatosGuardados += AlGuardarDatos;

        _ = ActualizarPeriodicamenteAsync(_vida.Token);

        await CargarAsync(forzar: true);
    }


    /*
     * Se guardó algo en esta sesión: recalcular los avisos.
     * Puede llegar desde cualquier hilo, por eso InvokeAsync.
     */
    private void AlGuardarDatos()
    {
        _demora?.Cancel();
        _demora = new CancellationTokenSource();

        var token =
            _demora.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(DemoraTrasGuardar, token);

                await InvokeAsync(async () =>
                {
                    await CargarAsync(forzar: true);
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException)
            {
                // Llegó otro guardado: lo recalcula el siguiente.
            }
            catch (ObjectDisposedException)
            {
                // El usuario cerró la pestaña.
            }
        });
    }


    private async Task ActualizarPeriodicamenteAsync(
        CancellationToken ct)
    {
        try
        {
            using var timer =
                new PeriodicTimer(IntervaloPeriodico);

            while (await timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(async () =>
                {
                    await CargarAsync(forzar: true);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Se cerró la sesión.
        }
        catch (ObjectDisposedException)
        {
            // Se cerró la sesión.
        }
    }


    private async Task CargarAsync(
        bool forzar)
    {
        if (_alcance is null)
            return;

        if (_cargando)
        {
            // Ya está calculando: cuando termine, vuelve a calcular.
            _recargarAlTerminar = forzar || _recargarAlTerminar;
            return;
        }

        if (!forzar && DateTime.UtcNow - _ultimaCarga < IntervaloMinimo)
            return;

        try
        {
            _cargando = true;

            _avisos =
                (await AvisosService.ObtenerAsync(_alcance))
                    .ToList();

            _ultimaCarga = DateTime.UtcNow;
        }
        catch (Exception ex)
        {
            // Los avisos nunca rompen la barra: el detalle queda en el log.
            _ = Errores.Mensaje(ex);
        }
        finally
        {
            _cargando = false;
        }

        if (_recargarAlTerminar)
        {
            _recargarAlTerminar = false;

            await CargarAsync(forzar: true);
        }
    }


    private async Task AlternarAsync()
    {
        _abierto = !_abierto;

        if (_abierto)
            await CargarAsync(forzar: true);
    }


    private void Cerrar()
    {
        _abierto = false;
    }


    private void Ir(
        AvisoDto aviso)
    {
        _abierto = false;

        Navigation.NavigateTo(aviso.Url);
    }


    private void AlNavegar(
        object? sender,
        LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            _abierto = false;

            await CargarAsync(forzar: false);

            StateHasChanged();
        });
    }


    private static string ObtenerIcono(
        NivelAviso nivel) =>
        nivel switch
        {
            NivelAviso.Urgente => Icons.Material.Filled.ErrorOutline,
            NivelAviso.Advertencia => Icons.Material.Filled.WarningAmber,
            _ => Icons.Material.Outlined.Info
        };


    public void Dispose()
    {
        Navigation.LocationChanged -= AlNavegar;
        Notificador.DatosGuardados -= AlGuardarDatos;

        _vida.Cancel();
        _vida.Dispose();

        _demora?.Cancel();
        _demora?.Dispose();
    }
}
