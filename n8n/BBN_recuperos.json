        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({id: $(\"Preparar correo\").first().json.id, enviado: true}) }}",
        "options": {}
      }
    },
    {
      "id": "40b5fa18-4f96-437f-8bb4-2d4d86215359",
