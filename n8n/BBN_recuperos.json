      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "7c3388b4-951c-4d57-8d84-62d139907d46",
              "leftValue": "={{ !!$json.mensaje }}",
              "rightValue": "",
