    {
      "id": "64ea8294-789d-4cad-bd05-9b4bb12ff47e",
      "name": "Preparar correo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        -80
      ],
      "parameters": {
        "jsCode": "const m = $json.mensaje;\nconst esc = v => String(v ?? '').replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nif (!m || !m.id || !m.destinatario) throw new Error('Mensaje inválido');\nconst boton = m.enlace && m.enlace.startsWith('https://bebesnadadores.com/') ? `<p><a style=\"display:inline-block;padding:12px 20px;background:#11668f;color:#fff;border-radius:8px;text-decoration:none\" href=\"${esc(m.enlace)}\">${esc(m.textoEnlace)}</a></p>` : '';\nreturn [{json:{...m,html:`<div style=\"background:#eaf5fa;padding:24px;font-family:Arial,sans-serif;color:#15384e\"><div style=\"max-width:560px;margin:auto;background:white;border-radius:16px;overflow:hidden\"><div style=\"background:#103d60;padding:22px;color:white;text-align:center\"><img src=\"https://bebesnadadores.com/images/logoBebesTransparente.png\" width=\"100\" alt=\"Bebés Nadadores\"><h2>${esc(m.asunto)}</h2></div><div style=\"padding:26px;line-height:1.6\"><p>Hola, familia de ${esc(m.nombre)}:</p><p>${esc(m.mensaje)}</p>${boton}<p>Un saludo,<br>Equipo de Bebés Nadadores</p></div><div style=\"padding:16px;background:#f2f7fa;font-size:12px;text-align:center\">administracion@bebesnadadores.com</div></div></div>`}}];"
      }
    },
    {
      "id": "b6b13b55-91f5-4379-a0fb-e4b4afde03fb",
      "name": "Enviar correo",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        880,
        -80
      ],
      "parameters": {
        "fromEmail": "Bebés Nadadores <administracion@bebesnadadores.com>",
        "toEmail": "={{ $json.destinatario }}",
        "subject": "={{ $json.asunto }}",
        "emailFormat": "html",
        "html": "={{ $json.html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "6f088a3b-ba8e-4d0e-8de6-90fa5a05fcfd",
