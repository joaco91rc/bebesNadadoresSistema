        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({id: $(\"Preparar correo\").first().json.id, enviado: false}) }}",
        "options": {}
      }
    }
